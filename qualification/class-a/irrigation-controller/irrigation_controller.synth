// Produced from a prompt through the Synth MCP server.
//
// PROMPT: "A 2-layer greenhouse irrigation controller: 12 V barrel-jack power
// entry protected against reverse polarity and over-current, stepped down to
// 3.3 V; an STM32 with an 8 MHz crystal, SWD header and reset button; an I2C
// soil-moisture and temperature sensor on an external JST connector with bus
// pull-ups; an EEPROM for calibration; a low-side MOSFET driving a solenoid
// valve; and two status LEDs."
//
// The prompt is kept verbatim because it is the record of what was asked.
// The board is named for what it is: nothing here is specific to a
// greenhouse rather than a polytunnel, a nursery, a field or a garden, and
// the one word the hardware does earn is "controller" — soil moisture in,
// flow confirmed out, rather than a timer with a MOSFET.
//
// The prompt also asked for one valve and an I2C soil sensor. There is no
// I2C soil sensor in the registry, so the probes are analogue on switched
// excitation, and the valve became two because one probe reading cannot
// schedule two beds.
//
// One product that covers sensing, protected power entry and a debug header
// at once, rather than three fixtures that each cover one:
//
//   case 1  MCU + SWD + crystal + reset + status LED  -> U3, J3, Y1, SW1, D4/D5
//   case 2  I2C sensors, regulator, decoupling,
//           pull-ups, external connector              -> U4, U5, U2, J2
//   case 3  protected power entry, reverse polarity
//           and over-current                          -> J1, F1, Q1, D1, D2
//
// Every support circuit the Synth knowledge graph enforces is designed in,
// not discovered from diagnostics: crystal load caps (C9/C10), I2C pull-ups
// (R5/R6), LED current limiting (R7/R8), a defined reset level (R3) with RC
// debounce (R4/C11), local decoupling on every IC power pin, and a flyback
// path across the solenoid (D3).
//
// 12 V is the horticultural-solenoid standard, which is what sets the
// topology: the valve runs from the protected 12 V rail and only its return
// is switched, so the MCU never sees 12 V.

board "irrigation_controller" {
    layers 2
    manufacturer "jlcpcb"
    revision "A"

    netclass "POWER" {
      trace_width 0.6mm
      clearance 0.25mm
    }

    netclass "VALVE" {
      trace_width 0.6mm
      clearance 0.3mm
    }

    netclass "I2C" {
      trace_width 0.15mm
      clearance 0.15mm
    }

    // Rails declared, so the regulator-range and load-budget rules have
    // something to check, and the exported schematic names them. V12 is
    // class POWER; the 3V3 rail is left at the default width because it feeds
    // a 0.8 mm-pitch LQFP-32 and two DFN sensors that a 0.6 mm track cannot enter.
    power "V12" 12v class "POWER"
    power "V3V3" 3.3v

    group "POWER ENTRY" color "#c2410c" {
      component J1: connector "jst_xh_2pin"        value "12V IN" {
        placement_hint { region: left_edge edge: left priority: soft }
      }
      component F1: fuse      "polyfuse_1r1a"       value "1.1A hold"
      component Q1: transistor "p_mosfet_si2301"    value "Si2301"
      component D1: diode     "d_zener_5v1"         value "5V1"
      component R1: resistor  "r_generic_0603"      value "100k"
      component D2: diode     "smaj15a_tvs"         value "SMAJ15A"
      notes "" {
        "12V in. F1 limits fault current, Q1 blocks reverse polarity, D1 clamps"
        "Q1's gate-source voltage, D2 absorbs field transients from the solenoid"
        "cable. D2 is an SMAJ15A: 15 V standoff clears a 12 V rail, and its"
        "24.4 V clamp is under the MP2307's 26 V absolute maximum. The"
        "tvs_array_5v this replaced is a 5 V part and would have conducted"
        "continuously on a 12 V rail."
        "C16 is local bulk at the valve: the solenoid's switching current is"
        "sourced beside J4 rather than pulled through the buck's input cap."
      }
    }

    // Reverse-polarity protection, with the P-FET's DRAIN on the incoming rail
    // and its SOURCE on the protected one. That orientation is the whole
    // point: a P-FET's body diode runs drain to source, so with the drain on
    // the input it points input-to-load. Forward polarity turns the diode on,
    // the rail comes up, and the channel enhances. Reversed polarity reverses
    // the diode, which blocks, and the gate -- held to ground through R1 --
    // sits at the same potential as the source, so the channel is off too.
    //
    // This was the other way round, with the source on the input. Then the
    // body diode pointed load-to-input and a reversed supply forward-biased
    // it through the load: the part meant to block reverse polarity
    // conducted it.
    //
    // D1 is a 5V1 zener from SOURCE to GATE, anode on the gate. With R1 holding
    // the gate at ground, a 12 V rail would otherwise put 12 V across Vgs; the
    // Si2301's absolute maximum is +/-8 V. The zener holds Vgs to about -5.1 V:
    // fully enhanced, and inside the limit. Gate-to-ground, where it was, does
    // nothing for Vgs at all.
    connect J1.p1 -> F1.p1
    connect F1.p2 -> Q1.d
    connect Q1.g  -> R1.p1
    connect J1.p2 -> R1.p2
    connect Q1.s  -> D1.cathode
    connect Q1.g  -> D1.anode

    // D2 clamps the protected rail against the inductive kick the valve cable
    // brings back: cathode to the rail, anode to ground.
    connect Q1.s  -> D2.cathode
    connect J1.p2 -> D2.anode

    connect Q1.s  -> C1.p1 as "V12"
    connect J1.p2 -> C1.p2

    // The 12 V rail carries nine loads — the buck, the TVS array, the valve
    // and their returns — against one bulk capacitor, which Synth flags as a
    // residual-energy anomaly on net_4. C15 gives the rail a high-frequency
    // path at the buck input; C16 is bulk at the valve connector.
    connect Q1.s  -> C15.p1
    connect J1.p2 -> C15.p2
    connect Q1.s  -> C16.p1
    connect J1.p2 -> C16.p2

    group "3V3 BUCK" color "#0369a1" {
      component U2: regulator "mp2307_buck"     value "MP2307"
      component L1: inductor  "l_1210_10uh"    value "10uH"
      component C2: capacitor "c_generic_0805"  value "22uF"
      component C3: capacitor "c_generic_0603"  value "100nF"
      component C4: capacitor "c_generic_0603"  value "15nF"
      component C22: capacitor "c_generic_0603" value "100nF"
      component R2: resistor  "r_generic_0603"  value "26k1"
      component R9: resistor  "r_generic_0603"  value "10k"
      component R17: resistor "r_generic_0603"  value "2k32"
      component C1: capacitor "c_generic_0805"      value "22uF"
      component C15: capacitor "c_generic_0603"     value "100nF"
      component C16: capacitor "c_generic_0805"     value "22uF" {
        placement_hint { near: J4 priority: soft }
      }
      component R18: resistor "r_generic_0603"  value "100k"
      notes "" {
        "12V to 3V3, 3A part, loaded here to well under 1A. Values below are"
        "from the MP2307 Rev 1.9 datasheet, not from memory:"
        "R2/R9 are its own Table 1 pair for 3.3 V, 26.1k over 10k, which sets"
        "0.925 x (1 + 26.1/10) = 3.34 V, and 3.25 to 3.43 V across the"
        "feedback-voltage tolerance. The 10k over 3k01 that was here set"
        "0.925 x (1 + 10/3.01) = 4.0 V, above the STM32G030's 3.6 V maximum."
        "R17 and C4 are the COMP network: a series RC from COMP to GND, per the"
        "pin description. C4 used to sit between FB and COMP, which is not a"
        "compensation network at all. R17 = 2k32 and C4 = 15nF come from the"
        "datasheet's procedure with a 22 uF output, a 20 kHz crossover, GEA"
        "820 uA/V and GCS 5.2 A/V: R3 < 2.pi.C2.fC/(GEA.GCS) x VOUT/VFB gives"
        "2.31k, and C3 > 4/(2.pi.R3.fC) gives 13.7 nF. Calculated, not measured."
        "R18 pulls EN to IN through 100k. The datasheet's pin description says"
        "to, and its absolute maximum for every pin but IN, SW and BS is 6 V;"
        "EN tied straight to a 12 V rail is outside it."
        "C22 on SS sets a soft-start of about 15 ms (0.1 uF, per the datasheet)."
        "C3 is the bootstrap reservoir: 100 nF, over the 10 nF minimum."
      }
    }

    connect Q1.s   -> U2.in
    connect J1.p2  -> U2.gnd
    connect J1.p2  -> U2.ep
    connect Q1.s   -> R18.p1
    connect R18.p2 -> U2.en
    connect U2.ss  -> C22.p1
    connect J1.p2  -> C22.p2

    connect U2.sw  -> C3.p1
    connect C3.p2  -> U2.bs
    connect U2.sw  -> L1.p1

    connect L1.p2  -> C2.p1
    connect J1.p2  -> C2.p2
    connect L1.p2  -> C5.p1
    connect J1.p2  -> C5.p2

    // Feedback from the 3V3 rail. VOUT = 0.925 x (R1 + R2) / R2 with R1 on
    // top, so 26k1 over 10k is 3.34 V -- the datasheet's own 3.3 V pair.
    connect L1.p2  -> R2.p1 as "V3V3"
    connect R2.p2  -> U2.fb
    connect U2.fb  -> R9.p1
    connect J1.p2  -> R9.p2

    // COMP to GND through a series resistor and capacitor.
    connect U2.comp -> R17.p1
    connect R17.p2  -> C4.p1
    connect J1.p2   -> C4.p2

    group "MCU" color "#4338ca" {
      component U3: mcu       "stm32g030"      value "STM32G030K8T6" {
        placement_hint { region: centre priority: hard }
      }
      component Y1: crystal   "xtal_8mhz"      value "8MHz"
      component C9:  capacitor "c_generic_0603" value "12pF"
      component C10: capacitor "c_generic_0603" value "12pF"
      component C6: capacitor "c_generic_0603" value "100nF"
      component C7: capacitor "c_generic_0603" value "100nF"
      component C8: capacitor "c_generic_0603" value "4u7"
      component SW1: switch   "spst_tactile"   value "RESET" {
        placement_hint { near: R4 priority: soft }
      }
      component R3: resistor  "r_generic_0603" value "10k" {
        placement_hint { near: U3 priority: soft }
      }
      component R4: resistor  "r_generic_0603" value "100" {
        placement_hint { near: R3 priority: soft }
      }
      component C11: capacitor "c_generic_0603" value "100nF"
      component C5: capacitor "c_generic_0603"  value "100nF"
      component J3: connector "header_1x4"     value "SWD"
      notes "" {
        "R3 holds NRST high, SW1 pulls it low, R4/C11 debounce the contact."
        "J3 is SWD: 3V3, SWDIO, SWCLK, GND."
      }
    }

    connect L1.p2 -> U3.vdd
    connect J1.p2 -> U3.vss

    connect U3.vdd -> C6.p1
    connect J1.p2  -> C6.p2
    connect U3.vdd -> C7.p1
    connect J1.p2  -> C7.p2
    connect U3.vdd -> C8.p1
    connect J1.p2  -> C8.p2

    // 8 MHz crystal on the HSE pins with its two load capacitors. The
    // package's case pads are grounded for shielding.
    connect U3.pc14 -> Y1.p1
    connect U3.pc15 -> Y1.p2
    connect Y1.p1   -> C9.p1
    connect J1.p2   -> C9.p2
    connect Y1.p2   -> C10.p1
    connect J1.p2   -> C10.p2
    connect J1.p2   -> Y1.case_1
    connect J1.p2   -> Y1.case_2

    // Reset: pulled up, switched to ground, debounced. The series resistor
    // and capacitor form the RC the knowledge graph asks for, and keep the
    // switch from dumping the full edge straight into NRST.
    connect U3.nrst -> R3.p1
    connect L1.p2   -> R3.p2
    connect U3.nrst -> R4.p1
    connect R4.p2   -> SW1.p1
    connect J1.p2   -> SW1.p2
    connect U3.nrst -> C11.p1
    connect J1.p2   -> C11.p2

    connect L1.p2   -> J3.p1
    connect U3.pa13 -> J3.p2
    connect U3.pa14 -> J3.p3
    connect J1.p2   -> J3.p4

    group "I2C SENSORS" color "#047857" {
      component U4: sensor    "hdc1080_humidity" value "HDC1080"
      component U5: sensor    "apds9301_lux"     value "APDS-9301"
      component U6: memory    "24lc256_eeprom"   value "24LC256"
      component R5: resistor  "r_generic_0603"   value "4k7"
      component R6: resistor  "r_generic_0603"   value "4k7"
      component C12: capacitor "c_generic_0603"  value "100nF"
      component C13: capacitor "c_generic_0603"  value "100nF"
      component C14: capacitor "c_generic_0603"  value "100nF"
      component J2: connector "jst_ph_4pin"      value "AUX I2C" {
        placement_hint { region: bottom_edge edge: bottom priority: soft }
      }
      notes "" {
        "One I2C bus: on-board air temp/humidity and lux, calibration EEPROM,"
        "and J2 for the external soil probe. R5/R6 are the only pull-ups."
      }
    }

    connect U3.pb7 -> U4.sda as "SDA" class "I2C"
    connect U3.pb6 -> U4.scl as "SCL" class "I2C"
    connect U3.pb7 -> U5.sda
    connect U3.pb6 -> U5.scl
    connect U3.pb7 -> U6.sda
    connect U3.pb6 -> U6.scl

    connect U3.pb7 -> R5.p1
    connect L1.p2  -> R5.p2
    connect U3.pb6 -> R6.p1
    connect L1.p2  -> R6.p2

    connect L1.p2 -> U4.vdd
    connect J1.p2 -> U4.gnd
    connect L1.p2 -> U5.vdd
    connect J1.p2 -> U5.gnd
    // ADR_SEL is an input, not a strap that defaults: low puts the sensor at
    // 0x29, floating at 0x39, high at 0x49. Tied low, so the address is a
    // decision in the source and not whatever the pin picks up.
    connect J1.p2 -> U5.adr_sel
    connect L1.p2 -> U6.vdd
    connect J1.p2 -> U6.gnd

    connect U4.vdd -> C12.p1
    connect J1.p2  -> C12.p2
    connect U5.vdd -> C13.p1
    connect J1.p2  -> C13.p2
    connect U6.vdd -> C14.p1
    connect J1.p2  -> C14.p2

    // The EEPROM's address straps and write protect. A0-A2 low puts it at
    // 0x50, clear of the HDC1080 (0x40) and the APDS-9301 (0x29); WP low keeps
    // it writable so calibration can be stored in the field.
    connect J1.p2 -> U6.a0
    connect J1.p2 -> U6.a1
    connect J1.p2 -> U6.a2
    connect J1.p2 -> U6.wp

    // External soil probe: 3V3, SDA, SCL, GND in connector order.
    connect L1.p2 -> J2.p1
    connect U3.pb7 -> J2.p2
    connect U3.pb6 -> J2.p3
    connect J1.p2 -> J2.p4

    // A soil probe is the one input that makes this an irrigation controller
    // rather than a timer, and it is also the part with a failure mode of its
    // own: a probe held at a constant DC bias electrolyses and corrodes, and
    // its reading drifts as it does. So the probes are not powered from the
    // rail. U7 gates their excitation, the MCU raises it only for the
    // milliseconds it takes to read, and the probe spends the rest of the
    // cycle unbiased.
    group "SOIL PROBES" color "#4d7c0f" {
      component U7: regulator "tps22918_loadswitch" value "TPS22918"
      component C17: capacitor "c_generic_0603"     value "100nF"
      component C18: capacitor "c_generic_0603"     value "1uF"
      component R14: resistor "r_generic_0603"      value "10k"
      component R15: resistor "r_generic_0603"      value "10k"
      component C19: capacitor "c_generic_0603"     value "100nF"
      component C20: capacitor "c_generic_0603"     value "100nF"
      component J6: connector "jst_ph_3pin"         value "PROBE Z1" {
        placement_hint { region: bottom_edge edge: bottom priority: soft }
      }
      component J7: connector "jst_ph_3pin"         value "PROBE Z2" {
        placement_hint { region: bottom_edge edge: bottom priority: soft }
      }
      notes "" {
        "U7 switches 3V3 to both probes from PB0, so neither is biased"
        "between readings. R14/C19 and R15/C20 are the anti-alias filters on"
        "the two returns: 10k with 100nF rolls off at 160 Hz, far below the"
        "sampling rate and far above the rate soil moisture changes."
      }
    }

    connect L1.p2   -> U7.vin
    connect J1.p2   -> U7.gnd
    connect U3.pb0  -> U7.on
    connect U7.vin  -> C17.p1
    connect J1.p2   -> C17.p2
    connect U7.vout -> C18.p1
    connect J1.p2   -> C18.p2

    // Zone 1 probe: switched excitation, filtered return, ground.
    connect U7.vout -> J6.p1
    connect J6.p2   -> R14.p1
    connect R14.p2  -> U3.pa1
    connect U3.pa1  -> C19.p1
    connect J1.p2   -> C19.p2
    connect J1.p2   -> J6.p3

    // Zone 2 probe, on the same excitation rail.
    connect U7.vout -> J7.p1
    connect J7.p2   -> R15.p1
    connect R15.p2  -> U3.pa2
    connect U3.pa2  -> C20.p1
    connect J1.p2   -> C20.p2
    connect J1.p2   -> J7.p3

    // A flow meter closes the loop: it is how the controller learns that
    // opening a valve actually moved water, rather than assuming it. Hall
    // sensors of this kind have an open-collector output, so the line needs
    // a pull-up before the MCU can read it.
    group "FLOW METER" color "#0e7490" {
      component J8: connector "jst_ph_3pin" value "FLOW" {
        placement_hint { region: bottom_edge edge: bottom priority: soft }
      }
      component R16: resistor "r_generic_0603" value "10k"
      component C21: capacitor "c_generic_0603" value "100nF"
      notes "" {
        "R16 pulls the open-collector pulse line up to 3V3. C21 debounces the"
        "edge; a dry spin and a blocked line are told apart in firmware by"
        "pulse rate, not by hardware."
      }
    }

    connect L1.p2  -> J8.p1
    connect J1.p2  -> J8.p3
    connect J8.p2  -> U3.pa3
    connect U3.pa3 -> R16.p1
    connect L1.p2  -> R16.p2
    connect U3.pa3 -> C21.p1
    connect J1.p2  -> C21.p2

    group "VALVE DRIVE" color "#b91c1c" {
      component Q2: transistor "n_mosfet_irlml6244" value "IRLML6244" {
        placement_hint { near: J4 priority: hard }
      }
      component D3: diode      "d_schottky"         value "1N5819" {
        placement_hint { near: Q2 priority: hard }
      }
      component R10: resistor  "r_generic_0603"     value "100"
      component R11: resistor  "r_generic_0603"     value "100k"
      component J4: connector  "jst_xh_2pin"        value "VALVE Z1" {
        placement_hint { region: right_edge edge: right priority: soft }
      }
      component Q3: transistor "n_mosfet_irlml6244" value "IRLML6244" {
        placement_hint { near: J5 priority: hard }
      }
      component D6: diode      "d_schottky"         value "1N5819" {
        placement_hint { near: Q3 priority: hard }
      }
      component R12: resistor  "r_generic_0603"     value "100"
      component R13: resistor  "r_generic_0603"     value "100k"
      component J5: connector  "jst_xh_2pin"        value "VALVE Z2" {
        placement_hint { region: right_edge edge: right priority: soft }
      }
      notes "" {
        "Low-side switch on the solenoid return. D3 carries the coil's"
        "collapse current, R11 holds the gate off while the MCU boots."
      }
    }

    // The coil sits between the protected 12 V rail and the FET drain, so
    // the MCU switches only the return. D3 is reversed across the coil:
    // cathode to 12 V, anode to the drain, so it conducts only when the
    // field collapses and drives the drain above the rail.
    connect Q1.s  -> J4.p1
    connect J4.p2 -> Q2.d as "VALVE1" class "VALVE"
    connect Q1.s  -> D3.cathode
    connect Q2.d  -> D3.anode
    connect J1.p2 -> Q2.s

    connect U3.pa4 -> R10.p1
    connect R10.p2 -> Q2.g
    connect Q2.g   -> R11.p1
    connect J1.p2  -> R11.p2

    // Zone 2, the same circuit on its own pin. Irrigation is zoned in
    // practice, and that is why the probes are per-zone too: one reading
    // cannot schedule two beds.
    connect Q1.s   -> J5.p1
    connect J5.p2  -> Q3.d as "VALVE2" class "VALVE"
    connect Q1.s   -> D6.cathode
    connect Q3.d   -> D6.anode
    connect J1.p2  -> Q3.s
    connect U3.pa5 -> R12.p1
    connect R12.p2 -> Q3.g
    connect Q3.g   -> R13.p1
    connect J1.p2  -> R13.p2

    group "STATUS" color "#a16207" {
      component D4: led      "led_green_0603" value "PWR"
      component D5: led      "led_red_0603"   value "VALVE"
      component R7: resistor "r_generic_0603" value "1k"
      component R8: resistor "r_generic_0603" value "1k"
      notes "" {
        "D4 sits on the 3V3 rail, so it reports the buck is up without any"
        "firmware running. D5 is on PA6 and means irrigating: either zone"
        "open. The two valve gates are PA4 and PA5."
      }
    }

    connect L1.p2   -> R7.p1
    connect R7.p2   -> D4.anode
    connect J1.p2   -> D4.cathode

    connect U3.pa6  -> R8.p1
    connect R8.p2   -> D5.anode
    connect J1.p2   -> D5.cathode

    notes "Produced from a prompt via the Synth MCP server." {
      "Registry parts whose metadata or pin maps this corpus corrected are"
      "exercised deliberately: stm32g030 (32 pads, LQFP-32 identity),"
      "mp2307_buck (exposed pad 9), 24lc256_eeprom (address straps on 1-3,"
      "not vdd/gnd/sda/scl), xtal_8mhz (p2 on pad 3, case pads grounded)."
    }
}
