// Two-zone irrigation controller, 12 V DC in, STM32G030K8 (LQFP-32), 2-layer JLCPCB.
// Design assumptions (not verified on hardware):
//   Input 12 V nominal, 10.8 to 12.6 V in operation (12 V +/-5 %); the qualified maximum is 12.6 V and the TVS does not conduct up to its 13.0 V standoff. Surge requirement: at most 14 A peak (10/1000 us, 75 % of the SMAJ13A's rated 18.6 A), set by the source impedance. Each valve output is a 12 V DC solenoid, coil current at most 0.5 A (stated assumption).
//   Protected-rail load budget 1.18 A at 12 V (two valves 1.0 A, plus 0.18 A for the buck input and flow sensor) and 1.25 A at the 13.0 V upper bound; F1 holds 1.5 A at 20 C and 1.25 A at 40 C, the qualified ambient maximum (Littelfuse 1812L150/16 temperature rerating table).
//   Soil probes: resistive 2-electrode, 1 k to 200 k in soil. Flow meter: Hall, open-collector, 5 to 18 V supply, <= 2 kHz.
board "irrigation_controller" {
  layers 2
  manufacturer "jlcpcb"

  netclass "PWR12" { trace_width 0.8mm clearance 0.25mm via_diameter 0.6mm via_drill 0.2mm edge_rate slow }
  netclass "PWR12_IN" { trace_width 0.8mm clearance 0.2mm via_diameter 0.6mm via_drill 0.2mm edge_rate slow }
  netclass "PWR33" { trace_width 0.4mm clearance 0.2mm via_diameter 0.6mm via_drill 0.2mm edge_rate slow }
  netclass "Default" { via_diameter 0.6mm via_drill 0.2mm edge_rate slow }
  netclass "SIG" { via_diameter 0.6mm via_drill 0.2mm edge_rate slow }

  power "VIN_12V_RAW" 12v class "PWR12"
  power "VIN_FUSED" 12v class "PWR12_IN"
  power "+12V_VALVE" 12v class "PWR12"
  power "+3V3" 3.3v class "PWR33"

  // ---- A: power input, protection, buck -------------------------------------------------------
  group "POWER INPUT" color "#c2410c" {
    component J1: connector "jst_xh_2pin" { placement_hint { edge: left priority: hard } }
    component F1: fuse "polyfuse_1r5a"
    component Q1: transistor "dmt6007lfg"
    component U_IDEAL: regulator "lm74700_q1" { placement_hint { near: "Q1" priority: hard } }
    component C_VCAP: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "U_IDEAL" priority: hard } }
    component C_VIN: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "U_IDEAL" priority: hard } }
    component D_TVS: diode "smaj13a_tvs"
    component C_BULK: capacitor "c_electrolytic_100uf" value "100uF 25V"
    component TP_VIN: testpoint "testpoint_pad_1_5"
    component TP_12V: testpoint "testpoint_pad_1_5"
    notes "" {
      "J1 JST XH S2B-XH-A: pin1 VIN_12V_RAW, pin2 GND. Mate with XHP-2 housing.  Pin 1 is the +12 V pin."
      "F1 1.5 A hold PPTC, then the ideal-diode reverse-polarity stage: U_IDEAL (TI LM74700-Q1, SNOSD17G) drives Q1 (Diodes DMT6007LFG, 60 V, +/-20 V, RDS(on) 8.5 mOhm max at 4.5 V). U_IDEAL ANODE and EN sit on VIN_FUSED with the Q1 sources, CATHODE on +12V_VALVE with the Q1 drain, GATE on the Q1 gate; C_VCAP (100 nF, at least 10 x the 2.09 nF Ciss and the 0.1 uF minimum) joins VCAP to ANODE, C_VIN (100 nF, minimum 22 nF) sits at ANODE and C_BULK (100 uF, minimum 100 nF) at CATHODE."
      "Q1 check: a reversed input drives the LM74700-Q1 ANODE below CATHODE and the controller pulls the gate to the source, so Q1 blocks even with C_BULK charged (a hot-plug reversal); the controller tolerates -65 V on ANODE and the clamp keeps the reversed input at about -0.7 V through D_TVS. Q1 drain-source rating 60 V and gate-source rating 20 V are above the TVS clamp of 21.5 V and the 15 V the controller can put between GATE and ANODE; at 1.18 A the forward drop is 10 mV at the 8.5 mOhm maximum, the controller regulates it to about 20 mV."
      "D_TVS SMAJ13A (Littelfuse, 400 W, VR 13.0 V, VBR 14.40 to 15.90 V at 1 mA, IR 1 uA maximum at VR, VC 21.5 V at IPP 18.6 A) sits on VIN_FUSED, before Q1: its cathode joins the fused input net on the Q1 drain side and its anode is on GND, so a surge is clamped before it reaches Q1, the buck or any capacitor. A reversed supply forward-biases D_TVS, which conducts and opens F1; Q1 then isolates the protected rail."
      "TVS check: the supply is 12 V +/-5 % (10.8 to 12.6 V in operation), 0.4 V (3.2 %) below the 13.0 V standoff VR; at 13.0 V, the upper bound the checks use, leakage is the datasheet IR of 1 uA maximum and 13.0 V is 1.4 V below the 14.40 V minimum breakdown. Surge requirement: a source with impedance R_s keeps the TVS current at or below 14 A (10/1000 us), 75 % of its rated 18.6 A (400 W rated pulse power, which 18.6 A x 21.5 V = 399.9 W uses in full, so the rating alone leaves no margin; 14 A x 21.5 V = 301 W) while the open-circuit surge is at most 21.5 V + 14 A x R_s, which is 35.5 V at 1 ohm and 49.5 V at 2 ohm; the clamp at 14 A is at most the 21.5 V it has at 18.6 A, which the margins below use. Worst-case clamp 21.5 V is below the MP2307 recommended input maximum 23 V by 1.5 V and its absolute maximum 26 V by 4.5 V, below the DMT6007LFG 60 V Vds by 38.5 V, and below the 25 V rating of C_BULK, C_IN1 and C_IN2 by 3.5 V."
    }
  }
  group "BUCK 3V3" color "#b45309" {
    component U1: regulator "mp2307_buck_ep" { escape { off } }
    component C_IN1: capacitor "c_generic_0805" value "10uF 25V"
    component C_IN2: capacitor "c_generic_0805" value "10uF 25V"
    component C_BS: capacitor "c_generic_0603" value "10nF"
    component L1: inductor "l_power_10uh_6045"
    component C_OUT1: capacitor "c_generic_1206" value "22uF 10V"
    component C_OUT2: capacitor "c_generic_1206" value "22uF 10V"
    component R_FBT: resistor "r_generic_0603" value "26.1k"
    component R_FBB: resistor "r_generic_0603" value "10k"
    component R_COMP: resistor "r_generic_0603" value "5.6k"
    component C_COMP: capacitor "c_generic_0603" value "4.7nF"
    component C_SS: capacitor "c_generic_0603" value "100nF"
    component R_EN: resistor "r_generic_0603" value "100k"
    component TP_3V3: testpoint "testpoint_pad_1_5"
    component TP_GND: testpoint "testpoint_pad_1_5"
    notes "" {
      "MP2307 (internal sync rectifier, 340 kHz). Vout = 0.925 V x (1 + 26.1k/10k) = 3.34 V."
      "L1 Bourns SRN6045TA-100M, 10 uH: ripple about 0.7 A p-p at 12 V in (L = VOUT / (fS dIL) x (1 - VOUT / VIN), MP2307 datasheet), peak 0.96 A at the 0.6 A load; Isat 4.6 A (30 % inductance drop, Bourns datasheet) is above the MP2307 4.0 A minimum switch current limit, so L1 does not saturate before the converter limits."
    }
  }

  // ---- C: MCU, clock, reset, debug ------------------------------------------------------------
  group "MCU" color "#0072b2" {
    component U2: mcu "stm32g030k8_lqfp32" { escape { off } }
    component C_VDD1: capacitor "c_generic_0603" value "100nF"
    component C_VDD2: capacitor "c_generic_0805" value "4.7uF"
    component Y1: crystal "xtal_32k768_fc135_7pf"
    component C_X1: capacitor "c_generic_0603" value "4.3pF"
    component C_X2: capacitor "c_generic_0603" value "4.3pF"
    component R_NRST: resistor "r_generic_0603" value "10k"
    component C_NRST: capacitor "c_generic_0603" value "100nF"
    component SW_RESET: switch "spst_tactile"
    component J_SWD: connector "header_1x5" { placement_hint { edge: right priority: hard } }
    component TP_NRST: testpoint "testpoint_pad_1_5"
    component TP_SWDIO: testpoint "testpoint_pad_1_5"
    component TP_SWCLK: testpoint "testpoint_pad_1_5"
    notes "" {
      "J_SWD pin1 +3V3, pin2 SWDIO, pin3 GND, pin4 SWCLK, pin5 NRST. No USB bootloader; program over SWD."
      "LSE 32.768 kHz on PC14/PC15 (OSC32_IN/OSC32_OUT): the LQFP-32 STM32G030K8 has no HSE crystal oscillator (HSE runs only in bypass mode), so the system clock is HSI16 and the crystal feeds the RTC. Crystal Epson FC-135 32.7680KF-AG0 (LCSC C7275974), CL 7 pF, R1 70 kOhm typ, C0 1.0 pF typ (Epson FC-135 datasheet Ver 2.0). CL = (C1 x C2)/(C1 + C2) + Cstray with Cstray 5 pF, so C1 = C2 = 2 x (7 - 5) = 4 pF. Nearest standard value (E24) 4.3 pF: CL = 4.3/2 + 5 = 7.15 pF, 0.15 pF from 7 pF. Cstray 5 pF is an assumption, not measured. Crystal critical transconductance gm_crit = 4 x R1 x (2 pi f)^2 x (C0 + CL)^2 = 4 x 70 kOhm x (2.059e5)^2 x (8.15 pF)^2 = 0.79 uA/V; the STM32G030 LSE drive setting (LSEDRV) must be chosen so its maximum critical transconductance is at least 5 x this value, which was not checked here because DS12991 was not read."
      "Boot: PA14 (SWCLK) is BOOT0; default option bytes boot from flash."
    }
  }

  // ---- B: valve drivers -----------------------------------------------------------------------
  group "VALVE 1" color "#7c3aed" {
    component J_VALVE1: connector "jst_xh_2pin" { placement_hint { edge: top priority: hard } }
    component Q_V1: transistor "ao3400a_nmos"
    component R_G1: resistor "r_generic_0603" value "100"
    component R_PD1: resistor "r_generic_0603" value "100k"
    component D_FLY1: diode "d_schottky"
    component R_SN1: resistor "r_generic_0603" value "100"
    component C_SN1: capacitor "c_generic_0603" value "10nF"
    component TP_V1: testpoint "testpoint_pad_1_5"
    notes "" {
      "J_VALVE1 pin1 +12V_VALVE, pin2 VALVE1_SW (low-side). Flyback cathode to +12V_VALVE."
      "Load: 12 V DC solenoid, coil current at most 0.5 A. AO3400A carries 0.5 A (rated far above, needs datasheet value sourcing for the exact figure), flyback diode 1N5819-class (1 A class), VALVE1_SW is class PWR12 (0.8 mm, about 8x the width a 0.5 A / 10 C rise needs)."
    }
  }
  group "VALVE 2" color "#6d28d9" {
    component J_VALVE2: connector "jst_xh_2pin" { placement_hint { edge: top priority: hard } }
    component Q_V2: transistor "ao3400a_nmos"
    component R_G2: resistor "r_generic_0603" value "100"
    component R_PD2: resistor "r_generic_0603" value "100k"
    component D_FLY2: diode "d_schottky"
    component R_SN2: resistor "r_generic_0603" value "100"
    component C_SN2: capacitor "c_generic_0603" value "10nF"
    component TP_V2: testpoint "testpoint_pad_1_5"
    notes "" {
      "J_VALVE2 pin1 +12V_VALVE, pin2 VALVE2_SW (low-side). Flyback cathode to +12V_VALVE."
      "Load: 12 V DC solenoid, coil current at most 0.5 A. Same checks as valve 1: MOSFET, flyback diode and PWR12 tracks carry 0.5 A."
      "R_SN2 100 ohm in series with C_SN2 10 nF is an RC snubber across the valve 2 coil connector. TP_V2 probes VALVE2_SW."
    }
  }

  // ---- D: soil-moisture interfaces ------------------------------------------------------------
  group "SOIL 1" color "#15803d" {
    component J_SOIL1: connector "jst_ph_3pin" { placement_hint { edge: bottom priority: hard } }
    component R_S1: resistor "r_generic_0603" value "10k"
    component R_D1: resistor "r_generic_0603" value "10k"
    component R_F1: resistor "r_generic_0603" value "1k"
    component C_F1: capacitor "c_generic_0603" value "10nF"
    component R_F1B: resistor "r_generic_0603" value "1k"
    component C_F1B: capacitor "c_generic_0603" value "10nF"
    component D_ESD_S1: diode "prtr5v0u2x" { placement_hint { near: "J_SOIL1" priority: hard } }
    component TP_SOIL1: testpoint "testpoint_pad_1_5"
    notes "" {
      "J_SOIL1 pin1 and pin2 are the probe, pin3 GND. AC excitation: the probe is driven with alternating polarity from two GPIOs through R_S1 and R_D1 (10 k each), so it never sees DC. Firmware: phase 1 drives pin 1 high and pin 2 low and samples SOIL1_ADC_B; phase 2 reverses the drive and samples SOIL1_ADC_A; the two readings are averaged. V(sampled node) = 3.3 V x 10 k / (10 k + Rprobe + 10 k): 2.75 V at 1 k, 0.16 V at 200 k. R_F1 and R_F1B 1 k with C_F1 and C_F1B 10 nF filter the ADC inputs. D_ESD_S1 (PRTR5V0U2X) protects the connector pins."
    }
  }
  group "SOIL 2" color "#166534" {
    component J_SOIL2: connector "jst_ph_3pin" { placement_hint { edge: bottom priority: hard } }
    component R_S2: resistor "r_generic_0603" value "10k"
    component R_D2: resistor "r_generic_0603" value "10k"
    component R_F2: resistor "r_generic_0603" value "1k"
    component C_F2: capacitor "c_generic_0603" value "10nF"
    component R_F2B: resistor "r_generic_0603" value "1k"
    component C_F2B: capacitor "c_generic_0603" value "10nF"
    component D_ESD_S2: diode "prtr5v0u2x" { placement_hint { near: "J_SOIL2" priority: hard } }
    component TP_SOIL2: testpoint "testpoint_pad_1_5"
    notes "" {
      "J_SOIL2 pin1 and pin2 are the probe, pin3 GND. AC excitation: the probe is driven with alternating polarity from two GPIOs through R_S2 and R_D2 (10 k each), so it never sees DC. Firmware: phase 1 drives pin 1 high and pin 2 low and samples SOIL2_ADC_B; phase 2 reverses the drive and samples SOIL2_ADC_A; the two readings are averaged. V(sampled node) = 3.3 V x 10 k / (10 k + Rprobe + 10 k): 2.75 V at 1 k, 0.16 V at 200 k. R_F2 and R_F2B 1 k with C_F2 and C_F2B 10 nF filter the ADC inputs. D_ESD_S2 (PRTR5V0U2X) protects the connector pins."
    }
  }

  // ---- Flow meter -----------------------------------------------------------------------------
  group "FLOW" color "#0e7490" {
    component J_FLOW: connector "jst_ph_3pin" { placement_hint { edge: bottom priority: hard } }
    component R_FPU: resistor "r_generic_0603" value "10k"
    component R_FS: resistor "r_generic_0603" value "2.2k"
    component D_FZ: diode "d_zener_3v3"
    component C_FL: capacitor "c_generic_0603" value "10nF"
    component TP_FLOW: testpoint "testpoint_pad_1_5"
    component D_ESD_FL: diode "smaj15a_tvs" { placement_hint { near: "J_FLOW" priority: hard } }
    notes "" {
      "J_FLOW pin1 +12V_VALVE sensor supply, pin2 GND, pin3 pulse. Open-collector assumed; 3.3 V zener D_FZ (cathode on FLOW_PULSE, anode on GND) behind R_FS 2.2 k clamps a push-pull output to the STM32G030 input range. Current at a 13.0 V sensor output: (13.0 - 3.3) / 2.2 k = 4.41 mA (12 V: 3.95 mA), about 3.3 V x 4.41 mA = 14.5 mW in the zener, far below a 500 mW SOD-123 zener class rating (exact rating needs datasheet sourcing). With the line open the 10 k pull-up R_FPU on +3V3 holds it at 3.3 V, so R_FPU adds at most 3.3 V / 10 k = 0.33 mA."
    }
  }

  // ---- I2C ------------------------------------------------------------------------------------
  group "I2C SENSORS" color "#a16207" {
    component U4: sensor "apds9301_real"
    component U5: memory "24lc256_soic8"
    component C_U4: capacitor "c_generic_0603" value "100nF"
    component C_U5: capacitor "c_generic_0603" value "100nF"
    component R_SDA: resistor "r_generic_0603" value "4.7k"
    component R_SCL: resistor "r_generic_0603" value "4.7k"
    component J_I2C: connector "jst_ph_4pin" { placement_hint { edge: right priority: hard } }
    component TP_SDA: testpoint "testpoint_pad_1_5"
    component TP_SCL: testpoint "testpoint_pad_1_5"
    component D_ESD_I2C: diode "prtr5v0u2x" { placement_hint { near: "J_I2C" priority: hard } }
    notes "" {
      "Addresses: APDS-9301 0x29 (ADR_SEL low), 24LC256 0x50 (A2..A0 low). No collisions. An SHT30 breakout attaches to J_I2C at address 0x44, which stays free."
      "J_I2C pin1 GND, pin2 +3V3, pin3 SDA, pin4 SCL. 3.3 V only, no 5 V; external load <= 100 mA."
    }
  }

  // ---- Indicators -----------------------------------------------------------------------------
  group "LEDS" color "#be123c" {
    component D_PWR: led "ltst_c190kgkt"
    component R_PWR: resistor "r_generic_0603" value "680"
    component D_VALVE: led "led_amber_0603"
    component R_LV: resistor "r_generic_0603" value "680"
    component R_N3: resistor "r_generic_0603" value "2.2k"
    component D_N1: led "led_amber_0603"
    notes "" {
      "D_PWR lit when +3V3 is present. D_VALVE lit when firmware commands either valve on."
      "D_N1 lit when +12V_VALVE is present (R_N3)."
      "LED currents are I = (V - Vf) / R, with Vf from the LED datasheets: Lite-On LTST-C190KGKT 1.9 to 2.4 V at 20 mA (green LED D_PWR), KENTO KT-0603Y 2.4 V (amber LEDs D_VALVE and D_N1, from its LCSC listing). D_PWR, R_PWR 680 on +3V3: 1.3 to 2.1 mA, at most 4.85 mA with Vf = 0. D_VALVE, R_LV 680, driven from MCU pin PA7 at 3.3 V: 1.3 mA, at most 4.85 mA with Vf = 0; the STM32G030 datasheet (DS12991, Table 19) limits the current sourced by any I/O pin to 15 mA. D_N1, R_N3 2.2 k on +12V_VALVE: (13.0 V - 2.4 V) / 2.2 k = 4.8 mA, 51 mW in R_N3, and at most 13.0 V / 2.2 k = 5.9 mA, 77 mW with Vf = 0, against the 100 mW of the 0603 UNI-ROYAL 0603WAF resistor."
    }
  }

  group "TEST POINTS AND MOUNTING" color "#475569" {
    component TP_N1: testpoint "testpoint_pad_1_5"
    component TP_N2: testpoint "testpoint_pad_1_5"
    component H1: mounting_hole "mounting_hole_m2_5"
    component H2: mounting_hole "mounting_hole_m2_5"
    component H3: mounting_hole "mounting_hole_m2_5"
    component H4: mounting_hole "mounting_hole_m2_5"
    notes "" {
      "TP_N1 on +3V3, TP_N2 on GND."
      "Four M2.5 mounting holes at the corners."
    }
  }

  // ================= nets =====================================================================
  net "GND" {
    J1.p2 D_TVS.anode C_BULK.p2 U_IDEAL.gnd C_VIN.p2 C_IN1.p2 C_IN2.p2 U1.gnd U1.gnd_ep C_OUT1.p2 C_OUT2.p2 R_FBB.p2 C_COMP.p2 C_SS.p2
    TP_GND.p1
    U2.VSS C_VDD1.p2 C_VDD2.p2 C_X1.p2 C_X2.p2 C_NRST.p2 SW_RESET.p2 J_SWD.p3
    Q_V1.s Q_V2.s R_PD1.p2 R_PD2.p2
    J_SOIL1.p3 C_F1.p2 C_F1B.p2 D_ESD_S1.gnd J_SOIL2.p3 C_F2.p2 C_F2B.p2 D_ESD_S2.gnd
    J_FLOW.p2 C_FL.p2 D_FZ.anode D_ESD_FL.anode D_ESD_I2C.gnd
    U4.GND U4.ADR_SEL C_U4.p2 U5.vss U5.a0 U5.a1 U5.a2 U5.wp C_U5.p2 J_I2C.p1
    D_PWR.cathode D_VALVE.cathode

    D_N1.cathode

 TP_N2.p1


  }
  net "SNUB2" class "SIG" { R_SN2.p2 C_SN2.p1 }
  net "SNUB1" class "SIG" { R_SN1.p2 C_SN1.p1 }
  net "LED_N12_A" class "SIG" { R_N3.p2 D_N1.anode }
  net "VIN_12V_RAW" class "PWR12" { J1.p1 F1.p1 }
  net "VIN_FUSED" class "PWR12_IN" { F1.p2 Q1.s1 Q1.s2 Q1.s3 U_IDEAL.anode U_IDEAL.en C_VCAP.p2 C_VIN.p1 D_TVS.cathode TP_VIN.p1 }
  net "Q1_GATE" class "SIG" { Q1.g U_IDEAL.gate }
  net "ID_VCAP" class "SIG" { U_IDEAL.vcap C_VCAP.p1 }
  net "+12V_VALVE" class "PWR12" {
    Q1.d U_IDEAL.cathode C_BULK.p1 TP_12V.p1
    C_IN1.p1 C_IN2.p1 U1.in R_EN.p1
    J_VALVE1.p1 D_FLY1.cathode J_VALVE2.p1 D_FLY2.cathode J_FLOW.p1
    R_N3.p1
 R_SN1.p1 R_SN2.p1
  }
  net "BUCK_EN" class "SIG" { U1.en R_EN.p2 }
  net "BUCK_SW" class "PWR12" { U1.sw C_BS.p2 L1.p1 }
  net "BUCK_BS" class "SIG" { U1.bs C_BS.p1 }
  net "BUCK_FB" class "SIG" { U1.fb R_FBT.p2 R_FBB.p1 }
  net "BUCK_COMP" class "SIG" { U1.comp R_COMP.p1 }
  net "BUCK_COMPC" class "SIG" { R_COMP.p2 C_COMP.p1 }
  net "BUCK_SS" class "SIG" { U1.ss C_SS.p1 }
  net "+3V3" class "PWR33" {
    L1.p2 C_OUT1.p1 C_OUT2.p1 R_FBT.p1 TP_3V3.p1
    U2.VDD C_VDD1.p1 C_VDD2.p1 R_NRST.p1 J_SWD.p1
 R_FPU.p1
    U4.VDD C_U4.p1 U5.vcc C_U5.p1 R_SDA.p1 R_SCL.p1 J_I2C.p2
    R_PWR.p1 D_ESD_S1.vcc D_ESD_S2.vcc D_ESD_I2C.vcc

 TP_N1.p1

  }

  // MCU
  net "NRST" class "SIG" { U2.NRST R_NRST.p2 C_NRST.p1 SW_RESET.p1 J_SWD.p5 TP_NRST.p1 }
  net "OSC_IN" class "SIG" { U2.PC14 Y1.xtal_a C_X1.p1 }
  net "OSC_OUT" class "SIG" { U2.PC15 Y1.xtal_b C_X2.p1 }
  net "SWDIO" class "SIG" { U2.PA13 J_SWD.p2 TP_SWDIO.p1 }
  net "SWCLK" class "SIG" { U2.PA14 J_SWD.p4 TP_SWCLK.p1 }

  // Valves (gates on the MCU top side, facing the valve drivers)
  net "VALVE1_GATE" class "SIG" { U2.PB3 R_G1.p1 }
  net "VALVE1_GATE_Q" class "SIG" { R_G1.p2 Q_V1.g R_PD1.p1 }
  net "VALVE1_SW" class "PWR12" { Q_V1.d D_FLY1.anode J_VALVE1.p2 C_SN1.p2 TP_V1.p1 }
  net "VALVE2_GATE" class "SIG" { U2.PB4 R_G2.p1 }
  net "VALVE2_GATE_Q" class "SIG" { R_G2.p2 Q_V2.g R_PD2.p1 }
  net "VALVE2_SW" class "PWR12" { Q_V2.d D_FLY2.anode J_VALVE2.p2 C_SN2.p2 TP_V2.p1 }

  // Soil 1: the probe is driven with alternating polarity from two GPIOs (PA4, PB0) through 10 k, and both probe nodes are sampled (PA2, PA1)
  net "SOIL1_DRV_A" class "SIG" { U2.PA4 R_S1.p1 }
  net "SOIL1_A" class "SIG" { R_S1.p2 J_SOIL1.p1 R_F1.p1 D_ESD_S1.io1 }
  net "SOIL1_DRV_B" class "SIG" { U2.PB0 R_D1.p1 }
  net "SOIL1_B" class "SIG" { R_D1.p2 J_SOIL1.p2 R_F1B.p1 D_ESD_S1.io2 }
  net "SOIL1_ADC_A" class "SIG" { R_F1.p2 C_F1.p1 U2.PA2 TP_SOIL1.p1 }
  net "SOIL1_ADC_B" class "SIG" { R_F1B.p2 C_F1B.p1 U2.PA1 }
  // Soil 2: the probe is driven with alternating polarity from two GPIOs (PA5, PB1) through 10 k, and both probe nodes are sampled (PA3, PA0)
  net "SOIL2_DRV_A" class "SIG" { U2.PA5 R_S2.p1 }
  net "SOIL2_A" class "SIG" { R_S2.p2 J_SOIL2.p1 R_F2.p1 D_ESD_S2.io1 }
  net "SOIL2_DRV_B" class "SIG" { U2.PB1 R_D2.p1 }
  net "SOIL2_B" class "SIG" { R_D2.p2 J_SOIL2.p2 R_F2B.p1 D_ESD_S2.io2 }
  net "SOIL2_ADC_A" class "SIG" { R_F2.p2 C_F2.p1 U2.PA3 TP_SOIL2.p1 }
  net "SOIL2_ADC_B" class "SIG" { R_F2B.p2 C_F2B.p1 U2.PA0 }

  // Flow
  net "FLOW_IN" class "SIG" { J_FLOW.p3 R_FPU.p2 R_FS.p1 D_ESD_FL.cathode }
  net "FLOW_PULSE" class "SIG" { R_FS.p2 D_FZ.cathode C_FL.p1 U2.PA6 TP_FLOW.p1 }

  // I2C
  net "I2C_SDA" class "SIG" { U2.PB7 U4.SDA U5.sda R_SDA.p2 J_I2C.p3 TP_SDA.p1 D_ESD_I2C.io1 }
  net "I2C_SCL" class "SIG" { U2.PB6 U4.SCL U5.scl R_SCL.p2 J_I2C.p4 TP_SCL.p1 D_ESD_I2C.io2 }

  // LEDs
  net "LED_PWR_A" class "SIG" { R_PWR.p2 D_PWR.anode }
  net "LED_VALVE_DRV" class "SIG" { U2.PA7 R_LV.p1 }
  net "LED_VALVE_A" class "SIG" { R_LV.p2 D_VALVE.anode }
}
