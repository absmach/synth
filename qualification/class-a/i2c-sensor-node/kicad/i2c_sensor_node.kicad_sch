	(text
		""
		(at 581.16 72.215 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "3623b7ad-bcea-5539-9aac-e4b84abee460")
	)
	(text
		"J1 pin 1 = +5 V, pin 2 = GND. Mates with JST XHP-2 housing."
		(at 581.16 76.215 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "bb2d6af0-120b-5810-aad4-8e74ac917570")
	)
	(text
		"Order: fuse first (fault current meets a limiter), diode second (reversed supply meets a blocker)."
		(at 581.16 78.755 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "b9a1a2eb-968a-5994-912a-320e8847e907")
	)
	(text
		"D4 clamps transients on +5V_PROT, behind D1 so a reversed supply never forward-biases it."
		(at 581.16 81.295 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "c7434456-67a0-5b66-b5fc-17eaedc08559")
	)
	(text
		""
		(at 17.66 429.15 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "1317a226-ae58-5491-98d2-d7f5347a012d")
	)
	(text
		"CC1/CC2 5.1k to GND: advertises a 5 V sink. D5 guards D+/D-, D6 the CC pins, D3 VBUS."
		(at 17.66 433.15 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "a1576093-e1ce-5116-93f6-c26e9ac3aa73")
	)
	(text
		"D2 ORs VBUS onto +5V_PROT and blocks back-feed into the host port."
		(at 17.66 435.69 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "7dc4f5b6-2263-5bbb-8f9c-49562b97afe6")
	)
	(text
		"Two sources: the higher of the two diode-OR inputs supplies the board; neither is back-fed."
		(at 17.66 438.23 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "c07b3df5-fa93-5734-8d06-b0cb826d6436")
	)
	(text
		""
		(at 17.28 79.9 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "3040c449-b14c-5fbf-a154-1ff783a092b9")
	)
	(text
		"AMS1117 tab is VOUT (pin 2): the tab pad is the +3V3 copper area."
		(at 17.28 83.9 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "69c1a68c-c22b-546e-92e9-0758e2b0df05")
	)
	(text
		"Power LED: (3.3 V - 2.2 V) / 680 R = 1.6 mA."
		(at 17.28 86.44 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "bb4e1a47-7d89-5f13-9766-e989a17c1ba8")
	)
	(text
		""
		(at 200.75 195.47 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "c0a825ad-8415-5833-ab03-27b6c452b76d")
	)
	(text
		"J4: 1 = 3V3_REF (sense only), 2 = SWDIO, 3 = SWCLK, 4 = GND, 5 = NRST."
		(at 200.75 199.47 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "bcc46eac-234e-5302-8776-e219abf8f893")
	)
	(text
		"PA14 is SWCLK and BOOT0. Default option bytes (nBOOT_SEL=1) ignore the pin; blank flash enters the ROM bootloader."
		(at 200.75 202.01 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "0922a0c3-ad0f-55c3-b037-01d478c49b52")
	)
	(text
		"Status LED on PC15: (3.3 - 2.0) / 680 = 1.9 mA."
		(at 200.75 204.55 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "8ddf84c8-f35f-5246-9489-7a340a5fd5a2")
	)
	(text
		""
		(at 283.44 384.635 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "d3d2e57b-5457-5812-b397-77ffbcf31444")
	)
	(text
		"CH340C has an internal oscillator: no crystal. VCC = V3 = 3.3 V."
		(at 283.44 388.635 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "1a99d961-ce48-53e5-90b8-9541cf3b2cc6")
	)
	(text
		"CTS, DSR, RI, DCD and R232 are tied high through R28 (modem lines unused)."
		(at 283.44 391.175 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "e9ce9185-16ab-5a4c-8031-a39820d9e3b6")
	)
	(text
		"DTR (active low) pulls NRST low through 1k. RTS asserted (low) turns Q1 off and BOOT0 rises to 3.3 V."
		(at 283.44 393.715 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "b36cf7a0-7c9c-5494-bcd7-6b8ce16608a1")
	)
	(text
		"Idle RTS is high, Q1 on, BOOT0 low: boots flash with the bridge attached or not."
		(at 283.44 396.255 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "dc10ce7d-6a8d-597a-aff6-f2546ce4775d")
	)
	(text
		"D17 lights on host-to-MCU data, D18 on MCU-to-host data."
		(at 283.44 398.795 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "72fa602f-01b2-531a-91e0-0638ea48e480")
	)
	(text
		""
		(at 17.28 200.55 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "6d6d9132-8a79-5012-a9f1-67b54bc8ff9f")
	)
	(text
		"BME680 SDO low = 0x76, CSB high = I2C. 24LC256 A2:A0 low = 0x50. No collision."
		(at 17.28 204.55 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "fc727a87-1afd-5b9b-a171-79e8118ab535")
	)
	(text
		"One pull-up pair, 4.7k each, for the whole bus."
		(at 17.28 207.09 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "f1bbac50-0ed2-5abb-92f2-908c2f2da6c9")
	)
	(text
		""
		(at 17.59 521.86 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "e138d25c-2621-5ebd-9887-1d8a425fa9aa")
	)
	(text
		"J3: 1 GND, 2 UART_TX (MCU out), 3 UART_RX (MCU in), 4 3V3_REF (sense only, 3 mA max)."
		(at 17.59 525.86 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "b1398214-1f76-5444-a2e7-b861e7306391")
	)
	(text
		"Host must use 3.3 V logic. Clamp to +3V3 + one diode drop (about 4.0 V) and to GND - 0.7 V."
		(at 17.59 528.4 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "ec7346f6-4428-5e22-bc62-2b3c3d9f4cde")
	)
	(text
		""
		(at 580.69 487.57 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "56bd9d49-af94-5d27-82ac-8b02aef7f3e4")
	)
	(text
		"J5: 1 3V3_REF, 2 GND, 3 PA0, 4 PA1, 5 PA4, 6 GND, 7 PA5, 8 PA6, 9 PA7, 10 GND, 11 PB0, 12 PB9."
		(at 580.69 491.57 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "bb5481d5-0dec-54b4-b0f4-e20dcd200e24")
	)
	(text
		"3V3_REF = +3V3 through D14 (blocks back-drive) and 100R: sense or reference only, 3 mA max (about 2.7 V at 3 mA), 30 mA into a short."
		(at 580.69 494.11 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "117e68a9-4c24-5981-9899-3d7512603fe3")
	)
	(text
		""
		(at 183.93 530.75 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "4b4e4324-8f43-5306-ba2a-2088f50a22da")
	)
	(text
		"TP1 +5V_PROT, TP2 +3V3, TP3/TP9 GND, TP4 I2C_SDA, TP5 I2C_SCL, TP6 UART_TX, TP7 UART_RX, TP8 VIN_5V_FUSED."
		(at 183.93 534.75 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "c44f2576-9cff-50ae-8b0d-71d7bbc364e4")
	)
	(text
		"H1-H4: M2.5 non-plated mounting holes at the corners."
		(at 183.93 537.29 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "e28d777c-659a-5ffd-8841-eaa1b9729c44")
	)
