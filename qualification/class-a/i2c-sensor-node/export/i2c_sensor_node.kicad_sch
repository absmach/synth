	(text
		"J1 pin 1 = +5 V, pin 2 = GND (JST XHP-2). Fuse first, then the"
		(at 17.28 50.88 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "2720dfab-8894-5de3-9fe7-2a75ce0d41c7")
	)
	(text
		"reverse-polarity diode D1."
		(at 17.28 53.42 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "f65a80dd-502d-58aa-a6fd-1db122948926")
	)
	(text
		"D4 clamps transients on +5V_PROT, behind D1 so a reversed supply never"
		(at 17.28 55.96 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "7c5bb58b-8f94-58f3-9f91-d820a332333a")
	)
	(text
		"forward-biases it."
		(at 17.28 58.5 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "60bfcab5-d158-5334-8a7e-f7bfe52a0d3a")
	)
	(text
		""
		(at 634.5 79.9 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "c78963e4-807f-5962-9498-62381c6ac8d4")
	)
	(text
		"AMS1117 tab is VOUT. Load budget 100 mA: P = (5.0 - 3.3) x 0.1 A ="
		(at 634.5 83.9 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "24eb7fe9-b2b1-5ad4-b632-77fda95d345e")
	)
	(text
		"0.17 W, thetaJA 90 C/W gives a 15 C rise (125 C limit)."
		(at 634.5 86.44 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "507814ed-3e64-5da6-9ea4-85e59cc1475c")
	)
	(text
		"LED (VF 1.9 to 2.4 V): 1.3 to 2.1 mA through 680 R. C3 is 47 uF"
		(at 634.5 88.98 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "0233cda0-4a2b-5d21-95ca-df1b6fa22665")
	)
	(text
		"tantalum (22 uF required)."
