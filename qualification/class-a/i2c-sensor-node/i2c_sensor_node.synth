// A low-speed I2C sensor board: a regulator, decoupling, bus pull-ups and an
// external connector.
//
// A field sensor node that stands on its own. JST-fed 5 V into a 3V3 LDO, an
// STM32G030 reading two I2C devices -- an environmental sensor and a config
// EEPROM -- with a 4-pin JST break-out for the host UART. One I2C bus, one
// set of pull-ups.
//
// Standalone means three things here, and the board was missing all three.
// It is programmable: SWD and NRST reach J3, so firmware can be loaded and
// recovered without lifting a pin. It is usable as a plain I2C module: the
// bus itself reaches J3 with its pull-ups already fitted, so a host can talk
// to the sensor directly and ignore the MCU. And it is bring-up-able: every
// rail has a probe point and the 3V3 rail has an indicator.
board "i2c_sensor_node" {
    layers 2
    manufacturer "jlcpcb"

    // Two rails, declared rather than described, so the regulator-range and
    // load-budget rules have something to check.
    //
    //   V5_IN  5 V    J1, after the polyfuse and the series Schottky
    //   V3V3   3.3 V  AMS1117 output: MCU, both I2C devices, J2 and J3
    power "V5_IN" 5v
    power "V3V3" 3.3v

    group "POWER" color "#c2410c" {
      component J1: connector "jst_ph_2pin" { placement_hint { region: left_edge edge: left priority: hard } }
      component F1: fuse      "polyfuse" value "500mA"
      component D1: diode     "d_schottky" value "SS14"
      component U1: regulator "ams1117_3v3" value "AMS1117-3.3"
      component C1: capacitor "c_generic_0805" value "10uF"
      component C2: capacitor "c_generic_0805" value "10uF"
      component D4: diode     "ptvs6v0s1ur"
      component D5: led       "led_green_0603"
      component R4: resistor  "r_generic_0603" value "1k"
      component C7: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "U1" priority: hard } }
      component TP1: testpoint "testpoint_pad_1_5"
      component TP2: testpoint "testpoint_pad_1_5"
      notes "" {
        "Polyfuse then series Schottky: resettable over-current plus reverse-polarity."
        "AMS1117 sized for the ~400 mA budget: MCU, two I2C devices and the breakout."
        "C2 is 10 uF, not 1 uF. The AMS1117 wants that much on its output to be"
        "stable, and at 1 uF the decoupling rule was right to complain."
        "D4 clamps the input. A field node's supply arrives on a cable, which"
        "is where surges come from; the polyfuse limits what the clamp has to"
        "conduct, so it sits behind the fuse."
        "D5 on 3V3 is a power indicator and nothing else -- it says the LDO is"
        "up, which is the first question when a node is dark."
        "TP1 on the 5 V input and TP2 on 3V3: both rails probeable without"
        "clipping onto a capacitor."
      }
    }

    connect J1.p1 -> F1.p1
    connect F1.p2 -> D1.anode
    connect D1.cathode -> U1.vin as "V5_IN"
    connect J1.p2 -> U1.gnd as "GND"
    connect U1.vin  -> C1.p1
    connect U1.gnd  -> C1.p2
    connect U1.vout -> C2.p1 as "V3V3"
    connect U1.gnd  -> C2.p2
    connect D1.cathode -> D4.cathode
    connect U1.gnd     -> D4.anode
    connect U1.vout -> R4.p1
    connect R4.p2   -> D5.anode
    connect D5.cathode -> U1.gnd
    connect U1.vin  -> C7.p1
    connect U1.gnd  -> C7.p2
    connect D1.cathode -> TP1.p1
    connect U1.vout    -> TP2.p1

    group "MCU" color "#0072b2" {
      component U2: mcu       "stm32g030"
      component C3: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "U2" priority: hard } }
      component R1: resistor  "r_generic_0603" value "10k"   { placement_hint { near: "U2" priority: hard } }
      component C4: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "U2" priority: hard } }
    }

    connect U1.vout -> U2.vdd
    connect U1.gnd  -> U2.vss
    connect U2.vdd  -> C3.p1
    connect U2.vss  -> C3.p2
    connect U1.vout -> R1.p1
    connect R1.p2   -> U2.nrst
    connect U2.nrst -> C4.p1
    connect U2.vss  -> C4.p2

    group "I2C BUS" color "#0a7d4a" {
      component U3: sensor    "bme680_env"
      component U4: memory    "24lc256_eeprom"
      component R2: resistor  "r_generic_0603" value "4.7k"
      component R3: resistor  "r_generic_0603" value "4.7k"
      component C5: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "U3" priority: hard } }
      component C6: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "U4" priority: hard } }
      notes "" {
        "One bus, one pair of 4.7k pull-ups sized for 400 kHz at 3V3."
        "BME680 at 0x76: CSB high selects I2C, SDO low selects the low address."
      }
    }

    connect U1.vout -> U3.vdd
    connect U1.gnd  -> U3.gnd
    connect U3.vdd  -> C5.p1
    connect U3.gnd  -> C5.p2
    connect U3.csb  -> U1.vout
    connect U3.sdo  -> U1.gnd

    connect U1.vout -> U4.vdd
    connect U1.gnd  -> U4.gnd
    connect U4.vdd  -> C6.p1
    connect U4.gnd  -> C6.p2
    // A0/A1/A2 and WP were floating, which leaves the EEPROM's address and
    // its write-protect state undefined -- four CMOS inputs with no DC path.
    // All four to ground: address 0x50, write enabled.
    connect U4.a0 -> U1.gnd
    connect U4.a1 -> U1.gnd
    connect U4.a2 -> U1.gnd
    connect U4.wp -> U1.gnd

    connect U2.pa10 -> U3.sda
    connect U2.pa10 -> U4.sda
    connect U2.pa9  -> U3.scl
    connect U2.pa9  -> U4.scl
    connect U2.pa10 -> R2.p1
    connect R2.p2   -> U1.vout
    connect U2.pa9  -> R3.p1
    connect R3.p2   -> U1.vout

    group "HOST BREAKOUT" color "#b45309" {
      component J2: connector "jst_ph_4pin" { placement_hint { region: right_edge edge: right priority: hard } }
      component D2: diode     "esd_usb"
      component D3: diode     "esd_usb"
      component C9: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "J2" priority: hard } }
      notes "" {
        "3V3 / TX / RX / GND in pin order. One ESD clamp per exposed line,"
        "referenced to ground rather than to the rail."
      }
    }

    connect U1.vout -> C9.p1
    connect U1.gnd  -> C9.p2
    connect U1.vout -> J2.p1
    connect U2.pa2  -> J2.p2
    connect U2.pa3  -> J2.p3
    connect U1.gnd  -> J2.p4
    connect J2.p2   -> D2.io
    connect U1.gnd  -> D2.gnd
    connect J2.p3   -> D3.io
    connect U1.gnd  -> D3.gnd

    group "EXPANSION" color "#525252" {
      component J3: connector "header_1x20" { placement_hint { region: bottom_edge edge: bottom priority: hard } }
      component C8: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "J3" priority: hard } }
      component TP3: testpoint "testpoint_pad_1_5"
      component TP4: testpoint "testpoint_pad_1_5"
      component TP5: testpoint "testpoint_pad_1_5"
      notes "" {
        "One header, four jobs: power out, the I2C bus, SWD with reset, and"
        "ten spare GPIOs. Pinout, 1 to 20:"
        "  1 V5_IN   2 V3V3    3 GND     4 SDA     5 SCL"
        "  6 GND     7 SWDIO   8 SWCLK   9 NRST   10 GND"
        " 11 PA0    12 PA1    13 PA4    14 PA5    15 PA6"
        " 16 PA7    17 PB0    18 PB1    19 PB3    20 PB4"
        "SDA and SCL are the same bus the on-board devices sit on, pull-ups"
        "already fitted, so a host can drive the sensor directly and leave the"
        "MCU held in reset through pin 9."
        "Every signal on this header is 3V3 CMOS and none of it is protected."
        "Driving it from 5 V logic overstresses the pins: use a level shifter"
        "on the host side. PA2 and PA3 are not here because they are the UART"
        "already brought out on J2, clamped; PA9 and PA10 appear only as SDA"
        "and SCL. The remaining 13 pins of the package are not exposed."
        "TP3 and TP4 probe SDA and SCL at the header; TP5 is the ground"
        "reference for every other probe point on the board."
        "J3 runs along the bottom edge, J1 on the left and J2 on the right:"
        "supply in one side, host out the other, expansion along the front,"
        "and all three clear of the corner mounting holes."
      }
    }

    connect D1.cathode -> J3.p1
    connect U1.vout    -> J3.p2
    connect U1.gnd     -> J3.p3
    connect U2.pa10    -> J3.p4
    connect U2.pa9     -> J3.p5
    connect U1.gnd     -> J3.p6
    connect U2.pa13    -> J3.p7
    connect U2.pa14    -> J3.p8
    connect U2.nrst    -> J3.p9
    connect U1.gnd     -> J3.p10
    connect U2.pa0     -> J3.p11
    connect U2.pa1     -> J3.p12
    connect U2.pa4     -> J3.p13
    connect U2.pa5     -> J3.p14
    connect U2.pa6     -> J3.p15
    connect U2.pa7     -> J3.p16
    connect U2.pb0     -> J3.p17
    connect U2.pb1     -> J3.p18
    connect U2.pb3     -> J3.p19
    connect U2.pb4     -> J3.p20

    connect U1.vout -> C8.p1
    connect U1.gnd  -> C8.p2
    connect U2.pa10 -> TP3.p1
    connect U2.pa9  -> TP4.p1
    connect U1.gnd  -> TP5.p1

    group "MECHANICAL" color "#737373" {
      component H1: mounting_hole "mounting_hole_m2_5" { placement_hint { region: top_left priority: hard } }
      component H2: mounting_hole "mounting_hole_m2_5" { placement_hint { region: top_right priority: hard } }
      component H3: mounting_hole "mounting_hole_m2_5" { placement_hint { region: bottom_left priority: hard } }
      component H4: mounting_hole "mounting_hole_m2_5" { placement_hint { region: bottom_right priority: hard } }
      component FID1: fiducial "fiducial_1mm" { placement_hint { region: top_edge priority: soft } }
      component FID2: fiducial "fiducial_1mm" { placement_hint { region: bottom_edge priority: soft } }
      notes "" {
        "Four M2.5 holes so the node can be mounted in an enclosure, two"
        "fiducials for placement."
        "The corner hints are not decoration. `MountingHole_2.5mm` draws its"
        "courtyard as a single fp_circle, and the placer reads courtyards from"
        "fp_rect and fp_line only, so an unhinted hole reserves no area and"
        "lands on top of whatever is already there."
      }
    }
  }
