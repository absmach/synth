			)
			(justify left bottom)
		)
		(uuid "b6c1125d-24ae-537c-93ed-2724b8e7c144")
	)
	(text
		"J2: 1 +3V3_REF, 2 GND, 3 LOAD_EN, 4 GND, 5 SENSE_12V, 6 SENSE_5V, 7 SENSE_3V3, 8 GND."
		(at 18.93 510.555 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "9c50aa99-b030-59d8-8342-e9f5febf1a5e")
	)
	(text
		"No FAULT pin: no part on the board produces a fault signal."
		(at 18.93 513.095 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
