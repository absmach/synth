				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "c2f5d41a-8212-5c84-88d6-6e6a348a4551")
	)
	(text
		"J3 pin 1 = +5V, J4 pin 1 = +5V_SW, J5 pin 1 = +3V3; pin 2 of each = GND."
		(at 612.98 92.79 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "85d868eb-1340-5e3f-876f-fc3719bd38e0")
	)
