			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f4697d90-9ca2-5c94-af04-c527f5b8dd93")
	)
	(text
		"J1 pin 1 = +12 V, pin 2 = GND (JST S2B-XH-A, mate with XHP-2)."
		(at 197.08 190.515 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "90a7158b-d331-5fab-a40f-8652021a7b59")
	)
	(text
		"Chain: J1 > F1 > Q1 > +12V_PROT; D1 sits after Q1 so it never sees a reversed supply."
		(at 197.08 193.055 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "8784cff1-cb99-519a-8264-d6a7e80718e4")
	)
	(text
		"Q1 source = load side, drain = input side. D9 holds |Vgs| to 5.1 V (Si2301 abs max 8 V)."
		(at 197.08 195.595 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "6e679fab-82c4-5c37-bdee-09fd9d70a608")
	)
	(text
		""
		(at 410.23 445.595 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "4786d881-3199-593f-9e79-3ce910cd3b9b")
	)
	(text
		"FB divider: 0.925 V x (1 + 44.2k/10k) = 5.01 V."
		(at 410.23 449.595 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "a9681e2e-5d6b-572f-8ed6-237ef1fe961c")
	)
	(text
		"EN divider 100k/33k: buck starts above about 4.8 V in."
		(at 410.23 452.135 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "a42374d8-84f9-552f-9345-61ba642f665a")
	)
	(text
		""
		(at 17.56 178.96 0)
		(effects
