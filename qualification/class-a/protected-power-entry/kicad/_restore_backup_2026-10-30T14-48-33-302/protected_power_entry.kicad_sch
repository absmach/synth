				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "81feff1b-2c1b-581a-9c00-2e56a93a867a")
	)
	(text
		"LOAD_EN default is OFF (R7 pull-down). High (above 1.0 V) turns +5V_SW on."
		(at 17.56 182.96 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "17dbfe68-115a-56b5-8e25-0e949ee101b7")
	)
	(text
		"AMS1117 dissipation: (5 - 3.3) V x 0.5 A = 0.85 W worst case."
		(at 17.56 185.5 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "2faf48d7-3750-5569-991a-af4ac6a4ee00")
	)
	(text
		""
		(at 612.98 88.79 0)
		(effects
