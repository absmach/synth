	(text
		""
		(at 17.28 147.81 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "3f929b7b-bc3c-519a-bf37-1e63951b75a0")
	)
	(text
		"J_PWR 1 = +24 V, 2 = GND. Q_REV is a P-FET reverse-polarity block:"
		(at 17.28 151.81 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "69f91b72-086c-551c-92a9-f4977b1777ba")
	)
	(text
		"drain to input, source to VBUS. R_REV_G1/G2 22k/10k hold VGS near -16.5 V"
		(at 17.28 154.35 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "cb48f8e1-b0c2-53bc-b7de-c31233b8787f")
	)
	(text
		"at 24 V; D_REV_Z clamps VGS at 15 V during a TVS clamp."
		(at 17.28 156.89 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "16570ebd-aa2c-5e46-90d6-a509a61d315d")
	)
	(text
		"D_TVS SMBJ30A: VWM 30 V, VBR 33.3-36.8 V, clamp 48.4 V at 12.4 A."
		(at 17.28 159.43 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "2caba743-de19-59c3-af89-be08ccbd8d4a")
	)
	(text
		"C_BULK1/2 are 470 uF 50 V (24 V x 1.5 = 36 V minimum rating)."
		(at 17.28 161.97 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "25ad0ec9-83be-5c20-a8f7-9fb9f43a7a8a")
	)
	(text
		"No fuse is fitted; the 24 V feed must be externally limited to 10 A."
		(at 17.28 164.51 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "8e27e33a-e841-5b97-824c-c04afaffa435")
	)
	(text
		""
		(at 218.18 139.525 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "9f0137a2-25e6-5a2c-87be-eff55d6bd02c")
	)
	(text
		"BSC030N08NS5: 80 V, 100 A, 3.0 mOhm max at VGS 10 V, PG-TDSON-8."
		(at 218.18 143.525 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "3c4120bc-daae-5e48-b39e-70795752e9d4")
	)
	(text
		"Each half bridge has three source pins in parallel; the drain pad is pin 5."
		(at 218.18 146.065 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "7021dafa-7817-5d35-bd38-b15c987d6de6")
	)
	(text
		"Low-side shunt 5 mOhm: 50 mV at 10 A, 0.5 W in a 2512 (1 W part)."
		(at 218.18 148.605 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "70b48733-8fce-5a88-a266-50bf8eeb32ec")
	)
	(text
		"Phase copper is 2 mm wide on 2 oz outer layers; see NETLIST.md."
		(at 218.18 151.145 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "40f8c896-cb34-560a-ad8b-25e908cc9104")
	)
	(text
		""
		(at 370.72 245 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "3fb8836c-7e99-58b2-b56e-6cb8d5024cb0")
	)
	(text
		"IR2101: VCC 12 V, COM GND, HIN/LIN 3.3 V logic, HO/LO through 10 R."
		(at 370.72 249 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "d4761582-fba3-54ec-823d-ce91a8d614e4")
	)
	(text
		"Bootstrap: 1N5819HW from +12V_GD to VB, 100 nF from VB to VS."
		(at 370.72 251.54 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "0f1346b0-b24d-5230-8bd4-0c0e287e5182")
	)
	(text
		"HIN and LIN have 10k pulldowns so a floating MCU keeps both outputs low."
		(at 370.72 254.08 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "8db7784c-24cd-50fe-aab0-89c77e3664e9")
	)
	(text
		"Q_GE is a 12 V load switch for the drivers, controlled by GATE_EN:"
		(at 370.72 256.62 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "d629a03f-bcf6-5646-aad6-08ad2e2180ce")
	)
	(text
		"Q_GE_CTRL pulls the P-FET gate low, R_GE_PU holds it off."
		(at 370.72 259.16 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "7f3aa89e-4787-5cd5-b4c2-723effa674ac")
	)
	(text
		"IR2101 logic: HIN and LIN high together turns both outputs off;"
		(at 370.72 261.7 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "f07f9c3d-0f68-5f6f-abb7-e714f53f59a5")
	)
	(text
		"dead time is the MCU's responsibility and is not checked by Synth."
		(at 370.72 264.24 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "96105bd6-41b2-58bd-97c0-45c81bcc770e")
	)
	(text
		""
		(at 19.28 493.92 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "942b27a4-05c3-54a4-8a09-91c82e2fbaff")
	)
	(text
		"Non-inverting gain: 1 + 39k/1k = 40. 10 A x 5 mOhm = 50 mV -> 2.0 V."
		(at 19.28 497.92 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "3c0af22c-0167-5fd2-b097-ac2481068474")
	)
	(text
		"MCP6022 GBW 10 MHz, so the closed-loop band is about 250 kHz."
		(at 19.28 500.46 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "253e7c65-b6c5-5985-a867-80ee07d186dc")
	)
	(text
		"1k + 100 nF at the + input gives fc = 1.6 kHz; the 100 pF across"
		(at 19.28 503 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "a0552060-050f-5c36-ac97-15856acc8200")
	)
	(text
		"39k adds a 41 kHz pole, above the current-loop bandwidth."
		(at 19.28 505.54 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "1f6ba0fe-f77a-50a4-a9b7-12a4acb477c4")
	)
	(text
		"The spare MCP6022 channel compares ISENSE_W with 1.65 V (about 8.25 A)"
		(at 19.28 508.08 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "18fed7be-09ff-54f8-99ed-94c97fcdfb3d")
	)
	(text
		"and pulls FAULT_N low through Q_FAULT."
		(at 19.28 510.62 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "9dfc2dc1-1dc8-58a2-8d1f-873d13ef2c85")
	)
	(text
		""
		(at 620.98 524.4 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "eb90a2db-afab-5fd0-9e37-c89be4e2b7f0")
	)
	(text
		"LMR38010 (85 V absolute maximum, above the 48.4 V TVS clamp), 1 A."
		(at 620.98 528.4 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "6dfb50e6-2f1b-58a2-a2d6-3603ec251094")
	)
	(text
		"Vout = 1.0 V x (1 + 110k/10k) = 12.0 V."
		(at 620.98 530.94 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "7765b33e-82e0-59ca-9586-3017f30284e5")
	)
	(text
		"R_RT 33k sets 800 kHz; L 6.8 uH keeps the ripple below 0.3 A at 12 V/1 A."
		(at 620.98 533.48 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "73a7839b-b28a-5377-95d7-96f299aa72f8")
	)
	(text
		"L_12B2B isolates the board-to-board 12 V pin from the buck output."
		(at 620.98 536.02 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "16cf138c-bc6d-560f-a761-909faf4b2cfd")
	)
	(text
		""
		(at 370.34 372 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "51f1cda4-226a-56af-a214-439bc27daf7f")
	)
	(text
		"VBUS divider: 24 x 13/113 = 2.76 V; 26.4 V gives 3.04 V."
		(at 370.34 376 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "a9dafda2-21f8-500d-8028-4f95d0a0c360")
	)
	(text
		"This is the only 24 V signal leaving the power board."
		(at 370.34 378.54 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "97fa4f56-944d-55b9-882e-64c42c12c6ae")
	)
	(text
		""
		(at 492.99 407.56 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "16429f2f-b4f0-5605-890c-f82ce1590744")
	)
	(text
		"Reference: 3.3 V x 10k/(10k+10k) = 1.65 V, about 8.25 A on the 5 mOhm shunt."
		(at 492.99 411.56 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "1bf5a6da-03e8-5e47-b2ed-ed033de0c05d")
	)
	(text
		"U_CS2 channel B output high on overcurrent -> Q_FAULT pulls FAULT_N low."
		(at 492.99 414.1 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "4064cbfc-7143-522a-b919-c51e39f2d623")
	)
	(text
		"R_FAULT_PU 10k keeps FAULT_N high if the control board is absent."
		(at 492.99 416.64 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "40c272ba-6d4d-5a5b-adb5-d13da57af33b")
	)
	(text
		""
		(at 370.86 511.7 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "9f6f8eba-74bb-50c9-b3c1-9d6c09897b84")
	)
	(text
		"J_B2B socket pinout (mates with the control-board plug):"
		(at 370.86 515.7 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "680cfab1-a2fd-5bcc-99c3-a8b4ccdf4976")
	)
	(text
		"1 PWM_UH, 2 PWM_UL, 3 PWM_VH, 4 PWM_VL, 5 PWM_WH, 6 PWM_WL,"
		(at 370.86 518.24 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "9e3b55cc-cb79-5e17-bdc4-47563fb45e9a")
	)
	(text
		"7 ISENSE_U, 8 ISENSE_V, 9 ISENSE_W, 10 VBUS_SENSE, 11 GATE_EN,"
		(at 370.86 520.78 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "a2cdad67-a845-5b76-988b-bf24c87e4ff9")
	)
	(text
		"12 FAULT_N, 13 +3V3, 14 +12V_LOGIC, 15-20 GND."
		(at 370.86 523.32 0)
		(effects
			(font
				(size 1 1)
			)
