	)
	(text
		"STATUS LEDS"
		(at 279.6894 133.92 0)
		(effects
			(font
				(size 2.54 2.54)
				bold
			)
			(justify left bottom)
		)
		(uuid "aebd2243-3be1-5a4c-b428-0ef3cf2216b2")
	)
	(text
		"SENSE"
		(at 221.333 17.75 0)
		(effects
			(font
				(size 2.54 2.54)
				bold
			)
			(justify left bottom)
		)
		(uuid "6d8e6425-a036-5c0b-b74e-244e40cb1612")
	)
	(text
		""
		(at 17.8 58.31 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "37252ee7-c450-5007-afd1-1cf4251352ec")
	)
	(text
		"J_B2B pinout (control plug, mates with the power-board socket):"
		(at 17.8 62.31 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "e36ed36b-67ac-57c9-bc79-f8bcb9464627")
	)
	(text
		"1 PWM_UH, 2 PWM_UL, 3 PWM_VH, 4 PWM_VL, 5 PWM_WH, 6 PWM_WL,"
		(at 17.8 64.85 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "83c705da-933e-52ea-8f30-dfa4e8d2c504")
	)
	(text
		"7 ISENSE_U, 8 ISENSE_V, 9 ISENSE_W, 10 VBUS_SENSE, 11 GATE_EN,"
		(at 17.8 67.39 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "f342ed84-2d3f-590d-b552-3b4c2762f2c0")
	)
	(text
		"12 FAULT_N, 13 +3V3, 14 +12V_LOGIC, 15-20 GND."
		(at 17.8 69.93 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "1cab9df6-4204-51d2-a07a-9a99d0faeede")
	)
	(text
		"2.54 mm 2x10, 2.5 A per contact; every signal is far below that."
		(at 17.8 72.47 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "12080a49-8768-5269-8e9b-85134acba0cf")
	)
	(text
		""
		(at 19.04 326.28 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "ee4b8ce3-d169-5a8f-a405-dcf9b8e1cbae")
	)
	(text
		"12 V logic rail -> AMS1117-3.3. At 100 mA the loss is (12 - 3.3) x 0.1 = 0.87 W;"
		(at 19.04 330.28 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "8a67cabb-61c5-58fd-b43b-804d1c0e3841")
	)
	(text
		"the SOT-223 tab is VOUT, so the copper under it is 3.3 V, not ground."
		(at 19.04 332.82 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "ae31b684-e349-5a05-b69e-fc7e95e00425")
	)
	(text
		"Dropout is 1.3 V max at 800 mA; 12 V leaves ample headroom."
		(at 19.04 335.36 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "0c8174ca-d62a-5a27-988b-eb139e3388b5")
	)
	(text
		"L_B3V3 isolates the board-to-board 3.3 V pin from the local rail."
		(at 19.04 337.9 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "67bbc934-d045-561f-b61e-0d1b193125e5")
	)
	(text
		""
		(at 351.36 201.82 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "d734d895-8386-5f73-96dd-8f52c94bc1ad")
	)
	(text
		"STM32G030K8T6, LQFP-32. VDD 3.3 V with 100 nF + 4.7 uF."
		(at 351.36 205.82 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "d469b2da-8dd3-513f-8b53-99565c26d88d")
	)
	(text
		"PA14 is SWCLK on this package and also BOOT0; the boot button pulls it"
		(at 351.36 208.36 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "80f1750e-1740-5c86-9194-4194bbedb188")
	)
	(text
		"high through 1k, so a debugger driving SWCLK low is not shorted."
		(at 351.36 210.9 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "35666dc3-e3b9-5755-ba75-53c5e3a708d8")
	)
	(text
		"PWM: PA8/PA9/PA10 = TIM1 CH1/2/3, PB4/PB5/PB0 = TIM3 CH1/2/3."
		(at 351.36 213.44 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "e9f9fa50-c00f-52ca-836f-3e2c7e472d9f")
	)
	(text
		"USART1: PB6 TX, PB7 RX, PB8 DE/RE. ADC: PA0/PA1/PA2/PA7, PB1."
		(at 351.36 215.98 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "3dbf29cf-6b33-5d92-839e-0705579a6249")
	)
	(text
		""
		(at 19.21 231.63 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "2dbb6707-ca20-5528-a3e5-f0aafcfdc97a")
	)
	(text
		"Each Hall connector: pin 1 +3V3, pin 2 output, pin 3 GND."
		(at 19.21 235.63 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "9926750b-3677-59b5-916a-e8593251c127")
	)
	(text
		"10k pull-up, 1k series and 100 nF at the MCU pin: fc = 1/(2 pi 1k 100n) = 1.6 kHz."
		(at 19.21 238.17 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "d0ad96fa-60bc-57a0-b9eb-eed293d9f4d4")
	)
	(text
		"Outputs go to PA4, PA5 and PA6."
		(at 19.21 240.71 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "970a24b8-9971-5559-9593-2651cba6f32e")
	)
	(text
		""
		(at 166.18 356.695 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "c82a57c0-f096-5baf-9f03-7193238005e8")
	)
	(text
		"J_ENC: 1 +3V3, 2 A, 3 B, 4 GND. Open-collector encoder assumed,"
		(at 166.18 360.695 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "93eaac85-a855-5a36-9922-3271c4c0a45c")
	)
	(text
		"so A and B have 10k pull-ups and 100 nF to ground (fc = 160 Hz)."
		(at 166.18 363.235 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "55d220a2-b29e-5351-996d-05056cb327e8")
	)
	(text
		""
		(at 351.74 354.22 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "7f93e53c-7cc6-56fc-9b4a-8eb305929b8a")
	)
	(text
		"USART1 PB6/PB7, DE and /RE tied to PB8. 120 ohm termination across A/B."
		(at 351.74 358.22 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "3ec7dd16-3e79-53c1-a350-4ea8ee413a10")
	)
	(text
		"PTVS6V0S1UR clamps A and B to ground; the THVD1450 already has 18 kV"
		(at 351.74 360.76 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "ace46151-7db7-585b-900a-5abc0ab79d5f")
	)
	(text
		"IEC contact ESD, so these are a second stage, not the primary clamp."
		(at 351.74 363.3 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "49019832-bfec-5ba2-a8a6-2e34181bbb75")
	)
	(text
		""
		(at 18.86 114.19 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "4a0a765b-b294-55b2-a45d-7b015d79494a")
	)
	(text
		"J_SWD: 1 +3V3, 2 SWDIO (PA13), 3 SWCLK (PA14), 4 GND."
		(at 18.86 118.19 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "2378d78d-0e5b-5c2f-8a41-061bc5de07d5")
	)
	(text
		"No NRST on the header; the boot button shares PA14."
		(at 18.86 120.73 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "2899c463-4379-5cb2-bdb7-26102e890f64")
	)
	(text
		""
		(at 247.08 222.14 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "166872d8-c57b-54a7-bbe2-c9f937e69853")
	)
	(text
		"PB2 drives the green status LED, PB3 the red fault LED, both active high."
		(at 247.08 226.14 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "3117ea05-b41f-512c-ab77-8e60424678fb")
	)
	(text
		"(3.3 - 2.1) / 470 = 2.6 mA."
		(at 247.08 228.68 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "4a91f00a-df78-5f09-b93b-20931aa2cf85")
	)
	(text
		""
		(at 115.59 110.38 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "ddc6104a-a607-5113-8d89-7894ab530168")
	)
	(text
		"ISENSE_U/V/W arrive as 0-2 V from the power-board amplifiers; 1k + 100 nF"
		(at 115.59 114.38 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "5f5c2592-3f5f-58c9-945c-82a156d38048")
	)
	(text
		"at PA0/PA1/PA2 (fc = 1.6 kHz)."
		(at 115.59 116.92 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "87194c12-ad2d-57c2-9635-0e0ee408211c")
	)
	(text
		"VBUS_SENSE is divided on the power board; 1k + 100 nF at PA7."
		(at 115.59 119.46 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "e660951d-8df0-50d9-957e-052ef269de97")
	)
	(text
		"12 V rail sense: 100k/22k gives 12 x 22/122 = 2.16 V at PB1."
		(at 115.59 122 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "4ddb29f8-ddf3-5a28-b633-fe478add8595")
	)
	(text
		""
		(at 20 383.35 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "e6bb00a7-bb8b-5283-930f-db0096ab78ce")
	)
	(text
		"Four M2.5 non-plated holes. H1-H4 are at the same board coordinates"
		(at 20 387.35 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "3238219d-1db6-5c08-8f2a-7d5314145a51")
	)
	(text
		"as the power board so the two boards stack."
		(at 20 389.89 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "b1703cbf-4fe0-5c6b-8dcb-b5afba2066fb")
	)
