	(text
		"CM4 MODULE"
		(at 16.74 15.81 0)
		(effects
			(font
				(size 2.54 2.54)
				bold
			)
			(justify left bottom)
		)
		(uuid "74f6bcf8-9cb3-58fa-bd25-24f1ec44d62d")
	)
	(text
		"MECHANICAL"
		(at 920.67 583.5 0)
		(effects
			(font
				(size 2.54 2.54)
				bold
			)
			(justify left bottom)
		)
		(uuid "8f72745b-2086-50f0-ab63-858fc2033fca")
	)
	(text
		""
		(at 16.74 289.45 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "31e9fe09-6a14-522c-b6ee-dfaf37f71a6a")
	)
	(text
		"J_CM4A is CM4 pins 1-100; J_CM4B is CM4 pins 101-200. Pin pN on each is pad N."
		(at 16.74 293.45 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "d94f5127-c585-5ff4-81e2-c778eb6aac7f")
	)
	(text
		"J_VREF: 1-2 = 3.3 V GPIO (default), 2-3 = 1.8 V GPIO."
		(at 16.74 295.99 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "bba89c1c-d6bd-5864-8e12-ad31f92bea2d")
	)
	(text
		"J_BOOT shorts nRPIBOOT to GND for USB boot. SW1 pulls GLOBAL_EN low."
		(at 16.74 298.53 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "4d9c4db0-fce3-531b-82aa-319610e754dc")
	)
	(text
		"CM4_3.3V and CM4_1.8V are module outputs and are brought to test points only."
		(at 16.74 301.07 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "eb9fd786-e13d-5ea9-af04-468dc0c84955")
	)
	(text
		"NC (no net): 16,18,19,20,64,68,70,72,73,76,89,91,94,96,102,104,106,109,110,111,112."
		(at 16.74 303.61 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "7917d72f-f83e-5d04-85ee-2fe756bad578")
	)
	(text
		"NC (no net): 115,116,117,118,121,122,123,124,127,129,133,135,139,141 (CAM1, PCIe RX/TX)."
		(at 16.74 306.15 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "6d3900e5-9e1a-5800-b464-63c5a45e313f")
	)
	(text
		"NC (no net): 143,145,146,147,148,149,152,154,158,160,164,166 (HDMI1)."
		(at 16.74 308.69 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "b9c5eba0-3f6d-5663-affc-3ca16854c651")
	)
	(text
		"NC (no net): 175,177,181,183,187,189,193,194,195,196 (DSI1)."
		(at 16.74 311.23 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "3baa946f-43c9-5995-b5ca-f6fb10c2cd06")
	)
	(text
		""
		(at 920.67 610.76 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f0b2b26a-2a5d-516b-b7ec-a387d6084e7f")
	)
	(text
