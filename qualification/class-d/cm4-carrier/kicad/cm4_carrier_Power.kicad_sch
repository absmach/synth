		(uuid "8c6a3026-125c-5216-a2ad-e82a7a82ae72")
	)
	(text
		"F1 2.6 A hold PTC; Q1 DMP3098L reverse-polarity P-FET; D1 SMAJ15A clamps at 24.4 V, below the 38 V LMR33640 absolute maximum."
		(at 19 188.04 0)
		(effects
			(font
				(size 1 1)
			)
