	(text
		""
		(at 17.28 114.19 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "c6dc9ebf-bcf4-5e46-80a5-e9f13be0c6c1")
	)
	(text
		"USB2514B self-powered, CFG_SEL=00, individual port power and over-current."
		(at 17.28 118.19 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "8e9e1480-0344-5f3a-b604-f6236372965f")
	)
	(text
		"One TPS22918 per port (500 mA port limit), one PRTR5V0U2X per port."
		(at 17.28 120.73 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "1c6622e9-713d-59cc-9774-61c7f87d201c")
	)
	(text
		"24 MHz crystal, 12k RBIAS, 100 nF CRFILT/PLLFILT."
		(at 17.28 123.27 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "d3262a9e-659f-50f3-ba5e-df373602bca2")
	)
	(text
		"PRTPWR1-4 drive the TPS22918 ON pins; OCS_N1-4 are tied high (no over-current sensor)."
		(at 17.28 125.81 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "248e94ca-3221-5d0a-9fdf-8438d60fbb2c")
	)
	(text
		""
		(at 17.065 198.01 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "2a027283-4cfb-5062-89d8-7648f554c21d")
	)
	(text
		"Pulse JXD6-0001NL GbE magjack, 1:1. TCT/RCT to GND through 100 nF (CM4IO reference)."
		(at 17.065 202.01 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "5ec30677-2092-50c5-892e-c6eb9a7e40e1")
	)
	(text
		"Four 100 ohm pairs; ESD on each pair."
		(at 17.065 204.55 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "84b280b7-f5c7-5dca-888c-709930f36230")
	)
	(text
		""
		(at 395.24 225.95 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f0b2b26a-2a5d-516b-b7ec-a387d6084e7f")
	)
	(text
		"HDMI0 only; TMDS pairs, CEC, HPD and DDC."
		(at 395.24 229.95 0)
		(effects
			(font
				(size 1 1)
			)
