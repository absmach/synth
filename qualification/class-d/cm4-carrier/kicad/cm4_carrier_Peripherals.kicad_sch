	(text
		""
		(at 22.81 168.8 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "17fb997a-8d7c-511a-94d3-1e51c1fb4bb2")
	)
	(text
		"CM4 Lite SD interface, 4-bit. U11 switches SD_VDD from SD_PWR_ON."
		(at 22.81 172.8 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "e79d2125-74eb-51ef-a0c7-07e911455820")
	)
	(text
		"10k pull-ups on CMD and DAT0-3; ESD on all six lines."
		(at 22.81 175.34 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "100b4f9a-b4e4-524f-a6f9-c7ba971f51b8")
	)
	(text
		""
		(at 21.33 355.49 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "2a027283-4cfb-5062-89d8-7648f554c21d")
	)
	(text
		"22-pin FFC: CAM0 (2 lanes) and DSI0 (2 lanes)."
		(at 21.33 359.49 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "52000a78-da7f-57e4-be3a-2ec908c9a11b")
	)
	(text
		"SCL0/SDA0 shared with the RTC; CAM_GPIO drives camera power enable."
		(at 21.33 362.03 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "cf965931-7573-521a-ac82-28a58381ad74")
	)
	(text
		"D2/D3 lanes are not connected on these 2-lane ports."
		(at 21.33 364.57 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "205d0af5-4a47-5688-b5e9-a06d041bd7c9")
	)
	(text
		""
		(at 204.35 332.63 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "36a319dd-5a66-5d69-9bdc-159eedf225a7")
	)
	(text
		"2x20 Raspberry Pi header pinout. J_GPIO1 is the odd pins, J_GPIO2 the even pins."
		(at 204.35 336.63 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "f1c83ede-e940-5f9a-a305-655f0bc9a169")
	)
	(text
		"All 28 CM4 GPIOs are brought out; GPIO26 also carries the RTC interrupt."
		(at 204.35 339.17 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "86d298da-00d6-57a9-802a-3a53c523c20f")
	)
	(text
		""
		(at 380.64 266.59 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "86c92338-4c5a-5415-9c09-f63e073cc000")
	)
	(text
		"PCF85063ATL with 32.768 kHz crystal; VDD is diode-ORed from +3V3 and the CR2032."
		(at 380.64 270.59 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "3e92b4d1-31f4-5527-a9ca-993ce661671f")
	)
	(text
		"I2C on SCL0/SDA0; INT on GPIO26. CLKOE tied low to save power."
		(at 380.64 273.13 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "ef736193-2fb3-5e31-a7e4-da2eac6dee28")
	)
	(text
		""
		(at 380.67 41.8 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "3caa23d9-134a-59f2-b1e8-788a68ec6cd5")
	)
	(text
		"2-pin +5 V fan header with a Schottky flyback diode. Always on."
		(at 380.67 45.8 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "c60ec7fa-4b32-5d79-a131-842fc7997116")
	)
