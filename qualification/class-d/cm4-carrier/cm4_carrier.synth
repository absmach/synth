// Class D board 1: Raspberry Pi Compute Module 4 industrial carrier.
// 12 V in -> 5 V (4 A) -> 3V3 / 1V8, CM4 200-pin interface, USB hub, GbE, HDMI,
// microSD, 2x 22-pin FFC, 40-pin GPIO, RTC. See README.md for what Synth does not check.
board "cm4_carrier" {
  // 6 layers: F/B signal, In1/In4 ground planes, In2/In3 signal. The CM4
  // DF40 is 0.4 mm pitch; two signal layers cannot escape it at the JLCPCB
  // filled-via floor.
  layers 6
  // JLCPCB's 6-layer filled-via process; the plain jlc-filled-via tier is
  // offered only on 2- and 4-layer builds.
  manufacturer "jlc-hdi"
  revision "A"
  requires via_in_pad

  stackup {
    copper 0.035mm
    insulator 0.2mm er 4.2 material "FR4"
    copper 0.035mm
    insulator 0.33mm er 4.2 material "FR4"
    copper 0.035mm
    insulator 0.33mm er 4.2 material "FR4"
    copper 0.035mm
    insulator 0.33mm er 4.2 material "FR4"
    copper 0.035mm
    insulator 0.2mm er 4.2 material "FR4"
    copper 0.035mm
  }

  netclass "PWR" { trace_width 0.5mm clearance 0.1mm }
  netclass "USB" { trace_width 0.2mm clearance 0.1mm }
  netclass "ETH" { trace_width 0.2mm clearance 0.1mm }
  netclass "HDMI" { trace_width 0.2mm clearance 0.1mm }
  netclass "SD" { trace_width 0.15mm clearance 0.1mm }
  netclass "CAM" { trace_width 0.15mm clearance 0.1mm }
  netclass "DSI" { trace_width 0.15mm clearance 0.1mm }
  netclass "I2C" { trace_width 0.15mm clearance 0.1mm }

  power "VIN_12V" 12v
  power "VIN_PROT" 12v
  power "+5V" 5v
  power "+5V_AUX" 5v
  power "+3V3" 3.3v
  power "+1V8" 1.8v
  power "RTC_VDD" 3v
  power "RTC_BAT" 3v
  power "CM4_3V3" 3.3v
  power "CM4_1V8" 1.8v

  sheet "Power" {
    group "12V INPUT" color "#c2410c" {
      component J1: connector "jst_b2b_xh_a_2pin" value "12V_IN" { placement_hint { edge: left priority: hard } }
      component F1: fuse "polyfuse_2r6a_16v" value "2.6A_PTC" 
      component Q1: transistor "p_mosfet_dmp3098l" value "DMP3098L" { placement_hint { near: "F1" priority: soft } }
      component R_G1: resistor "r_generic_0603" value "100k" { placement_hint { near: "Q1" priority: hard } }
      component D1: diode "smaj15a_tvs" value "SMAJ15A" { placement_hint { near: "Q1" priority: soft } }
      component C1: capacitor "c_electrolytic_smd_8x10" value "47uF" 
      component C2: capacitor "c_generic_1206" value "10uF" { placement_hint { near: "U1" priority: hard } }
      component C3: capacitor "c_generic_0603" value "220nF" { placement_hint { near: "U1" priority: hard } }
      notes "" {
        "J1 pin 1 is +12 V, pin 2 is GND."
        "F1 2.6 A hold PTC; Q1 DMP3098L reverse-polarity P-FET; D1 SMAJ15A clamps at 24.4 V, below the 38 V LMR33640 absolute maximum."
        "C1 47 uF bulk, C2 10 uF, C3 220 nF at the buck input."
      }
    }
    group "5V BUCK" color "#0072b2" {
      component L_FB1: inductor "ferrite_bead_0603" value "600R" { placement_hint { near: "U2" priority: soft } }
      component C_AUX: capacitor "c_generic_1206" value "10uF" { placement_hint { near: "L_FB1" priority: soft } }
      component U1: regulator "lmr33640" value "LMR33640" { placement_hint { near: "C2" priority: hard } }
      component R_UV_T: resistor "r_generic_0603" value "63.4k" { placement_hint { near: "U1" priority: soft } }
      component R_UV_B: resistor "r_generic_0603" value "10k" { placement_hint { near: "U1" priority: soft } }
      component C_VCC: capacitor "c_generic_0603" value "1uF" { placement_hint { near: "U1" priority: hard } }
      component C_BOOT: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "U1" priority: hard } }
      component L1: inductor "l_bourns_srn6045ta_6r8m" value "6.8uH" { placement_hint { near: "U1" priority: hard } }
      component C_OUT1: capacitor "c_generic_1206" value "22uF" { placement_hint { near: "L1" priority: hard } }
      component C_OUT2: capacitor "c_generic_1206" value "22uF" { placement_hint { near: "L1" priority: soft } }
      component C_OUT3: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "L1" priority: soft } }
      component R_FB_T: resistor "r_generic_0603" value "100k" { placement_hint { near: "U1" priority: hard } }
      component R_FB_B: resistor "r_generic_0603" value "24.9k" { placement_hint { near: "U1" priority: hard } }
      component C_FF: capacitor "c_generic_0603" value "100pF" { placement_hint { near: "U1" priority: soft } }
      component R_PG: resistor "r_generic_0603" value "100k" { placement_hint { near: "U1" priority: soft } }
      component D_PWR: led "ltst_c190kgkt" value "5V" 
      component R_PWR: resistor "r_generic_0603" value "470" { placement_hint { near: "D_PWR" priority: soft } }
      component TP_5V: testpoint "testpoint_pad_1_5" value "5V" 
      notes "" {
        "LMR33640 4 A, 400 kHz, 5.0 V out (100k / 24.9k, VREF 1.0 V)."
        "UVLO 9.0 V (63.4k / 10k). PG is open drain, pulled to +5V."
        "L1 6.8 uH; C_OUT 2x22 uF + 100 nF; C_FF 100 pF."
      }
    }
    group "3V3 BUCK" color "#0a7d4a" {
      component U2: regulator "lmr38010" value "LMR38010" { placement_hint { near: "C_IN2" priority: hard } }
      component C_IN2_1: capacitor "c_generic_1206" value "10uF" { placement_hint { near: "U2" priority: hard } }
      component C_IN2_2: capacitor "c_generic_0603" value "220nF" { placement_hint { near: "U2" priority: hard } }
      component R_RT2: resistor "r_generic_0603" value "33k" { placement_hint { near: "U2" priority: hard } }
      component C_BOOT2: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "U2" priority: hard } }
      component L2: inductor "l_bourns_srn6045ta_6r8m" value "6.8uH" { placement_hint { near: "U2" priority: hard } }
      component C_OUT4: capacitor "c_generic_1206" value "22uF" { placement_hint { near: "L2" priority: hard } }
      component C_OUT5: capacitor "c_generic_1206" value "22uF" { placement_hint { near: "L2" priority: soft } }
      component C_OUT6: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "L2" priority: soft } }
      component R_FB2_T: resistor "r_generic_0603" value "100k" { placement_hint { near: "U2" priority: hard } }
      component R_FB2_B: resistor "r_generic_0603" value "43.2k" { placement_hint { near: "U2" priority: hard } }
      component C_FF2: capacitor "c_generic_0603" value "56pF" { placement_hint { near: "U2" priority: soft } }
      component R_PG2: resistor "r_generic_0603" value "100k" { placement_hint { near: "U2" priority: soft } }
      component D_3V3: led "ltst_c190kgkt" value "3V3" 
      component R_3V3: resistor "r_generic_0603" value "470" { placement_hint { near: "D_3V3" priority: soft } }
      component TP_3V3: testpoint "testpoint_pad_1_5" value "3V3" 
      notes "" {
        "LMR38010 1 A, 3.3 V out (100k / 43.2k). EN = PG_5V."
        "L2 6.8 uH, 33k RT = 800 kHz. PG pulled to +3V3."
      }
    }
    group "1V8 BUCK" color "#7c3aed" {
      component U3: regulator "lmr38010" value "LMR38010" { placement_hint { near: "C_IN3" priority: hard } }
      component C_IN3_1: capacitor "c_generic_1206" value "10uF" { placement_hint { near: "U3" priority: hard } }
      component C_IN3_2: capacitor "c_generic_0603" value "220nF" { placement_hint { near: "U3" priority: hard } }
      component R_RT3: resistor "r_generic_0603" value "33k" { placement_hint { near: "U3" priority: hard } }
      component C_BOOT3: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "U3" priority: hard } }
      component L3: inductor "l_bourns_srn6045ta_6r8m" value "6.8uH" { placement_hint { near: "U3" priority: hard } }
      component C_OUT7: capacitor "c_generic_1206" value "22uF" { placement_hint { near: "L3" priority: hard } }
      component C_OUT8: capacitor "c_generic_1206" value "22uF" { placement_hint { near: "L3" priority: soft } }
      component C_OUT9: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "L3" priority: soft } }
      component R_FB3_T: resistor "r_generic_0603" value "100k" { placement_hint { near: "U3" priority: hard } }
      component R_FB3_B: resistor "r_generic_0603" value "125k" { placement_hint { near: "U3" priority: hard } }
      component C_FF3: capacitor "c_generic_0603" value "100pF" { placement_hint { near: "U3" priority: soft } }
      component R_PG3: resistor "r_generic_0603" value "100k" { placement_hint { near: "U3" priority: soft } }
      component TP_1V8: testpoint "testpoint_pad_1_5" value "1V8" 
      notes "" {
        "LMR38010 1 A, 1.8 V out (100k / 125k). EN = PG_3V3."
        "1V8 is the optional CM4 GPIO_VREF selection on J_VREF; default is +3V3."
      }
    }
  }
  sheet "CM4" {
    group "CM4 MODULE" color "#334155" {
      component J_CM4A: connector "hirose_df40c_100ds_0v4_51" value "CM4_A" {
        placement_hint { region: centre priority: hard }
        escape { method underpad layers "In2.Cu", "In3.Cu" }
      }
      component J_CM4B: connector "hirose_df40c_100ds_0v4_51_b" value "CM4_B" {
        placement_hint { region: centre priority: hard }
        escape { method underpad layers "In2.Cu", "In3.Cu" }
      }
      component TP_CM4_3V3: testpoint "testpoint_pad_1_5" value "CM4_3V3" 
      component TP_CM4_1V8: testpoint "testpoint_pad_1_5" value "CM4_1V8" 
      component TP_RUN_PG: testpoint "testpoint_pad_1_5" value "RUN_PG" 
      component TP_NEXTRST: testpoint "testpoint_pad_1_5" value "nEXTRST" 
      component TP_GLOBAL_EN: testpoint "testpoint_pad_1_5" value "GLOBAL_EN" 
      component TP_PG5V: testpoint "testpoint_pad_1_5" value "PG_5V" 
      component TP_PG3V3: testpoint "testpoint_pad_1_5" value "PG_3V3" 
      component TP_PG1V8: testpoint "testpoint_pad_1_5" value "PG_1V8" 
      component J_VREF: connector "header_1x3" value "VREF_SEL" { placement_hint { edge: bottom priority: soft } }
      component J_BOOT: connector "header_1x2" value "nRPIBOOT" { placement_hint { edge: bottom priority: soft } }
      component SW1: switch "spst_tactile" value "GLOBAL_EN" { placement_hint { edge: bottom priority: soft } }
      component C_GEN: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "SW1" priority: hard } }
      component R_GEN: resistor "r_generic_0603" value "100k" { placement_hint { near: "SW1" priority: soft } }
      component Q_LED: transistor "n_mosfet_2n7000" value "2N7000" 
      component R_LED_PWR: resistor "r_generic_0603" value "470" { placement_hint { near: "D_PWR_CM4" priority: soft } }
      component D_PWR_CM4: led "ltst_c190krkt" value "PWR" 
      component D_ACT: led "ltst_c190krkt" value "ACT" 
      component R_ACT: resistor "r_generic_0603" value "470" { placement_hint { near: "D_ACT" priority: soft } }
      component D_ETH: led "ltst_c190kgkt" value "ETH_ACT" 
      component R_ETH: resistor "r_generic_0603" value "470" { placement_hint { near: "D_ETH" priority: soft } }
      component D_ETH2: led "led_amber_0603" value "ETH_SPD" 
      component R_ETH2: resistor "r_generic_0603" value "470" { placement_hint { near: "D_ETH2" priority: soft } }
      notes "" {
        "J_CM4A is CM4 pins 1-100; J_CM4B is CM4 pins 101-200. Pin pN on each is pad N."
        "J_VREF: 1-2 = 3.3 V GPIO (default), 2-3 = 1.8 V GPIO."
        "J_BOOT shorts nRPIBOOT to GND for USB boot. SW1 pulls GLOBAL_EN low."
        "CM4_3.3V and CM4_1.8V are module outputs and are brought to test points only."
        "NC (no net): 16,18,19,20,64,68,70,72,73,76,89,91,94,96,102,104,106,109,110,111,112."
        "NC (no net): 115,116,117,118,121,122,123,124,127,129,133,135,139,141 (CAM1, PCIe RX/TX)."
        "NC (no net): 143,145,146,147,148,149,152,154,158,160,164,166 (HDMI1)."
        "NC (no net): 175,177,181,183,187,189,193,194,195,196 (DSI1)."
      }
    }
    group "MECHANICAL" color "#475569" {
      component H1: mounting_hole "mounting_hole_m2_5" value "M2.5" { placement_hint { region: top_left priority: hard } }
      component H2: mounting_hole "mounting_hole_m2_5" value "M2.5" { placement_hint { region: top_right priority: hard } }
      component H3: mounting_hole "mounting_hole_m2_5" value "M2.5" { placement_hint { region: bottom_left priority: hard } }
      component H4: mounting_hole "mounting_hole_m2_5" value "M2.5" { placement_hint { region: bottom_right priority: hard } }
      notes "" {
        "Four M2.5 NPTH mounting holes, one per corner."
      }
    }
  }
  sheet "Interfaces" {
    group "USB HUB" color "#be123c" {
      component U4: ic "usb2514b" value "USB2514B" { placement_hint { region: centre priority: soft } }
      component Y1: crystal "xtal_24mhz_3225" value "24MHz" { placement_hint { near: "U4" priority: hard } }
      component C_X1: capacitor "c_generic_0603" value "18pF" { placement_hint { near: "Y1" priority: hard } }
      component C_X2: capacitor "c_generic_0603" value "18pF" { placement_hint { near: "Y1" priority: hard } }
      component R_RBIAS: resistor "r_generic_0603" value "12k" { placement_hint { near: "U4" priority: hard } }
      component C_HUB1: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "U4" priority: hard } }
      component C_HUB2: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "U4" priority: hard } }
      component C_HUB3: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "U4" priority: hard } }
      component C_HUB4: capacitor "c_generic_1206" value "10uF" { placement_hint { near: "U4" priority: hard } }
      component C_CRFILT: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "U4" priority: hard } }
      component C_PLLFILT: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "U4" priority: hard } }
      component R_CFG0: resistor "r_generic_0603" value "10k" { placement_hint { near: "U4" priority: soft } }
      component R_CFG1: resistor "r_generic_0603" value "10k" { placement_hint { near: "U4" priority: soft } }
      component R_LOCAL: resistor "r_generic_0603" value "10k" { placement_hint { near: "U4" priority: soft } }
      component R_OCS1: resistor "r_generic_0603" value "10k" { placement_hint { near: "U4" priority: soft } }
      component R_OCS2: resistor "r_generic_0603" value "10k" { placement_hint { near: "U4" priority: soft } }
      component R_OCS3: resistor "r_generic_0603" value "10k" { placement_hint { near: "U4" priority: soft } }
      component R_OCS4: resistor "r_generic_0603" value "10k" { placement_hint { near: "U4" priority: soft } }
      component R_RESET: resistor "r_generic_0603" value "10k" { placement_hint { near: "U4" priority: soft } }
      component C_RESET: capacitor "c_generic_0603" value "1uF" { placement_hint { near: "U4" priority: soft } }
      component R_VBUS: resistor "r_generic_0603" value "10k" { placement_hint { near: "U4" priority: soft } }
      component U5: regulator "tps22918_sot23_6" value "USB1_PWR" 
      component U6: regulator "tps22918_sot23_6" value "USB2_PWR" 
      component U7: regulator "tps22918_sot23_6" value "USB3_PWR" 
      component U8: regulator "tps22918_sot23_6" value "USB4_PWR" 
      component C_USB1: capacitor "c_generic_0805" value "1uF" 
      component C_USB2: capacitor "c_generic_0805" value "1uF" 
      component C_USB3: capacitor "c_generic_0805" value "1uF" 
      component C_USB4: capacitor "c_generic_0805" value "1uF" 
      component C_USB1B: capacitor "c_generic_0603" value "100nF" 
      component C_USB2B: capacitor "c_generic_0603" value "100nF" 
      component C_USB3B: capacitor "c_generic_0603" value "100nF" 
      component C_USB4B: capacitor "c_generic_0603" value "100nF" 
      component C_CT1: capacitor "c_generic_0603" value "1nF" 
      component C_CT2: capacitor "c_generic_0603" value "1nF" 
      component C_CT3: capacitor "c_generic_0603" value "1nF" 
      component C_CT4: capacitor "c_generic_0603" value "1nF" 
      component D_USB1: diode "prtr5v0u2x" value "TVS" 
      component D_USB2: diode "prtr5v0u2x" value "TVS" 
      component D_USB3: diode "prtr5v0u2x" value "TVS" 
      component D_USB4: diode "prtr5v0u2x" value "TVS" 
      component D_USB_UP: diode "prtr5v0u2x" value "TVS" 
      component J_USB1: connector "usb_a_stacked_cui_uj2_adh_th" value "USB1_2" { placement_hint { edge: right priority: hard } }
      component J_USB2: connector "usb_a_stacked_cui_uj2_adh_th" value "USB3_4" { placement_hint { edge: right priority: hard } }
      notes "" {
        "USB2514B self-powered, CFG_SEL=00, individual port power and over-current."
        "One TPS22918 per port (500 mA port limit), one PRTR5V0U2X per port."
        "24 MHz crystal, 12k RBIAS, 100 nF CRFILT/PLLFILT."
        "PRTPWR1-4 drive the TPS22918 ON pins; OCS_N1-4 are tied high (no over-current sensor)."
      }
    }
    group "ETHERNET" color "#0d9488" {
      component J_ETH: connector "rj45_ude_rb1_125b8g1a" value "GbE" { placement_hint { edge: right priority: hard } }
      component C_TCT: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "J_ETH" priority: hard } }
      component D_ETH_ESD1: diode "prtr5v0u2x" value "TVS" 
      component D_ETH_ESD2: diode "prtr5v0u2x" value "TVS" 
      component D_ETH_ESD3: diode "prtr5v0u2x" value "TVS" 
      component D_ETH_ESD4: diode "prtr5v0u2x" value "TVS" 
      notes "" {
        "Pulse JXD6-0001NL GbE magjack, 1:1. TCT/RCT to GND through 100 nF (CM4IO reference)."
        "Four 100 ohm pairs; ESD on each pair."
      }
    }
    group "HDMI" color "#9333ea" {
      component J_HDMI: connector "hdmi_a_receptacle" value "HDMI0" { placement_hint { edge: right priority: hard } }
      component U9: level_shifter "txs0108e" value "TXS0108E" { placement_hint { near: "J_HDMI" priority: soft } }
      component D_HDMI1: diode "prtr5v0u2x" value "TVS" 
      component D_HDMI2: diode "prtr5v0u2x" value "TVS" 
      component D_HDMI3: diode "prtr5v0u2x" value "TVS" 
      component D_HDMI4: diode "prtr5v0u2x" value "TVS" 
      component D_HDMI5: diode "prtr5v0u2x" value "TVS" 
      component U10: regulator "tps22918_sot23_6" value "HDMI_5V" 
      component C_HDMI1: capacitor "c_generic_0805" value "1uF" 
      component C_HDMI2: capacitor "c_generic_0603" value "100nF" 
      component C_HDMI_CT: capacitor "c_generic_0603" value "1nF" 
      component R_HDMI_SDA: resistor "r_generic_0603" value "2.2k" 
      component R_HDMI_SCL: resistor "r_generic_0603" value "2.2k" 
      component R_HDMI_SDA_MCU: resistor "r_generic_0603" value "2.2k" 
      component R_HDMI_SCL_MCU: resistor "r_generic_0603" value "2.2k" 
      component R_OE: resistor "r_generic_0603" value "10k" 
      component C_HDMI_VCCA: capacitor "c_generic_0603" value "100nF" 
      component C_HDMI_VCCB: capacitor "c_generic_0603" value "100nF" 
      notes "" {
        "HDMI0 only; TMDS pairs, CEC, HPD and DDC."
        "TXS0108E shifts DDC between 3.3 V and 5 V; 2.2k pull-ups on the connector side."
        "U10 current-limits the HDMI +5V; 1 uF + 100 nF."
      }
    }
  }
  sheet "Peripherals" {
    group "MICROSD" color "#b45309" {
      component J_SD: connector "microsd_molex_47219_2001" value "microSD" { placement_hint { edge: left priority: hard } }
      component U11: regulator "tps22918_sot23_6" value "SD_PWR" 
      component C_SD1: capacitor "c_generic_1206" value "10uF" 
      component C_SD_IN: capacitor "c_generic_0603" value "100nF" 
      component C_SD2: capacitor "c_generic_0603" value "100nF" 
      component C_SD_CT: capacitor "c_generic_0603" value "1nF" 
      component R_SD_CMD: resistor "r_generic_0603" value "10k" 
      component R_SD_DAT0: resistor "r_generic_0603" value "10k" 
      component R_SD_DAT1: resistor "r_generic_0603" value "10k" 
      component R_SD_DAT2: resistor "r_generic_0603" value "10k" 
      component R_SD_DAT3: resistor "r_generic_0603" value "10k" 
      component R_SD_PWR: resistor "r_generic_0603" value "100k" 
      component D_SD1: diode "prtr5v0u2x" value "TVS" 
      component D_SD2: diode "prtr5v0u2x" value "TVS" 
      component D_SD3: diode "prtr5v0u2x" value "TVS" 
      notes "" {
        "CM4 Lite SD interface, 4-bit. U11 switches SD_VDD from SD_PWR_ON."
        "10k pull-ups on CMD and DAT0-3; ESD on all six lines."
      }
    }
    group "CAMERA / DSI" color "#4d7c0f" {
      component J_CAM: connector "ffc_22p_hirose_fh12_22s_0_5sh" value "CSI0" { placement_hint { edge: left priority: hard } }
      component J_DSI: connector "ffc_22p_hirose_fh12_22s_0_5sh" value "DSI0" { placement_hint { edge: left priority: hard } }
      component C_CAM: capacitor "c_generic_0603" value "100nF" 
      component C_DSI: capacitor "c_generic_0603" value "100nF" 
      notes "" {
        "22-pin FFC: CAM0 (2 lanes) and DSI0 (2 lanes)."
        "SCL0/SDA0 shared with the RTC; CAM_GPIO drives camera power enable."
        "D2/D3 lanes are not connected on these 2-lane ports."
      }
    }
    group "GPIO HEADER" color "#475569" {
      component J_GPIO1: connector "header_1x20" value "GPIO_ODD" { placement_hint { edge: top priority: hard } }
      component J_GPIO2: connector "header_1x20" value "GPIO_EVEN" { placement_hint { edge: top priority: hard } }
      notes "" {
        "2x20 Raspberry Pi header pinout. J_GPIO1 is the odd pins, J_GPIO2 the even pins."
        "All 28 CM4 GPIOs are brought out; GPIO26 also carries the RTC interrupt."
      }
    }
    group "RTC" color "#a16207" {
      component U12: ic "pcf85063atl" value "PCF85063A" 
      component Y2: crystal "xtal_32k768_3215" value "32.768kHz" 
      component J_BT1: connector "coin_cell_keystone_1058" value "CR2032" 
      component D_RTC1: diode "d_schottky" value "3V3" 
      component D_RTC2: diode "d_schottky" value "BAT" 
      component C_RTC: capacitor "c_generic_0603" value "100nF" 
      component R_RTC_SDA: resistor "r_generic_0603" value "10k" 
      component R_RTC_SCL: resistor "r_generic_0603" value "10k" 
      component R_RTC_INT: resistor "r_generic_0603" value "10k" 
      notes "" {
        "PCF85063ATL with 32.768 kHz crystal; VDD is diode-ORed from +3V3 and the CR2032."
        "I2C on SCL0/SDA0; INT on GPIO26. CLKOE tied low to save power."
      }
    }
    group "FAN" color "#64748b" {
      component J_FAN: connector "header_1x2" value "FAN" { placement_hint { edge: top priority: soft } }
      component D_FAN: diode "d_schottky" value "FLYBACK" 
      notes "" {
        "2-pin +5 V fan header with a Schottky flyback diode. Always on."
      }
    }
  }

