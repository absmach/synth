// Class A, positive 2 of 3 — #39 case "I2C/SPI sensor board with regulator,
// decoupling, pull-ups, and external connector"
//
// A field sensor node: JST-fed 5 V into a low-noise 3V3 LDO, an STM32G030
// reading two I2C devices (environmental sensor and a config EEPROM), with a
// 4-pin JST break-out for the host UART. One I2C bus, one set of pull-ups.
board "a2_i2c_sensor_node" {
    layers 2
    manufacturer "jlcpcb"

    group "POWER" color "#c2410c" {
      component J1: connector "jst_ph_2pin"
      component F1: fuse      "polyfuse" value "500mA"
      component D1: diode     "d_schottky" value "SS14"
      component U1: regulator "ams1117_3v3" value "AMS1117-3.3"
      component C1: capacitor "c_generic_0805" value "10uF"
      component C2: capacitor "c_generic_0603" value "1uF"
      notes "" {
        "Polyfuse then series Schottky: resettable over-current plus reverse-polarity."
        "AMS1117 sized for the ~400 mA budget: MCU, two I2C devices and the breakout."
      }
    }

    connect J1.p1 -> F1.p1
    connect F1.p2 -> D1.anode
    connect D1.cathode -> U1.vin
    connect J1.p2 -> U1.gnd
    connect U1.vin  -> C1.p1
    connect U1.gnd  -> C1.p2
    connect U1.vout -> C2.p1
    connect U1.gnd  -> C2.p2

    group "MCU" color "#0072b2" {
      component U2: mcu       "stm32g030"
      component C3: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "U2" priority: hard } }
      component R1: resistor  "r_generic_0603" value "10k"   { placement_hint { near: "U2" priority: hard } }
      component C4: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "U2" priority: hard } }
    }

    connect U1.vout -> U2.vdd
    connect U1.gnd  -> U2.vss
    connect U2.vdd  -> C3.p1
    connect U2.vss  -> C3.p2
    connect U1.vout -> R1.p1
    connect R1.p2   -> U2.nrst
    connect U2.nrst -> C4.p1
    connect U2.vss  -> C4.p2

    group "I2C BUS" color "#0a7d4a" {
      component U3: sensor    "bme680_env"
      component U4: memory    "24lc256_eeprom"
      component R2: resistor  "r_generic_0603" value "4.7k"
      component R3: resistor  "r_generic_0603" value "4.7k"
      component C5: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "U3" priority: hard } }
      component C6: capacitor "c_generic_0603" value "100nF" { placement_hint { near: "U4" priority: hard } }
      notes "" {
        "One bus, one pair of 4.7k pull-ups sized for 400 kHz at 3V3."
        "BME680 at 0x76: CSB high selects I2C, SDO low selects the low address."
      }
    }

    connect U1.vout -> U3.vdd
    connect U1.gnd  -> U3.gnd
    connect U3.vdd  -> C5.p1
    connect U3.gnd  -> C5.p2
    connect U3.csb  -> U1.vout
    connect U3.sdo  -> U1.gnd

    connect U1.vout -> U4.vdd
    connect U1.gnd  -> U4.gnd
    connect U4.vdd  -> C6.p1
    connect U4.gnd  -> C6.p2

    connect U2.pa10 -> U3.sda
    connect U2.pa10 -> U4.sda
    connect U2.pa9  -> U3.scl
    connect U2.pa9  -> U4.scl
    connect U2.pa10 -> R2.p1
    connect R2.p2   -> U1.vout
    connect U2.pa9  -> R3.p1
    connect R3.p2   -> U1.vout

    group "HOST BREAKOUT" color "#b45309" {
      component J2: connector "jst_ph_4pin"
      component D2: diode     "esd_usb"
      component D3: diode     "esd_usb"
      notes "" {
        "3V3 / TX / RX / GND in pin order. One ESD clamp per exposed line,"
        "referenced to ground rather than to the rail."
      }
    }

    connect U1.vout -> J2.p1
    connect U2.pa2  -> J2.p2
    connect U2.pa3  -> J2.p3
    connect U1.gnd  -> J2.p4
    connect J2.p2   -> D2.io
    connect U1.gnd  -> D2.gnd
    connect J2.p3   -> D3.io
    connect U1.gnd  -> D3.gnd
  }
