	(text
		"LP5907-3.3: 2.2 uF ceramic in and out."
		(at 190.5 64.07 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "a0b14eea-94cb-5fbd-aed5-292f061420f7")
	)
	(text
		"(datasheet minimum is 1 uF)."
		(at 190.5 66.61 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "b6bdea1d-b3fa-5556-b495-96efe43c108d")
	)
	(text
		"EN tied to VIN, always on."
		(at 190.5 69.15 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "04d85eb6-e6b7-566f-9908-e8678d651d20")
	)
	(text
		""
		(at 233.68 113.41 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "dac23a95-8b5b-513c-b7ef-46a5d7f0c9de")
	)
	(text
		"VDD5 <- VBUS (100nF C4), V3 <- 100nF only (C5), VIO <- VIO net (100nF C6)."
		(at 233.68 117.41 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "286eeaf0-2585-5039-ab29-16581f885392")
	)
	(text
		"VBUS pin <- VBUS net. RST left NC (internal pull-up). EP (pin 25) to GND."
		(at 233.68 119.95 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "e3fef91f-f013-5278-9dd3-7cc28b982639")
	)
	(text
		"R8 10k pulls the unused modem inputs RI0/RI1/DCD0/DCD1/DSR0/DSR1 to VIO (inactive)."
		(at 233.68 122.49 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "ef18a913-cc9f-52fc-b6da-207e472d5334")
	)
	(text
		"R9 10k holds CTS0 low (always clear to send) so UART0 flow control cannot stall."
		(at 233.68 125.03 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "0f1c8817-1de3-5e26-a6dd-44aff9887e90")
	)
	(text
		""
		(at 339.09 39.75 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "7104edf4-1ac9-5126-94db-64218f795002")
	)
	(text
		"p1=+3V3, p2=VIO, p3=VBUS."
		(at 339.09 43.75 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "eae96eb5-9384-5b8d-aed9-51e13a513e6b")
	)
	(text
		"Jumper 1-2: 3.3 V. Jumper 2-3: 5 V."
		(at 339.09 46.29 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "246568da-2e33-5453-84df-9f93d0396d25")
	)
	(text
		"No jumper: VIO off, bridge in reset."
		(at 339.09 48.83 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "c6b7d02b-1433-5ec8-96af-ce8d3a06d4ca")
	)
	(text
		"Do not wire anything to pin 2."
		(at 339.09 51.37 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "0019f599-9088-5050-a057-362b9f41bc83")
	)
	(text
		""
		(at 411.48 75.31 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "a5cd1c3d-a89e-50ad-87ce-5b8ffdfbe438")
	)
	(text
		"J2: GND, TXD1, RXD1 (pin 1 is GND)."
		(at 411.48 79.31 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "39bfc9a4-4b78-5b83-8949-d662a846cb02")
	)
	(text
		"J3: DTR1, RTS1, CTS1."
		(at 411.48 81.85 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "2ff6ad11-8c31-5523-8917-584ac116c961")
	)
	(text
		"R5 1k series on RXD1, R6 1k on CTS1."
		(at 411.48 84.39 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "4bb8120c-8b42-55ba-887c-e0c1b211f8f0")
	)
	(text
		""
		(at 468.63 110.87 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "480d7cef-1ee5-5d94-8ebb-2debcb693da3")
	)
	(text
		"DI <- TXD0, RO -> RXD0. DE//RE tied together and driven by DTR0/TNOW0."
		(at 468.63 114.87 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "97e8fe4b-9058-550d-b0ee-baf4c6352ca8")
	)
	(text
		"R_TNOW 4.7k to GND on TNOW0 (auto-direction config). VCC <- VIO (100nF C7)."
		(at 468.63 117.41 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "e8af1fa5-e4f5-5ac7-9537-7c03ab138fdd")
	)
	(text
		"J4: A, B, GND. UART0 TTL is not broken out."
		(at 468.63 119.95 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "3f1f13c1-e9a4-598b-b867-4a995129126f")
	)
	(text
		"R_TERM 120 ohm 1% across the bus lines through J_TERM: fit the jumper only at an end of the bus."
		(at 468.63 122.49 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "398b693d-cb74-5c38-b993-30b710df5181")
	)
	(text
		"R_A/R_B 10 ohm in series and D8 (SM712 class) on the bus side follow TI's 1 kV surge circuit (SLLSEY3E fig. 37). Not surge-tested; R_A/R_B are generic 0603, TI lists pulse-proof parts."
		(at 468.63 125.03 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "f49d3eae-d3d6-593f-85ae-2ef7a2a0237c")
	)
	(text
		""
		(at 30.48 175.64 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "cc0dac4a-2d8e-5426-a90b-0fc0564d98d4")
	)
	(text
		"D3 green LED from VIO (VIO present)."
		(at 30.48 179.64 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "c41ddfeb-7bb3-514e-b663-e7d20e4ca2d1")
	)
	(text
		"D4/D7 red LEDs from TXD0/TXD1."
		(at 30.48 182.18 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "4d114f8b-5040-53ba-af90-e8474ccef1ec")
	)
	(text
		"No ACT# LED: the CH342F QFN24 has no ACT# bond-out."
		(at 30.48 184.72 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "ca247229-36e6-5dbc-8a59-7790614c9e7e")
	)
