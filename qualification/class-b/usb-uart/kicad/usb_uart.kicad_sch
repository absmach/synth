	(text
		""
		(at 17.28 109.11 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "5dde40d0-20fc-56ac-8a98-0263ecf5eaa1")
	)
	(text
		"USB 2.0 device port, VBUS 5 V in. D+/D- go straight to U1 (no series R)."
		(at 17.28 113.11 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "913d33db-1250-52bf-8af6-4e5dac4710bf")
	)
	(text
		"CC1/CC2 5.1k Rd to GND so a USB-C host sources 5 V."
		(at 17.28 115.65 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "f6a49b33-3435-5477-869d-7bcf05cda32b")
	)
	(text
		""
		(at 17.66 237.38 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "0428a07c-da10-5007-80cb-990a705d084f")
	)
	(text
		"PRTR5V0U2X rail-to-rail clamp on D+/D- (VCC pin on VBUS)."
		(at 17.66 241.38 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "b148a4f0-4960-53ae-aa6d-44300ea51649")
	)
	(text
		"PTVS6V0S1UR on VBUS, CC1 and CC2, close to the connector."
		(at 17.66 243.92 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "3e30bb9b-9e70-5562-b9e9-4b717dad5200")
	)
	(text
		""
		(at 130.38 62.12 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "21a7fca0-18a6-51c6-a658-4de758aaa522")
	)
	(text
		"LP5907-3.3: 2.2 uF ceramic in and out."
		(at 130.38 66.12 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "a0b14eea-94cb-5fbd-aed5-292f061420f7")
	)
	(text
		"(datasheet minimum is 1 uF)."
		(at 130.38 68.66 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "b6bdea1d-b3fa-5556-b495-96efe43c108d")
	)
	(text
		"EN tied to VIN, always on."
		(at 130.38 71.2 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "04d85eb6-e6b7-566f-9908-e8678d651d20")
	)
	(text
		""
		(at 196.28 102.76 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "dac23a95-8b5b-513c-b7ef-46a5d7f0c9de")
	)
	(text
		"VDD5 <- VBUS (100nF C4), V3 <- 100nF only (C5), VIO <- VIO net (100nF C6)."
		(at 196.28 106.76 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "286eeaf0-2585-5039-ab29-16581f885392")
	)
	(text
		"VBUS pin <- VBUS net. RST left NC (internal pull-up). EP (pin 25) to GND."
		(at 196.28 109.3 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "e3fef91f-f013-5278-9dd3-7cc28b982639")
	)
	(text
		"R8 10k pulls the unused modem inputs RI0/RI1/DCD0/DCD1/DSR0/DSR1 to VIO (inactive)."
		(at 196.28 111.84 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "ef18a913-cc9f-52fc-b6da-207e472d5334")
	)
	(text
		"R9 10k holds CTS0 low (always clear to send) so UART0 flow control cannot stall."
		(at 196.28 114.38 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "0f1c8817-1de3-5e26-a6dd-44aff9887e90")
	)
	(text
		""
		(at 130.38 130.7 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "7104edf4-1ac9-5126-94db-64218f795002")
	)
	(text
		"p1=+3V3, p2=VIO, p3=VBUS."
		(at 130.38 134.7 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "eae96eb5-9384-5b8d-aed9-51e13a513e6b")
	)
	(text
		"Jumper 1-2: 3.3 V. Jumper 2-3: 5 V."
		(at 130.38 137.24 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "246568da-2e33-5453-84df-9f93d0396d25")
	)
	(text
		"No jumper: VIO off, bridge in reset."
		(at 130.38 139.78 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "c6b7d02b-1433-5ec8-96af-ce8d3a06d4ca")
	)
	(text
		"Do not wire anything to pin 2."
		(at 130.38 142.32 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "0019f599-9088-5050-a057-362b9f41bc83")
	)
	(text
		""
		(at 130.83 227.22 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "a5cd1c3d-a89e-50ad-87ce-5b8ffdfbe438")
	)
	(text
		"J2: GND, TXD1, RXD1 (pin 1 is GND)."
		(at 130.83 231.22 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "39bfc9a4-4b78-5b83-8949-d662a846cb02")
	)
	(text
		"J3: DTR1, RTS1, CTS1."
		(at 130.83 233.76 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "2ff6ad11-8c31-5523-8917-584ac116c961")
	)
	(text
		"R5 1k series on RXD1, R6 1k on CTS1."
		(at 130.83 236.3 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "4bb8120c-8b42-55ba-887c-e0c1b211f8f0")
	)
	(text
		""
		(at 217.12 234.84 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "480d7cef-1ee5-5d94-8ebb-2debcb693da3")
	)
	(text
		"DI <- TXD0, RO -> RXD0. DE//RE tied together and driven by DTR0/TNOW0."
		(at 217.12 238.84 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "97e8fe4b-9058-550d-b0ee-baf4c6352ca8")
	)
	(text
		"R_TNOW 4.7k to GND on TNOW0 (auto-direction config). VCC <- VIO (100nF C7)."
		(at 217.12 241.38 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "e8af1fa5-e4f5-5ac7-9537-7c03ab138fdd")
	)
	(text
		"J4: A, B, GND. R_TERM 120 ohm 1% across A/B. UART0 TTL is not broken out."
		(at 217.12 243.92 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "fc6caf0c-f918-597c-96c8-e95e51662969")
	)
	(text
		""
		(at 335.98 145.94 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "3f3b81cb-1dc5-5ef6-9cf1-b0798a7b31b9")
	)
	(text
		"D3 green LED from VIO (VIO present)."
		(at 335.98 149.94 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "8c09f6f9-aa99-51e2-aca1-876885dcae17")
	)
	(text
		"D4/D7 red LEDs from TXD0/TXD1."
		(at 335.98 152.48 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "475a8114-b323-56a0-afee-b97d71d2d601")
	)
	(text
		"No ACT# LED: the CH342F QFN24 has no ACT# bond-out."
		(at 335.98 155.02 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "41a56963-c1e9-5d39-9f2b-b763977844df")
	)
