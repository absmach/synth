// SYN-67: 24 V in, 3.3 V out buck (TI LMR38010) with input parts (PTC, reverse-block diode, TVS).
// Intended for 24 V +10% in and 1 A out.
//
// Input chain: J1 -> F1 (PTC) -> D1 (Schottky reverse block) -> VIN node.
// VIN node: D2 (TVS), C1 (bulk), C2, C10, C11 (3 x 10 uF), C3 (220 nF, on the VIN pin), U1 VIN, R_UV_T.
// LMR38010: 4.2-80 V input (85 V absolute maximum), 1 A, 800 kHz set by RT, internal compensation, exposed thermal pad, open-drain PG.
// The SMBJ30A (VBR 33.3-36.8 V, clamp 48.4 V) clamps surges at the VIN node; its clamp is below U1's 85 V absolute maximum.
// Feedback divider is tapped from the output node (L1.p2), never from SW.
board "buck" {
  layers 4
  manufacturer "jlc-filled-via"
  revision "A"

  netclass "PWR" {
    trace_width 0.5mm
    clearance 0.2mm
  }

  power "VIN" 24v
  power "+3V3" 3.3v

  group "INPUT PROTECTION" color "#c2410c" {
    component J1: connector "jst_b2b_xh_a_2pin" value "24V_IN" { placement_hint { region: left_edge edge: left priority: hard } }
    component F1: fuse "mf_msmf110_33x" value "1.1A_PTC"
    component D1: diode "ss36" value "SS36"
    component D2: diode "smbj30a" value "SMBJ30A"
    notes "" {
      "J1 pin 1 is +24 V, pin 2 is GND."
      "F1 resettable PTC: Ihold 1.1 A, Vmax 33 V."
      "D1 Schottky in series blocks reverse polarity."
      "D2 TVS (30 V standoff) sits after D1, directly on the VIN node. Its 48.4 V clamp is below U1's 85 V absolute maximum, so U1 stays within its rating under a surge the TVS can absorb."
    }
  }

  group "INPUT FILTER" color "#7c3aed" {
    component C1: capacitor "c_electrolytic_smd_8x10" value "47uF" voltage "50V"
    component C2: capacitor "c_samsung_cl31b106kbhnnne" value "10uF" dielectric "X7R" voltage "50V"
    component C10: capacitor "c_samsung_cl31b106kbhnnne" value "10uF" dielectric "X7R" voltage "50V"
    component C11: capacitor "c_samsung_cl31b106kbhnnne" value "10uF" dielectric "X7R" voltage "50V"
    component C3: capacitor "c_generic_0603" value "220nF" dielectric "X7R" voltage "50V"
    notes "" {
      "C1 bulk, C2, C10 and C11 ceramic, C3 high-frequency next to the VIN pin (LMR38010 section 9.2.2.6: at least 4.7 uF + 100 to 220 nF)."
      "C2, C10 and C11 are three 10 uF 50 V X7R in parallel, about 2 uF each at 24 V bias (Samsung library data-sheet plot, approximate), about 6 uF effective, against the datasheet minimum of 4.7 uF (LMR38010 section 9.2.2.6)."
      "50 V parts for a 24 V rail."
    }
  }

  group "UVLO" color "#0a7d4a" {
    component R_UV_T: resistor "r_generic_0603" value "1.37M" tolerance "1%"
    component R_UV_B: resistor "r_generic_0603" value "100k" tolerance "1%"
    notes "" {
      "EN divider from VIN. LMR38010 VEN-H 1.25 V typical (1.1 to 1.4), VEN-L 1.10 V typical: start 18.4 V (16.2 to 20.6 V), stop 16.2 V."
      "EN stays under 2 V at a 28 V input (EN absolute maximum is VIN + 0.3 V)."
    }
  }

  group "BUCK" color "#0072b2" {
    component U1: regulator "lmr38010"
    component C4: capacitor "c_generic_0603" value "100nF" dielectric "X7R" voltage "16V"
    component R_RT: resistor "r_generic_0603" value "33k" tolerance "1%"
    component L1: inductor "l_bourns_srn6045ta_6r8m" value "6.8uH"
    component C5: capacitor "c_samsung_cl31a226kahnnne" value "22uF" dielectric "X5R" voltage "25V"
    component C6: capacitor "c_samsung_cl31a226kahnnne" value "22uF" dielectric "X5R" voltage "25V"
    component C9: capacitor "c_samsung_cl31a226kahnnne" value "22uF" dielectric "X5R" voltage "25V"
    notes "" {
      "LMR38010SDDAR: internal compensation, exposed pad (pin 9) on GND, open-drain PG, PFM with spread spectrum."
      "R_RT 33k from RT/SYNC to GND sets 800 kHz (RT table under datasheet Figure 8-4); the pin must not float."
      "C4 100 nF boot capacitor between BOOT and SW."
      "L1 6.8 uH at 800 kHz gives about 0.5 A ripple at 26.4 V in (datasheet Eq 10 K about 0.5), above the 1.03 uH minimum of Eq 11 (0.25 x 3.3 V / 800 kHz); 3x 22 uF is unverified: Table 9-1 has no 3.3 V row."
      "The exposed pad (pin 9) is soldered to the F.Cu GND pour and carries six GND vias in the pad"
      "(2 x 3, 0.6 mm pad, 0.3 mm drill, the board's fabrication floor; the 0.2 mm of the KiCad thermal-via footprint is below it)."
      "The pad needs the filled-via process, declared by requires via_in_pad."
    }
  }

  group "FEEDBACK" color "#b45309" {
    component R_FB_T: resistor "r_generic_0603" value "100k" tolerance "1%"
    component R_FB_B: resistor "r_generic_0603" value "43.2k" tolerance "1%"
    component C7: capacitor "c_generic_0603" value "56pF" dielectric "C0G" voltage "50V"
    notes "" {
      "Vout = 1.0 V x (1 + 100k / 43.2k) = 3.31 V."
      "Divider taps the output node on the far side of L1, not SW."
      "C7 56 pF feed-forward across the upper resistor (datasheet Eq 9 gives about 60 pF)."
    }
  }

  group "POWER GOOD" color "#4d7c0f" {
    component R_PG: resistor "r_generic_0603" value "100k"
    component D4: led "ltst_c190kgkt" value "PG FAULT"
    component R_PGLED: resistor "r_generic_0603" value "470"
    notes "" {
      "PG is open drain and pulled up to +3V3 through 100k (datasheet 8.3.5: pull up through a resistor; PG tolerates 20 V)."
      "PG goes low during start-up and on a fault, so J2 pin 3 reads valid only after the 4 ms start-up delay."
      "D4 green fault LED from +3V3 through R_PGLED to PG: it is lit while PG is low, dark while power is good."
      "About 2.5 mA when lit (470 R, Vf about 2.1 V); U1's PG pull-down is about 92 ohm RDSON, so PG stays near 0.4 V."
    }
  }

  group "OUTPUT" color "#be123c" {
    component J2: connector "jst_b4b_xh_a_4pin" value "3V3_OUT" { placement_hint { region: right_edge edge: right priority: hard } }
    component D3: led "ltst_c190kgkt" value "PWR"
    component R_LED: resistor "r_generic_0603" value "470"
    notes "" {
      "J2 pin 1 is +3.3 V, pin 2 GND, pin 3 power-good (3.3 V logic, 100k pull-up), pin 4 GND."
      "D3 green power LED from the 3.3 V rail."
    }
  }

  group "MECHANICAL" color "#475569" {
    component H1: mounting_hole "mounting_hole_m2_5" value "M2.5"
    component H2: mounting_hole "mounting_hole_m2_5" value "M2.5"
    notes "" {
      "Two M2.5 non-plated holes, H1 in the top middle and H2 at the right edge below J2; the board is fixed down through them."
    }
  }

  net "VIN_RAW" class "PWR" {
    J1.p1, F1.p1
  }

  net "VIN_FUSED" class "PWR" {
    F1.p2, D1.anode
  }

  net "VIN" class "PWR" {
    D1.cathode, D2.cathode,
    C1.p1, C2.p1, C10.p1, C11.p1, C3.p1,
    U1.vin, R_UV_T.p1
  }

  net "GND" class "PWR" {
    J1.p2, D2.anode,
    C1.p2, C2.p2, C10.p2, C11.p2, C3.p2,
    U1.gnd, U1.pad, R_UV_B.p2,
    C5.p2, C6.p2, C9.p2, R_FB_B.p2, R_RT.p2,
    J2.p2, J2.p4, D3.cathode
  }

  net "SW" class "PWR" {
    U1.sw, L1.p1, C4.p2
  }

  net "+3V3" class "PWR" {
    L1.p2, C5.p1, C6.p1, C9.p1,
    R_FB_T.p1, J2.p1, R_LED.p1, R_PG.p2, R_PGLED.p1
  }

  net "PG" {
    U1.pg, R_PG.p1, J2.p3, D4.cathode
  }

  connect U1.rt_sync -> R_RT.p1 as "RT"
  connect U1.boot -> C4.p1 as "BOOT"
  connect U1.en -> R_UV_T.p2 as "EN"
  connect U1.en -> R_UV_B.p1 as "EN"
  connect U1.fb -> R_FB_T.p2 as "FB"
  connect U1.fb -> R_FB_B.p1 as "FB"
  connect U1.fb -> C7.p1 as "FB"
  connect C7.p2 -> R_FB_T.p1 as "+3V3"
  connect R_LED.p2 -> D3.anode as "LED_PWR"
  connect R_PGLED.p2 -> D4.anode as "LED_PG"

  requires via_in_pad

}
