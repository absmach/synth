// SYN-67: 24 V in, 3.3 V out buck (TI LMR33640) with input parts (PTC, reverse-block diode, TVS).
// Intended for 24 V +10% in and 1 A out.
//
// Input chain: J1 -> F1 (PTC) -> D1 (Schottky reverse block) -> VIN node.
// VIN node: D2 (TVS), C1 (bulk), C2 (10 uF), C3 (220 nF, on the VIN pin), U1 VIN, R_UV_T.
// LMR33640: 3.8-36 V input, 4 A, 400 kHz, internal compensation, exposed thermal pad, open-drain PG.
// The SMBJ30A (VBR 33.3-36.8 V, clamp 48.4 V) is an ESD/transient clamp at the connector, not an OVP:
// its clamp is above U1's 38 V absolute maximum, so the board has no surge rating.
// Feedback divider is tapped from the output node (L1.p2), never from SW.
board "buck" {
  layers 4
  manufacturer "jlcpcb"
  revision "A"

  netclass "PWR" {
    trace_width 0.5mm
    clearance 0.2mm
  }

  power "VIN" 24v
  power "+3V3" 3.3v

  group "INPUT PROTECTION" color "#c2410c" {
    component J1: connector "jst_b2b_xh_a_2pin" value "24V_IN"
    component F1: fuse "mf_msmf110_33x" value "1.1A_PTC"
    component D1: diode "ss36" value "SS36"
    component D2: diode "smbj30a" value "SMBJ30A"
    notes "" {
      "J1 pin 1 is +24 V, pin 2 is GND."
      "F1 resettable PTC: Ihold 1.1 A, Vmax 33 V."
      "D1 Schottky in series blocks reverse polarity."
      "D2 TVS (30 V standoff) sits after D1, directly on the VIN node. It clamps ESD and transient energy only; the clamp is above U1's absolute maximum, so it is not an OVP."
    }
  }

  group "INPUT FILTER" color "#7c3aed" {
    component C1: capacitor "c_electrolytic_smd_8x10" value "47uF" voltage "50V"
    component C2: capacitor "c_generic_1206" value "10uF" dielectric "X7R" voltage "50V"
    component C3: capacitor "c_generic_0603" value "220nF" dielectric "X7R" voltage "50V"
    notes "" {
      "C1 bulk, C2 ceramic, C3 high-frequency next to the VIN pin (LMR33640 Table 9-2: 10 uF + 220 nF)."
      "50 V parts for a 24 V rail; DC-bias derating of C2 is not known."
    }
  }

  group "UVLO" color "#0a7d4a" {
    component R_UV_T: resistor "r_generic_0603" value "1.37M" tolerance "1%"
    component R_UV_B: resistor "r_generic_0603" value "100k" tolerance "1%"
    notes "" {
      "EN divider from VIN. LMR33640 VEN-H 1.231 V typical, 100 mV hysteresis: start 18.1 V, stop 16.6 V."
      "EN stays under 2 V at a 28 V input (EN absolute maximum is VIN + 0.3 V)."
    }
  }

  group "BUCK" color "#0072b2" {
    component U1: regulator "lmr33640"
    component C4: capacitor "c_generic_0603" value "100nF" dielectric "X7R" voltage "16V"
    component C8: capacitor "c_generic_0603" value "1uF" dielectric "X7R" voltage "16V"
    component L1: inductor "l_bourns_srn6045ta_6r8m" value "6.8uH"
    component C5: capacitor "c_generic_1206" value "22uF" dielectric "X7R" voltage "25V"
    component C6: capacitor "c_generic_1206" value "22uF" dielectric "X7R" voltage "25V"
    component C9: capacitor "c_generic_1206" value "22uF" dielectric "X7R" voltage "25V"
    notes "" {
      "LMR33640: 400 kHz, internal compensation, exposed pad (pin 9) on GND, open-drain PG."
      "C4 100 nF boot capacitor between BOOT and SW; C8 1 uF on VCC."
      "L1 6.8 uH and 3x 22 uF follow Table 9-2 for 3.3 V at 400 kHz (minimum Cout is 3x 22 uF)."
      "The exposed pad (pin 9) is soldered to the F.Cu GND pour. There are no vias in the pad:"
      "the board's fabrication floor is a 0.3 mm drill and the KiCad thermal-via footprint ships 0.2 mm."
    }
  }

  group "FEEDBACK" color "#b45309" {
    component R_FB_T: resistor "r_generic_0603" value "100k" tolerance "1%"
    component R_FB_B: resistor "r_generic_0603" value "43.2k" tolerance "1%"
    component C7: capacitor "c_generic_0603" value "56pF" dielectric "C0G" voltage "50V"
    notes "" {
      "Vout = 1.0 V x (1 + 100k / 43.2k) = 3.31 V."
      "Divider taps the output node on the far side of L1, not SW."
      "C7 56 pF feed-forward across the upper resistor (datasheet Eq 9 gives about 60 pF)."
    }
  }

  group "POWER GOOD" color "#4d7c0f" {
    component R_PG: resistor "r_generic_0603" value "100k"
    notes "" {
      "PG is open drain and pulled up to +3V3 through 100k (datasheet 8.3.1 suggests 100k to VCC or VOUT)."
      "PG goes low during start-up and on a fault, so J2 pin 3 reads valid only after the 4 ms start-up delay."
    }
  }

  group "OUTPUT" color "#be123c" {
    component J2: connector "jst_b4b_xh_a_4pin" value "3V3_OUT"
    component D3: led "ltst_c190kgkt" value "PWR"
    component R_LED: resistor "r_generic_0603" value "470"
    notes "" {
      "J2 pin 1 is +3.3 V, pin 2 GND, pin 3 power-good (3.3 V logic, 100k pull-up), pin 4 GND."
      "D3 green power LED from the 3.3 V rail."
    }
  }

  group "MECHANICAL" color "#475569" {
    component H1: mounting_hole "mounting_hole_m2_5" value "M2.5"
    component H2: mounting_hole "mounting_hole_m2_5" value "M2.5"
    notes "" {
      "Two M2.5 non-plated holes in opposite corners; the board is fixed down through them."
    }
  }

  net "VIN_RAW" class "PWR" {
    J1.p1, F1.p1
  }

  net "VIN_FUSED" class "PWR" {
    F1.p2, D1.anode
  }

  net "VIN" class "PWR" {
    D1.cathode, D2.cathode,
    C1.p1, C2.p1, C3.p1,
    U1.vin, R_UV_T.p1
  }

  net "GND" class "PWR" {
    J1.p2, D2.anode,
    C1.p2, C2.p2, C3.p2,
    U1.gnd, U1.pad, R_UV_B.p2,
    C5.p2, C6.p2, C9.p2, R_FB_B.p2, C8.p2,
    J2.p2, J2.p4, D3.cathode
  }

  net "SW" class "PWR" {
    U1.sw, L1.p1, C4.p2
  }

  net "+3V3" class "PWR" {
    L1.p2, C5.p1, C6.p1, C9.p1,
    R_FB_T.p1, J2.p1, R_LED.p1, R_PG.p2
  }

  net "PG" {
    U1.pg, R_PG.p1, J2.p3
  }

  net "U1_VCC" {
    U1.vcc, C8.p1
  }

  connect U1.boot -> C4.p1 as "BOOT"
  connect U1.en -> R_UV_T.p2 as "EN"
  connect U1.en -> R_UV_B.p1 as "EN"
  connect U1.fb -> R_FB_T.p2 as "FB"
  connect U1.fb -> R_FB_B.p1 as "FB"
  connect U1.fb -> C7.p1 as "FB"
  connect C7.p2 -> R_FB_T.p1 as "+3V3"
  connect R_LED.p2 -> D3.anode as "LED_PWR"
}
