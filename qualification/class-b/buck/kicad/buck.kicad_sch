	)
	(text
		"C1 bulk, C2 ceramic, C3 high-frequency next to the VIN pin (LMR33640 Table 9-2: 10 uF + 220 nF)."
		(at 17.28 170.26 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "d57eeb46-d2d2-5ad0-83cd-b8c51c0efa17")
	)
	(text
		"50 V parts for a 24 V rail; DC-bias derating of C2 is not known."
		(at 17.28 172.8 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "033c229a-975e-534f-a19e-697ae802cdfd")
	)
	(text
		""
		(at 201.5 74.82 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "67d09a96-3729-5a21-a544-facb3b94c530")
	)
	(text
		"EN divider from VIN. LMR33640 VEN-H 1.231 V typical, 100 mV hysteresis: start 18.1 V, stop 16.6 V."
		(at 201.5 78.82 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "f0f14f9f-c6a6-532d-ae34-189d160c324b")
	)
	(text
		"EN stays under 2 V at a 28 V input (EN absolute maximum is VIN + 0.3 V)."
		(at 201.5 81.36 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "4668f52c-a8b3-5a2b-b456-cfe4776d01d2")
	)
	(text
		""
		(at 137.04 196.74 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "69e2ba63-8a95-5624-a567-166f7aa1e5aa")
	)
	(text
		"LMR33640: 400 kHz, internal compensation, exposed pad (pin 9) on GND, open-drain PG."
		(at 137.04 200.74 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "de232a33-a444-56ba-a973-b8dc6c75c40c")
	)
	(text
		"C4 100 nF boot capacitor between BOOT and SW; C8 1 uF on VCC."
		(at 137.04 203.28 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "8a054eeb-d9fb-5d71-a0ce-4e728c2866b6")
	)
	(text
		"L1 6.8 uH and 3x 22 uF follow Table 9-2 for 3.3 V at 400 kHz (minimum Cout is 3x 22 uF)."
		(at 137.04 205.82 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "6a4ffd2a-578d-5f83-8d80-8ac46fd254f4")
	)
	(text
		"The exposed pad (pin 9) is soldered to the F.Cu GND pour. There are no vias in the pad:"
		(at 137.04 208.36 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "2b3067f7-ff76-5efa-be29-0360189f341d")
	)
	(text
		"the board's fabrication floor is a 0.3 mm drill and the KiCad thermal-via footprint ships 0.2 mm."
		(at 137.04 210.9 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "311279d4-d00d-526c-8f91-adc2f5f3aa8b")
	)
	(text
		""
		(at 313.26 79.9 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "84b81086-fe99-52a7-b2b3-be9c47614aee")
	)
	(text
		"Vout = 1.0 V x (1 + 100k / 43.2k) = 3.31 V."
		(at 313.26 83.9 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "8614aa7d-0e48-5d8b-8a5b-82457316c357")
	)
	(text
		"Divider taps the output node on the far side of L1, not SW."
		(at 313.26 86.44 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "92463cc1-0a73-5a50-9f5e-119c6f7a84d3")
	)
	(text
		"C7 56 pF feed-forward across the upper resistor (datasheet Eq 9 gives about 60 pF)."
		(at 313.26 88.98 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "69486300-6bc4-52d0-ae27-98eccee8dfcc")
	)
	(text
		""
		(at 18.65 227.22 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "e6a01d2f-dc52-539f-bc82-866e57ed919a")
	)
	(text
		"PG is open drain and pulled up to +3V3 through 100k (datasheet 8.3.1 suggests 100k to VCC or VOUT)."
		(at 18.65 231.22 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "5f63ecf2-b0cf-56e1-9736-6ef2354b3c86")
	)
	(text
		"PG goes low during start-up and on a fault, so J2 pin 3 reads valid only after the 4 ms start-up delay."
		(at 18.65 233.76 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "ab52d44f-c3be-5dbf-8263-df1ec5815da9")
	)
	(text
		""
		(at 312.16 166.26 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "a4e51b57-8e05-5d47-8ab7-fdb0834e6bdb")
	)
	(text
		"J2 pin 1 is +3.3 V, pin 2 GND, pin 3 power-good (3.3 V logic, 100k pull-up), pin 4 GND."
		(at 312.16 170.26 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "ebb89027-79eb-5f7d-b5f1-43d887d67988")
	)
	(text
		"D3 green power LED from the 3.3 V rail."
		(at 312.16 172.8 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "750960b9-2f6f-5622-b5ee-c6f3854388e1")
	)
	(text
		""
		(at 312.34 231.03 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "a488ab96-1f69-5dee-891f-51ecd755994b")
	)
	(text
		"Two M2.5 non-plated holes in opposite corners; the board is fixed down through them."
		(at 312.34 235.03 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "3f357c94-3218-5d6d-a691-8e431375f5fd")
	)
