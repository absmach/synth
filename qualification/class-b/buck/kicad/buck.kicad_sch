	(text
		""
		(at 17.28 46.88 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "49440ab3-5e44-5a53-8510-c9cd7c608393")
	)
	(text
		"J1 pin 1 is +24 V, pin 2 is GND."
		(at 17.28 50.88 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "36dc3697-f160-5657-9ee0-08802d56734b")
	)
	(text
		"F1 resettable PTC: Ihold 1.1 A, Vmax 33 V."
		(at 17.28 53.42 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "52136f32-4550-513f-8f5b-ce2760da10f3")
	)
	(text
		"D1 Schottky in series blocks reverse polarity."
		(at 17.28 55.96 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "4ba61855-8b55-58f3-883e-4b1248a9ea11")
	)
	(text
		"D2 TVS (30 V standoff) sits after D1, directly on the VIN node. Its 48.4 V clamp is below U1's 85 V absolute maximum, so U1 stays within its rating under a surge the TVS can absorb."
		(at 17.28 58.5 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "b0775773-63f1-5e38-a56b-9eda3abb3575")
	)
	(text
		""
		(at 18.55 178.96 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "7c897688-bb42-5f34-a43b-51ec1878dec2")
	)
	(text
		"C1 bulk, C2, C10 and C11 ceramic, C3 high-frequency next to the VIN pin (LMR38010 section 9.2.2.6: at least 4.7 uF + 100 to 220 nF)."
		(at 18.55 182.96 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "a87d3d43-e106-56b1-abdd-08627ecf0b86")
	)
	(text
		"C2, C10 and C11 are three 10 uF 50 V X7R in parallel, about 2 uF each at 24 V bias (Samsung library data-sheet plot, approximate), about 6 uF effective, against the datasheet minimum of 4.7 uF (LMR38010 section 9.2.2.6)."
		(at 18.55 185.5 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "ff032232-f0ca-565c-baa7-74af59682c0a")
	)
	(text
		"50 V parts for a 24 V rail."
		(at 18.55 188.04 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "eed8fc74-84e9-532f-ac8d-e07081f925f7")
	)
	(text
		""
		(at 247.22 46.88 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "5f210073-0b4f-54c9-a807-175c8a75feb0")
	)
	(text
		"EN divider from VIN. LMR38010 VEN-H 1.25 V typical (1.1 to 1.4), VEN-L 1.10 V typical: start 18.4 V (16.2 to 20.6 V), stop 16.2 V."
		(at 247.22 50.88 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "df43e3ca-5ea6-52a1-bfdb-6033f10327b0")
	)
	(text
		"EN stays under 2 V at a 28 V input (EN absolute maximum is VIN + 0.3 V)."
		(at 247.22 53.42 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "8fdb796b-4c94-5447-b2a3-929960a90cb3")
	)
	(text
		""
		(at 18.48 116.73 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f9d1abdd-3ade-5c73-9afe-2f16f1faeee8")
	)
	(text
		"LMR38010SDDAR: internal compensation, exposed pad (pin 9) on GND, open-drain PG, PFM with spread spectrum."
		(at 18.48 120.73 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "48911296-562b-5700-b840-569d19e4e111")
	)
	(text
		"R_RT 33k from RT/SYNC to GND sets 800 kHz (RT table under datasheet Figure 8-4); the pin must not float."
		(at 18.48 123.27 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "04639f8c-e503-5d60-90ea-d1b7561b7367")
	)
	(text
		"C4 100 nF boot capacitor between BOOT and SW."
		(at 18.48 125.81 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "0764b59a-80a5-570e-abb4-a4704e1e668c")
	)
	(text
		"L1 6.8 uH at 800 kHz gives about 0.5 A ripple at 26.4 V in (datasheet Eq 10 K about 0.5), above the 1.03 uH minimum of Eq 11 (0.25 x 3.3 V / 800 kHz); 3x 22 uF is unverified: Table 9-1 has no 3.3 V row."
		(at 18.48 128.35 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "10f648c7-fc69-58fc-b409-66bb6a23da00")
	)
	(text
		"The exposed pad (pin 9) is soldered to the F.Cu GND pour and carries six GND vias in the pad"
		(at 18.48 130.89 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "68aacb7d-fff2-5baa-989c-b6d2c0f0e8a2")
	)
	(text
		"(2 x 3, 0.6 mm pad, 0.3 mm drill, the board's fabrication floor; the 0.2 mm of the KiCad thermal-via footprint is below it)."
		(at 18.48 133.43 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "ccf05922-2da6-5401-82ab-d5d9676ecd2e")
	)
	(text
		"The pad needs the filled-via process, declared by requires via_in_pad."
		(at 18.48 135.97 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "d0ced621-1f8e-5110-b11e-7ccf3c1e69a7")
	)
	(text
		""
		(at 271.67 176.42 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f6fa9197-0dbc-5e82-9ff7-293f6ae51384")
	)
	(text
		"Vout = 1.0 V x (1 + 100k / 43.2k) = 3.31 V."
		(at 271.67 180.42 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "16832278-efc4-5fdc-a57b-c17a0ab8ade1")
	)
	(text
		"Divider taps the output node on the far side of L1, not SW."
		(at 271.67 182.96 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "394ea504-f2e1-54e3-98b8-ea2d78da2726")
	)
	(text
		"C7 56 pF feed-forward across the upper resistor (datasheet Eq 9 gives about 60 pF)."
		(at 271.67 185.5 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "18803b44-34cd-59ff-b7fe-02e06583fb6e")
	)
	(text
		""
		(at 272.65 234.84 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "a4e51b57-8e05-5d47-8ab7-fdb0834e6bdb")
	)
	(text
		"PG is open drain and pulled up to +3V3 through 100k (datasheet 8.3.5: pull up through a resistor; PG tolerates 20 V)."
		(at 272.65 238.84 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "fbd3eed9-2355-5b63-839a-25868504287a")
	)
	(text
		"PG goes low during start-up and on a fault, so J2 pin 3 reads valid only after the 4 ms start-up delay."
		(at 272.65 241.38 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "c56e84a6-557b-57bb-8f48-4661301e94b6")
	)
	(text
		"D4 green fault LED from +3V3 through R_PGLED to PG: it is lit while PG is low, dark while power is good."
		(at 272.65 243.92 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "c3df3258-61fc-5c79-b33f-d25009192ac8")
	)
	(text
		"About 2.5 mA when lit (470 R, Vf about 2.1 V); U1's PG pull-down is about 92 ohm RDSON, so PG stays near 0.4 V."
		(at 272.65 246.46 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "4b9b5720-4e33-5ba4-bb52-7a89b059f9b6")
	)
	(text
		""
		(at 17.52 239.92 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "42bdc38c-1cce-5771-bfb2-b1e4e36f38f4")
	)
	(text
		"J2 pin 1 is +3.3 V, pin 2 GND, pin 3 power-good (3.3 V logic, 100k pull-up), pin 4 GND."
		(at 17.52 243.92 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "17c73aa2-e698-5b78-98f0-778e88e660b4")
	)
	(text
		"D3 green power LED from the 3.3 V rail."
		(at 17.52 246.46 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "41e0c398-2091-5da2-8ad7-f8d8fb388a55")
	)
	(text
		""
		(at 129.46 225.95 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "97312583-4c3f-54cc-9867-2f009d8ae77b")
	)
	(text
		"Two M2.5 non-plated holes, H1 in the top middle and H2 at the right edge below J2; the board is fixed down through them."
		(at 129.46 229.95 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "b3957894-64cd-5faf-86c4-b5f7ed2ef7ad")
	)
