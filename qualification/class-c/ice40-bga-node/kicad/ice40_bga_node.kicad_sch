		)
		(uuid "6a749f36-cec1-5df8-8c75-e8d043725bd4")
	)
	(text
		"USB-C VBUS 5 V max 5.25 V. Order: fuse (0.5 A hold) -> TVS (6.0 V standoff) -> +5V. No reverse-polarity stage: a Type-C receptacle cannot be mated reversed, and one would only add drop ahead of the LDO. D8 and D9 are ESD diodes on the CC lines, with no rail connection."
		(at 17.28 113.11 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "14f49fe6-c5b8-5350-916e-bd666267b437")
	)
	(text
		"CC1 and CC2 each 5.1k to ground: sink, 5 V only."
		(at 17.28 115.65 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "00993a73-2df2-5208-9205-4e97e4266ca2")
	)
	(text
		""
		(at 17.28 445.66 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f88fcaff-c0eb-5f7d-82d6-4bce1a07be25")
	)
	(text
		"AMS1117-3.3 from the 5 V rail; two 10 uF in and two 10 uF out per registry."
		(at 17.28 449.66 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "f438f3a7-57bd-5f0b-a2ad-5e87edbdf2bd")
	)
	(text
		""
		(at 193.74 448.2 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "742ac38d-d5dc-510e-8d8c-65d56b92fdda")
	)
	(text
		"TLV70012 1.2 V core rail from 3V3, EN tied to VIN."
		(at 193.74 452.2 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "19a65fda-e5ad-533a-a1ab-ed387b2189e2")
	)
	(text
		""
		(at 330.22 512.97 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "e0533cc8-7e66-573b-bafc-2a90f9f7c980")
	)
	(text
		"VPP_FAST (B10) left unconnected. Core 1.2 V, I/O banks and VPP_2V5 on 3.3 V."
		(at 330.22 516.97 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "72e19695-7994-5224-8a61-988c8321989b")
	)
	(text
		""
		(at 465.66 67.2 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "dcb91b3d-d249-5c61-922b-87bcffeef6c1")
	)
	(text
		"The iCE40HX has no internal oscillator. 25 MHz 3.3 V oscillator on global buffer input GBIN1 (iot_197_gbin1); OE tied high."
		(at 465.66 71.2 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "0a31ea51-764b-56e3-8c76-913efc2e4d7f")
	)
	(text
