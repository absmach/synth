		)
		(uuid "583c66e1-7ce9-52d2-a80d-8365fd0fb2ac")
	)
	(text
		"Master SPI boot flash. SS_B pull-up keeps it deselected during reset; WP and HOLD pulled high."
		(at 548.66 360.76 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "0c40ffc5-9665-5421-9852-29cac4d12d0e")
