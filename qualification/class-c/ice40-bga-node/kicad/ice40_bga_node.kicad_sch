			)
			(justify left bottom)
		)
		(uuid "8ec7e4bd-23cd-59ec-93ff-058c8eee99d6")
	)
	(text
		"VPP_FAST (B10) left unconnected. Core 1.2 V, I/O banks and VPP_2V5 on 3.3 V."
		(at 398.8 516.97 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "2a993a0d-8d38-582d-83f3-2dd78a8c25c9")
	)
