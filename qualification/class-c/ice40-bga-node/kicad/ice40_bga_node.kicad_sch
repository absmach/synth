	)
	(text
		"TLV70012 1.2 V core rail from 3V3, EN tied to VIN."
		(at 229.3 520.78 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "30a938f0-1492-5d1f-94d5-c725d1a738f4")
