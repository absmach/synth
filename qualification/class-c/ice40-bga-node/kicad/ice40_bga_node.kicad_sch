			)
			(justify left bottom)
		)
		(uuid "1cf13b4a-a7e9-5288-ad74-06b50d9586fb")
	)
	(text
		"PLL supply: 1.2 V through a ferrite bead, 100 nF at each PLL ball, 1 uF bulk."
		(at 583.13 261.7 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
