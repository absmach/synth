	)
	(text
		"CDONE and CRESET_B 10k pull-ups to 3V3."
		(at 465.52 259.095 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "c75cdf5e-6d9a-5e23-b3f6-1f9ce3774271")
