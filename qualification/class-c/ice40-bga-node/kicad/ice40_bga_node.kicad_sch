				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "1f2f4847-4f7d-5c71-affb-df3b72f49ffc")
	)
	(text
		"One 100 nF per supply ball: C9-C12 core, C13-C17 bank VCCIO, C18 VCC_SPI, C19 VPP_2V5."
		(at 465.66 170.26 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "dc9e0bcf-2df6-55e7-aca9-bef10bd7400b")
	)
