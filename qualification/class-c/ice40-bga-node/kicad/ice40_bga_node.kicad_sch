			)
			(justify left bottom)
		)
		(uuid "8ca17561-eef5-57fe-a3c2-eac39657f401")
	)
	(text
		"CDONE and CRESET_B 10k pull-ups to 3V3."
		(at 678.88 340.375 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "36cbde02-fad5-5260-8671-42014a57536a")
	)
