			)
			(justify left bottom)
		)
		(uuid "6f4cd1fc-9e9e-52c6-b925-e6c0ad5e5ca4")
	)
	(text
		"The iCE40HX has no internal oscillator. 25 MHz 3.3 V oscillator on global buffer input GBIN1 (iot_197_gbin1); OE tied high."
		(at 511.38 71.2 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "826694d6-2c37-5de7-a110-df088b57ec3d")
	)
