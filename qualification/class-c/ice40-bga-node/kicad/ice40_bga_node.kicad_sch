		""
		(at 511.38 245 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "004a14a1-66c6-55d0-ab5c-bd21d064a1d3")
	)
	(text
		"One 100 nF per supply ball: C9-C12 core, C13-C17 bank VCCIO, C18 VCC_SPI, C19 VPP_2V5."
		(at 511.38 249 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "9a3f28ca-aba9-5fb6-b609-1ce0869956bf")
	)
