				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "cd8f943e-9b42-5fe1-b45f-28bc0704aa2d")
	)
	(text
		"AMS1117-3.3 from the 5 V rail; two 10 uF in and two 10 uF out per registry."
		(at 17.28 518.24 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "ef89b820-30bb-5608-940a-d019d0249b1e")
