			)
			(justify left bottom)
		)
		(uuid "16cfe499-65c9-54d9-912c-9ea8d5e79ba8")
	)
	(text
		"PLL supply: 1.2 V through a ferrite bead, 100 nF at each PLL ball, 1 uF bulk."
		(at 509.47 144.86 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "64d3725a-506e-5018-941f-8cadc5ceafbe")
	)
