			)
			(justify left bottom)
		)
		(uuid "391bd152-b08e-5a07-b1ae-02479cf20a8b")
	)
	(text
		"Master SPI boot flash. SS_B pull-up keeps it deselected during reset; WP and HOLD pulled high."
		(at 511.24 376 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "eda95b21-e0b1-5f51-8214-5a78d5ec718f")
	)
	(text
		""
		(at 511.73 462.17 0)
