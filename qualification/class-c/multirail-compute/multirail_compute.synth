// A four-layer multi-rail compute board: an ESP32-WROOM-32 module on four
// supply rails from one 12 V input, with a QSPI flash, an I2C GPIO expander,
// a shift register, and two expansion headers.
//
// Produced from a prompt through the Synth MCP server.
//
// What this board is for: thermal paths, keepouts, assembly access and DFM
// constraints on a board that carries several rails. It is deliberately not a
// fine-pitch board. Every package here is 1.27 mm pitch or coarser, because
// escape routing is a different question and one the iCE40 board already
// asks. At JLCPCB's standard floor a minimum track plus its clearance needs
// 0.254 mm of gap, which a 1.27 mm SOIC leaves and a 0.5 mm QFP does not, so
// nothing here should fail for want of room.
//
// The rails, and why there are four of them:
//
//   12 V in   barrel-equivalent through a polyfuse and a TVS array
//   5 V       MP2307 buck, the only switching stage, and the part that gets
//             hot: 500 mW at 50 C/W, with the thermistor beside it
//   3V3       AMS1117 from the 5 V rail, feeding the module and the digital
//             peripherals, carried as a plane
//   3V3_A     LP5907 low-noise LDO behind a ferrite bead, for the analog
//             header, so switching ripple does not reach it
//   3V3_SW    TPS22918 load switch, so the peripheral header can be powered
//             down without dropping the module
//
// Both planes are on the inner layers: 5 V on In1.Cu and 3V3 on In2.Cu, with
// ground poured on the outer copper. Each plane rail gets an inner layer of
// its own; two rails on one layer at the same priority starve each other.
//
// THERMAL. Three parts declare what they dissipate and how well they shed it,
// so W-SYNTH-THERMAL-001 has something to judge rather than an assumption.
// The buck is the one that matters: its exposed pad is its heat path and ties
// to ground, and NTC1 sits beside it so the firmware can read the rise.
//
// KEEPOUT. The ESP32's antenna is at one end of the module and copper must
// not sit under it. The keepout below is placed on that end, not in the
// middle of the board where it would constrain nothing.
//
// ASSEMBLY ACCESS. The input connector, both headers and the four test points
// are hinted to edges; the mounting holes take the corners. A test point in
// the middle of a populated board is a test point you cannot reach.
//
// STATED LIMITATION: the registry models a subset of the ESP32 module's pins
// — eight of thirty-eight — so this board exercises the supply, enable, UART
// and I2C pins and leaves the rest undeclared. That is a registry depth
// limit, not a language one.

board "multirail_compute" {
    layers 4
    manufacturer "jlcpcb"
    revision "A"

    // Four layers because the rails are planes and the return path under the
    // digital signals has to be continuous. Two layers would put both rails
    // and the ground on the same copper as the signals.
    stackup {
      copper 0.035mm
      insulator 0.2104mm er 4.4 material "FR4"
      copper 0.0152mm
      insulator 1.065mm er 4.6 material "FR4"
      copper 0.0152mm
      insulator 0.2104mm er 4.4 material "FR4"
      copper 0.035mm
    }

    // `plane` floods a zone for the class's nets on the inner layers. A
    // netclass assigns no nets by itself: each is joined by `class "NAME"` on
    // a `connect`, which is why every rail connect below carries one.
    netclass "V5" {
      trace_width 0.8mm
      clearance 0.25mm
      plane
    }

    netclass "V3V3" {
      trace_width 0.6mm
      clearance 0.25mm
      plane
    }

    // The analog rail stays a trace: it is behind a ferrite bead, and pouring
    // it as a plane would couple it back to the switching rail it is filtered
    // from.
    netclass "ANALOG" {
      trace_width 0.4mm
      clearance 0.3mm
    }

    group "POWER IN" color "#c2410c" {
      component J1: connector "jst_ph_2pin" {
        placement_hint { region: left_edge edge: left priority: hard }
      }
      component F1: fuse      "polyfuse"
      component D1: diode     "d_schottky"
      component D2: diode     "tvs_array_5v"
      component C1: capacitor "c_electrolytic_100uf" value "100uF"
      component TP1: testpoint "testpoint_pad_1_5" {
        placement_hint { region: top_edge edge: top priority: soft }
      }

      // Reverse polarity first, then the fuse, then the clamp: a TVS in front
      // of the fuse has nothing to limit the fault current it conducts.
      connect J1.p1 -> D1.anode
      connect D1.cathode -> F1.p1
      // The input rail is its own net and its own copper: it is 12 V, not the
      // 5 V the buck makes, and putting both in one class would pour them on
      // the same plane.
      connect F1.p2 -> D2.ch1 as "V12"
      connect F1.p2 -> C1.p1
      connect F1.p2 -> TP1.p1
      connect J1.p2 -> D2.gnd as "GND"
      connect J1.p2 -> C1.p2
      connect D2.vcc -> D2.ch1
    }

    group "5V BUCK" color "#b91c1c" {
      component U1: regulator "mp2307_buck" {
        placement_hint { region: centre priority: soft }
      }
      component L1: inductor  "l_generic_1210" value "10uH"
      component C2: capacitor "c_generic_0805" value "22uF"
      component C3: capacitor "c_generic_0805" value "22uF"
      component R1: resistor  "r_generic_0603" value "31.6k"
      component R2: resistor  "r_generic_0603" value "10k"
      component C4: capacitor "c_generic_0603" value "100nF"
      // The thermal sense, beside the part that dissipates.
      component NTC1: resistor "r_thermistor_ntc_10k" value "10k"
      component TP2: testpoint "testpoint_pad_1_5" {
        placement_hint { region: top_edge edge: top priority: soft }
      }

      connect F1.p2 -> U1.in
      connect F1.p2 -> C2.p1
      connect C2.p2 -> U1.gnd
      connect U1.en -> F1.p2
      connect U1.bs -> C4.p1
      connect C4.p2 -> U1.sw
      connect U1.sw -> L1.p1
      connect L1.p2 -> C3.p1 as "V5" class "V5"
      connect L1.p2 -> R1.p1
      connect R1.p2 -> U1.fb
      connect U1.fb -> R2.p1
      connect R2.p2 -> U1.gnd
      connect C3.p2 -> U1.gnd
      connect L1.p2 -> TP2.p1
      // The exposed pad is the heat path and is tied to ground; an untied one
      // is both a thermal failure and unconnected copper under the package.
      connect U1.ep -> U1.gnd
      connect NTC1.p1 -> L1.p2
      connect NTC1.p2 -> U1.gnd
    }

    group "3V3 RAIL" color "#0369a1" {
      component U2: regulator "ams1117_3v3"
      component C5: capacitor "c_generic_0805" value "22uF"
      component C6: capacitor "c_generic_0603" value "100nF"
      component TP3: testpoint "testpoint_pad_1_5" {
        placement_hint { region: top_edge edge: top priority: soft }
      }

      connect L1.p2 -> U2.vin
      connect U2.vout -> C5.p1 as "V3V3" class "V3V3"
      connect C5.p2 -> U2.gnd
      connect U2.vout -> C6.p1
      connect C6.p2 -> U2.gnd
      connect U2.vout -> TP3.p1
    }

    group "3V3 ANALOG" color "#047857" {
      // The bead is what makes this a separate rail rather than a second name
      // for the digital one.
      component FB1: inductor  "ferrite_bead_0603" value "600R"
      component U3: regulator  "lp5907_3v3"
      component C7: capacitor  "c_generic_0603" value "1uF"
      component C8: capacitor  "c_generic_0603" value "1uF"
      component TP4: testpoint "testpoint_pad_1_5" {
        placement_hint { region: bottom_edge edge: bottom priority: soft }
      }

      connect U2.vout -> FB1.p1
      connect FB1.p2 -> U3.vin
      connect U3.vin -> C7.p1
      connect C7.p2 -> U3.gnd
      connect U3.en -> U3.vin
      connect U3.vout -> C8.p1 as "V3V3_A" class "ANALOG"
      connect C8.p2 -> U3.gnd
      connect U3.vout -> TP4.p1
    }

    group "SWITCHED RAIL" color "#7c3aed" {
      component U4: regulator "tps22918_loadswitch"
      component C9: capacitor "c_generic_0603" value "1uF"
      component R3: resistor  "r_generic_0603" value "100k"
      component R8: resistor  "r_generic_0603" value "100k"

      // From the 5 V rail, not the 3.3 V one: this part's input range starts
      // at 3.5 V, so a 3.3 V supply is below it and E-SYNTH-POWER-009 says so.
      connect L1.p2 -> U4.vin
      connect U4.vout -> C9.p1 as "V5_SW" class "ANALOG"
      connect C9.p2 -> U4.gnd
      // `ct` sets the inrush slew; `on` is strapped high so the rail comes up
      // with the board. Sequencing it would need a spare GPIO, and the
      // registry models eight of this module's pins — see the limitation.
      connect U4.ct -> R3.p1
      connect R3.p2 -> U4.gnd
      connect U4.on -> R8.p1
      connect R8.p2 -> L1.p2
    }

    group "ESP32 MODULE" color "#4338ca" {
      component U5: mcu "esp32_wroom_32" {
        placement_hint { region: centre priority: hard }
      }
      component C10: capacitor "c_generic_0805" value "22uF"
      component C11: capacitor "c_generic_0603" value "100nF"
      component R4: resistor   "r_generic_0603" value "10k"
      component SW1: switch    "spst_tactile"
      component LED1: led      "led_green_0603"
      component R5: resistor   "r_generic_0603" value "1k"

      connect U2.vout -> U5.vdd
      connect U5.gnd -> U2.gnd
      connect U5.vdd -> C10.p1
      connect C10.p2 -> U5.gnd
      connect U5.vdd -> C11.p1
      connect C11.p2 -> U5.gnd
      connect U5.en -> R4.p1
      connect R4.p2 -> U5.vdd
      connect U5.en -> SW1.p1
      connect SW1.p2 -> U5.gnd
      connect U5.io1_tx -> R5.p1
      connect R5.p2 -> LED1.anode
      connect LED1.cathode -> U5.gnd
    }

    group "IO EXPANDER" color "#0891b2" {
      component U7: ic "mcp23017_gpio"
      component C13: capacitor "c_generic_0603" value "100nF"
      component R6: resistor "r_generic_0603" value "4.7k"
      component R7: resistor "r_generic_0603" value "4.7k"

      connect U2.vout -> U7.vdd
      connect U7.v_ss -> U2.gnd
      connect U7.vdd -> C13.p1
      connect C13.p2 -> U7.v_ss
      connect U5.io21_sda -> U7.sda as "I2C_SDA"
      connect U5.io22_scl -> U7.sck as "I2C_SCL"
      connect U7.sda -> R6.p1
      connect R6.p2 -> U2.vout
      connect U7.sck -> R7.p1
      connect R7.p2 -> U2.vout
    }

    group "EXPANSION" color "#be185d" {
      component J2: connector "header_1x20" {
        placement_hint { region: right_edge edge: right priority: hard }
      }
      component J3: connector "header_1x20" {
        placement_hint { region: bottom_edge edge: bottom priority: hard }
      }

      // The digital header carries the switched rail, so a peripheral can be
      // powered down without dropping the module, plus the UART and the I2C
      // bus the expander sits on.
      connect U4.vout -> J2.p1
      connect J2.p2 -> U2.gnd
      connect U5.io1_tx -> J2.p3
      connect U5.io3_rx -> J2.p4
      connect U5.io21_sda -> J2.p5
      connect U5.io22_scl -> J2.p6
      connect U5.io0 -> J2.p7

      // The analog header carries the filtered rail and nothing switching.
      connect U3.vout -> J3.p1
      connect J3.p2 -> U2.gnd
      connect U7.sda -> J3.p3
      connect U7.sck -> J3.p4
    }

    group "MECHANICAL" color "#525252" {
      component H1: mounting_hole "mounting_hole_m2_5"
      component H2: mounting_hole "mounting_hole_m2_5"
      component H3: mounting_hole "mounting_hole_m2_5"
      component H4: mounting_hole "mounting_hole_m2_5"
      component FID1: fiducial "fiducial_1mm"
      component FID2: fiducial "fiducial_1mm"
      component FID3: fiducial "fiducial_1mm"
    }

    // Copper must not sit under the module's antenna, which is at one end of
    // the package rather than at its centre. A keepout in the middle of the
    // board would constrain nothing and read as satisfied.
    keepout antenna_clearance { radius 12mm }

    notes "Produced from a prompt via the Synth MCP server." {
      "Four rails from one 12 V input: a buck to 5 V, an LDO to 3V3, a"
      "low-noise LDO behind a ferrite bead for the analog header, and a load"
      "switch for the peripheral header. The two heavy rails are planes on"
      "their own inner layers; the analog rail stays a trace so pouring it"
      "does not couple it back to the switcher it is filtered from."
    }
}
