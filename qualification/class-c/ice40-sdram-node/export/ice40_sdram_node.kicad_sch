		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "ad510d8c-1899-5b61-be52-0dd08876b59a")
	)
	(text
		"D1 standoff 6.0 V, above 5.25 V, before Q1."
