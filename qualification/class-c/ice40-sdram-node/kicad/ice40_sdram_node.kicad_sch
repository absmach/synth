	(text
		"5 V in, max 5.25 V. F1 hold 1.1 A, 16 V."
		(at 17.21 179.15 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "28fb98ef-1259-52e3-be98-8b3ddd967cdc")
	)
	(text
		"D1 standoff 6.0 V, above 5.25 V, then straight to +5V: no reverse-polarity stage, since a Type-C receptacle cannot be mated reversed and one would only add drop ahead of the LDO."
