				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f11c29e1-7948-5e00-8f31-8d5ee5522b1c")
	)
	(text
		"J4 carries 3V6_SW, 3V3, 1V8, 1V2 and two GPIO. TP1 VIN, TP2 3V6, TP3 3V3, TP4 1V8, TP5 1V2, TP6 VBUS, TP7-8 GND, TP9 3V6_SW."
		(at 525.66 240.11 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "3eea67d6-6ccf-5c9c-886f-f7e4f4e0bd64")
