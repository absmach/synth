	(text
		"DC input 5-12 V: PTC F1, TVS D1 (15 V standoff, 24.4 V clamp), SS36 D2 reverse block."
		(at 18.55 271.795 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "dddeaf64-16ce-5c23-a7bf-586bd7f6f1ec")
	)
	(text
		"USB VBUS: PTC F2, TVS D3, 1N5819 D4 ORs VBUS into VIN."
		(at 18.55 274.335 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "1735cbf8-c14a-5287-b7ec-1f4816d645a0")
	)
	(text
		""
		(at 17.8 504.015 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "13ebfa9d-26a4-5fe1-84dd-fbcf1824ed1b")
	)
	(text
		"LMR33640 VFB 1.0 V: Vout = 1.0 x (1 + 10k / 3.83k) = 3.611 V."
		(at 17.8 508.015 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "130bbaaa-52a3-5b5d-b387-959ae1e233ca")
	)
	(text
		"Internal compensation: no external network. L1 6.8 uH, ripple 0.93 A at 12 V in."
		(at 17.8 510.555 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "9415205a-76be-57c2-8311-03a1371e39ce")
	)
	(text
		""
		(at 334.78 128.16 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "aba90265-6a49-5951-84e9-6a4283745fb5")
	)
	(text
		"3V3 LP5907 from 3V6; 1V8 AMS1117 (R4 is its minimum load); 1V2 TLV70012."
		(at 334.78 132.16 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "4157e45a-a773-5d6c-9f26-9593f16eb353")
	)
	(text
		"Sequence: 3V3 up, R16/C17 delay ~10 ms, TPS22918 passes 3V6 to the 1V8 LDO, 1V8 enables the 1V2 LDO."
		(at 334.78 134.7 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "fa803f23-a03b-5c49-a9c0-f0df93e16a21")
	)
	(text
		""
		(at 333.82 496.395 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "d57a5b59-2610-58c8-b0f4-2c33c19fb63f")
	)
	(text
		"STM32F103C8 needs 3.3 V only; 8 MHz crystal for USB; SWD on J3."
		(at 333.82 500.395 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "457e3b9d-20d4-5fa9-96bd-19ddc7114ff7")
	)
	(text
		""
		(at 525.66 236.11 0)
		(effects
