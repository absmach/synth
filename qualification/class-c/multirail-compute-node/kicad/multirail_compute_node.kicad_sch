		(at 284.7044 311.7448 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "2558ff40-c6af-515b-9b50-0fc5785ccf63")
	)
	(text
		"Sequence: 3V3 up, R16/C17 delay ~10 ms, TPS22918 passes 3V6 to the 1V8 LDO, 1V8 enables the 1V2 LDO."
		(at 284.7044 314.2848 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "fa803f23-a03b-5c49-a9c0-f0df93e16a21")
	)
	(text
		""
		(at 464.5852 541 0)
		(effects
