			)
			(justify left bottom)
		)
		(uuid "d57a5b59-2610-58c8-b0f4-2c33c19fb63f")
	)
	(text
		"STM32F103C8 needs 3.3 V only; 8 MHz crystal for USB; SWD on J3."
		(at 464.5852 545 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "457e3b9d-20d4-5fa9-96bd-19ddc7114ff7")
	)
	(text
		""
		(at 17 573 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f11c29e1-7948-5e00-8f31-8d5ee5522b1c")
	)
	(text
		"J4 carries 3V6_SW, 3V3, 1V8, 1V2 and two GPIO. TP1 VIN, TP2 3V6, TP3 3V3, TP4 1V8, TP5 1V2, TP6 VBUS, TP7-8 GND, TP9 3V6_SW."
		(at 17 577 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "3eea67d6-6ccf-5c9c-886f-f7e4f4e0bd64")
	)
