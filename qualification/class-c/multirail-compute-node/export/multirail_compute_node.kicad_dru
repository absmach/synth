(version 1)
(rule "manufacturer copper to board edge"
  (constraint edge_clearance (min 0.3mm)))
(rule "manufacturer copper to NPTH hole"
  (constraint edge_clearance (min 0.2mm))
  (condition "A.Pad_Type == 'NPTH, mechanical'"))
(rule "manufacturer copper to hole"
  (constraint hole_clearance (min 0.2mm)))
(rule "netclass BUCK_SW stays off In1.Cu"
  (layer "In1.Cu")
  (condition "A.NetClass == 'BUCK_SW'")
  (constraint disallow track))
(rule "netclass BUCK_SW stays off In2.Cu"
  (layer "In2.Cu")
  (condition "A.NetClass == 'BUCK_SW'")
  (constraint disallow track))
(rule "netclass BUCK_SW stays off B.Cu"
  (layer "B.Cu")
  (condition "A.NetClass == 'BUCK_SW'")
  (constraint disallow track))
(rule "netclass BUCK_SW changes no layer"
  (condition "A.NetClass == 'BUCK_SW'")
  (constraint disallow via))
(rule "netclass XTAL stays off In1.Cu"
  (layer "In1.Cu")
  (condition "A.NetClass == 'XTAL'")
  (constraint disallow track))
(rule "netclass XTAL stays off In2.Cu"
  (layer "In2.Cu")
  (condition "A.NetClass == 'XTAL'")
  (constraint disallow track))
(rule "netclass XTAL stays off B.Cu"
  (layer "B.Cu")
  (condition "A.NetClass == 'XTAL'")
  (constraint disallow track))
(rule "netclass XTAL changes no layer"
  (condition "A.NetClass == 'XTAL'")
  (constraint disallow via))
(rule "netclass SPI stays off In1.Cu"
  (layer "In1.Cu")
  (condition "A.NetClass == 'SPI'")
  (constraint disallow track))
(rule "netclass SPI stays off In2.Cu"
  (layer "In2.Cu")
  (condition "A.NetClass == 'SPI'")
  (constraint disallow track))
(rule "netclass SPI stays off B.Cu"
  (layer "B.Cu")
  (condition "A.NetClass == 'SPI'")
  (constraint disallow track))
(rule "netclass SPI changes no layer"
  (condition "A.NetClass == 'SPI'")
  (constraint disallow via))
