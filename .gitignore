# Compiler-generated outputs. KiCad exports from `synth export-kicad`
# land in `<source>_kicad/` next to the .synth file; they are pure
# build products. Reference KiCad files (for round-trip testing,
# say) should live elsewhere — not in `*_kicad/`.
/examples/*_kicad/

# Generated export outputs
/output/
/exports/
/out/
/data/

