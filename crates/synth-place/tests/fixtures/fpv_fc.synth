// FPV flight controller, rev B.
//   36 mm class, 2 layers, four M2.5 holes on a 30.5 mm pattern.
//   4S battery -> TVS + bulk cap -> 5 V buck (receiver, LED) -> 3.3 V LDO
//   (ATmega328P, MPU-6050).  USB-C is the 5 V power input.
//   Four ESC outputs, a receiver UART, a status LED, a buzzer pad and reset.

board "fpv_fc" {
  layers 2
  manufacturer "jlcpcb"
  revision "B"

  netclass "PWR" {
    trace_width 0.5mm
    clearance 0.2mm
  }
  netclass "USB" {
    trace_width 0.25mm
    clearance 0.15mm
  }
  netclass "SIG" {
    trace_width 0.25mm
    clearance 0.15mm
  }

  power "VBAT" 14.8v class "PWR"
  power "VBUS" 5v class "PWR"
  power "+5V" 5v class "PWR"
  power "+3V3" 3.3v class "PWR"

  // ---- mechanical -------------------------------------------------------
  component H1: mounting_hole "mounting_hole_m2_5" {  }
  component H2: mounting_hole "mounting_hole_m2_5" {  }
  component H3: mounting_hole "mounting_hole_m2_5" {  }
  component H4: mounting_hole "mounting_hole_m2_5" {  }

  // ---- battery input and 5 V / 3.3 V rails -------------------------------
  group "POWER" color "#c2410c" {
    component J_BAT: connector "jst_b2b_xh_a_2pin" value "4S_BAT" {
          }
    component D_TVS: diode "smaj15a_tvs" value "SMAJ15A" {
          }
    component C_BULK: capacitor "c_electrolytic_smd_8x10" value "47uF" voltage "50V" {
          }

    component U_BUCK: regulator "lmr33640" {
          }
    component C_IN1: capacitor "c_generic_1206" value "10uF" dielectric "X7R" voltage "50V" {
          }
    component C_IN2: capacitor "c_generic_0603" value "220nF" dielectric "X7R" voltage "50V" {
          }
    component R_EN: resistor "r_generic_0603" value "100k" {
          }
    component L1: inductor "l_power_10uh_6045" value "10uH" {
          }
    component C_OUT1: capacitor "c_generic_1206" value "22uF" dielectric "X7R" voltage "25V" {
          }
    component C_OUT2: capacitor "c_generic_1206" value "22uF" dielectric "X7R" voltage "25V" {
          }
    component C_OUT3: capacitor "c_generic_0603" value "100nF" dielectric "X7R" voltage "25V" {
          }
    component C_BOOT: capacitor "c_generic_0603" value "100nF" dielectric "X7R" voltage "25V" {
          }
    component C_VCC: capacitor "c_generic_0603" value "1uF" dielectric "X7R" voltage "16V" {
          }
    component R_FB_T: resistor "r_generic_0603" value "40.2k" tolerance "1%" {
          }
    component R_FB_B: resistor "r_generic_0603" value "10k" tolerance "1%" {
          }
    component R_PG: resistor "r_generic_0603" value "100k" {
          }

    component U_LDO: regulator "ams1117_3v3" {
          }
    component C_LDO1: capacitor "c_generic_0805" value "10uF" dielectric "X7R" voltage "16V" {
          }
    component C_LDO2: capacitor "c_generic_0805" value "10uF" dielectric "X7R" voltage "16V" {
          }
    component C_LDO3: capacitor "c_generic_0603" value "100nF" dielectric "X7R" voltage "16V" {
          }
    notes "" {
      "J_BAT: 4S LiPo, pin 1 = 14.8 V, pin 2 = GND."
      "D_TVS SMAJ15A plus C_BULK 47uF/50V on the battery input."
      "U_BUCK LMR33640: 400 kHz, internal compensation, 5 V at up to 4 A."
      "R_FB_T 40.2k / R_FB_B 10k gives 5.02 V from the 1.0 V reference."
      "U_LDO AMS1117-3.3: 3.3 V for the ATmega328P and the MPU-6050."
    }
  }

  // ---- MCU, clock, reset, LED and buzzer --------------------------------
  group "MCU" color "#0072b2" {
    component U_MCU: mcu "atmega328p" {
          }
    component C_MCU1: capacitor "c_generic_0603" value "100nF" dielectric "X7R" voltage "16V" {
          }
    component C_MCU2: capacitor "c_generic_0603" value "100nF" dielectric "X7R" voltage "16V" {
          }
    component C_MCU3: capacitor "c_generic_0603" value "100nF" dielectric "X7R" voltage "16V" {
          }
    component C_MCU4: capacitor "c_generic_0603" value "100nF" dielectric "X7R" voltage "16V" {
          }
    component C_MCU5: capacitor "c_generic_0805" value "4.7uF" dielectric "X7R" voltage "16V" {
          }
    component C_VDDA: capacitor "c_generic_0603" value "100nF" dielectric "X7R" voltage "16V" {
          }

    component Y1: crystal "xtal_8mhz" value "8MHz" {
          }
    component C_X1: capacitor "c_generic_0603" value "18pF" dielectric "C0G" voltage "50V" {
          }
    component C_X2: capacitor "c_generic_0603" value "18pF" dielectric "C0G" voltage "50V" {
          }

    component R_NRST: resistor "r_generic_0603" value "10k" {
          }
    component C_NRST: capacitor "c_generic_0603" value "100nF" dielectric "X7R" voltage "16V" {
          }
    component SW1: switch "spst_tactile" value "RESET" {
          }

    component R_LED: resistor "r_generic_0603" value "1k"
    component D_LED: led "led_green_0603" value "STATUS"
    component R_BZ: resistor "r_generic_0603" value "100"
    component TP_BZ: testpoint "testpoint_pad_1_5" value "BUZZER"
    component TP_GND: testpoint "testpoint_pad_1_5" value "BUZZER_GND"

    notes "" {
      "ATmega328P at 8 MHz, 3.3 V: external crystal with 18 pF load caps."
      "VCC/AVCC from the 3.3 V LDO, 100nF on each; AREF has its own 100nF."
      "NRST: 10k pull-up, 100nF, tactile button to GND."
      "Status LED on +5V through 1k, sunk by PB5."
      "Buzzer pads: TP_BZ = PD7 through 100 ohm, TP_GND = GND."
    }
  }

  // ---- IMU ---------------------------------------------------------------
  group "IMU" color "#0a7d4a" {
    component U_IMU: sensor "mpu6050_imu" {
          }
    component C_IMU1: capacitor "c_generic_0603" value "100nF" dielectric "X7R" voltage "16V" {
          }
    component C_IMU2: capacitor "c_generic_0805" value "2.2uF" dielectric "X7R" voltage "16V" {
          }
    component C_IMU3: capacitor "c_generic_0603" value "100nF" dielectric "X7R" voltage "16V" {
          }
    component C_IMU4: capacitor "c_generic_0603" value "100nF" dielectric "X7R" voltage "16V" {
          }
    component C_IMU5: capacitor "c_generic_0603" value "2.2nF" dielectric "C0G" voltage "50V" {
          }
    component R_INT: resistor "r_generic_0603" value "1k" {
          }
    component R_SDA: resistor "r_generic_0603" value "4.7k" {
          }
    component R_SCL: resistor "r_generic_0603" value "4.7k" {
          }
    notes "" {
      "MPU-6050 on I2C: SCL = PC5 (pin 28), SDA = PC4 (pin 27), AD0 = GND (0x68)."
      "VDD and VLOGIC on +3V3; 100nF + 2.2uF on VDD, 100nF on VLOGIC."
      "REGOUT 100nF, CPOUT 2.2nF, CLKIN and FSYNC to GND."
      "INT goes to PD2 (pin 4). 4.7k pull-ups on SDA and SCL."
    }
  }

  // ---- ESC outputs ------------------------------------------------------
  group "ESC OUT" color "#b45309" {
    component J_ESC: connector "header_1x4" value "ESC1-4" {
          }
    component J_ESCG: connector "header_1x4" value "GND" {
          }
    notes "" {
      "J_ESC: pin 1 = ESC1 (PD3), pin 2 = ESC2 (PD4), pin 3 = ESC3 (PD5), pin 4 = ESC4 (PD6)."
      "J_ESCG: four ground pins next to the ESC signal header."
    }
  }

  // ---- receiver port ----------------------------------------------------
  group "RECEIVER" color "#7c3aed" {
    component J_RX: connector "header_1x4" value "RX" {
          }
    component D_RX: diode "d_tvs_5v" value "TVS" {
          }
    component D_TX: diode "d_tvs_5v" value "TVS" {
          }
    notes "" {
      "J_RX: pin 1 = +5V, pin 2 = GND, pin 3 = RX (receiver TX -> PD0), pin 4 = TX (PD1 -> receiver RX)."
      "D_RX/D_TX clamp the two UART lines to GND."
    }
  }

  // ---- USB-C 5 V power input -------------------------------------------
  group "USB" color "#be123c" {
    component J_USB: connector "usb_c_receptacle" value "USB_C" {
          }
    component R_CC1: resistor "r_generic_0603" value "5.1k" {
          }
    component R_CC2: resistor "r_generic_0603" value "5.1k" {
          }
    component D_CC1: diode "ptvs6v0s1ur" value "TVS" {
          }
    component D_CC2: diode "ptvs6v0s1ur" value "TVS" {
          }
    component D_VBUS: diode "d_schottky" value "1N5819" {
          }
    component D_VBUS_TVS: diode "ptvs6v0s1ur" value "TVS" {
          }
    component C_VBUS: capacitor "c_generic_0603" value "1uF" dielectric "X7R" voltage "10V" {
          }
    component C_VBUS2: capacitor "c_generic_0603" value "100nF" dielectric "X7R" voltage "10V" {
          }
    notes "" {
      "USB-C 5 V sink only: CC1/CC2 5.1k to GND."
      "D_VBUS ORs USB 5 V onto +5V; PTVS6V0S1UR clamps VBUS, CC1 and CC2."
      "SBU1/SBU2 are not signals; the shell is grounded."
    }
  }

  // ---- battery input ----------------------------------------------------
  net "VBAT" class "PWR" {
    J_BAT.p1, D_TVS.cathode, C_BULK.p1,
    U_BUCK.vin, C_IN1.p1, C_IN2.p1, R_EN.p1
  }

  net "GND" class "PWR" {
    J_BAT.p2, D_TVS.anode, C_BULK.p2,
    U_BUCK.gnd, U_BUCK.pad, C_IN1.p2, C_IN2.p2,
    C_OUT1.p2, C_OUT2.p2, C_OUT3.p2, C_VCC.p2,
    R_FB_B.p2, U_LDO.gnd,
    C_LDO1.p2, C_LDO2.p2, C_LDO3.p2,
    U_MCU.gnd, U_MCU.gnd_2,
    C_MCU1.p2, C_MCU2.p2, C_MCU3.p2, C_MCU4.p2, C_MCU5.p2,
    C_VDDA.p2,
    Y1.case_1, Y1.case_2, C_X1.p2, C_X2.p2,
    C_NRST.p2, SW1.p2,
    U_IMU.gnd, U_IMU.ep, U_IMU.ad0, U_IMU.fsync, U_IMU.clkin,
    C_IMU1.p2, C_IMU2.p2, C_IMU3.p2, C_IMU4.p2, C_IMU5.p2,
    J_ESCG.p1, J_ESCG.p2, J_ESCG.p3, J_ESCG.p4,
    J_RX.p2, D_RX.anode, D_TX.anode,
    J_USB.gnd, J_USB.gnd_a12, J_USB.gnd_b1, J_USB.gnd_b12, J_USB.shld,
    R_CC1.p2, R_CC2.p2, D_CC1.anode, D_CC2.anode,
    D_VBUS_TVS.anode, C_VBUS.p2, C_VBUS2.p2,
    TP_GND.p1
  }

  net "VBUS" class "PWR" {
    J_USB.vbus, J_USB.vbus_b4, J_USB.vbus_a9, J_USB.vbus_b9,
    D_VBUS.anode, D_VBUS_TVS.cathode, C_VBUS.p1, C_VBUS2.p1
  }

  net "+5V" class "PWR" {
    D_VBUS.cathode, L1.p2,
    C_OUT1.p1, C_OUT2.p1, C_OUT3.p1, R_FB_T.p1,
    R_PG.p2,
    U_LDO.vin,
    J_RX.p1, R_LED.p1
  }

  net "+3V3" class "PWR" {
    U_LDO.vout, C_LDO1.p1, C_LDO2.p1, C_LDO3.p1,
    U_MCU.vcc, U_MCU.avcc,
    C_MCU1.p1, C_MCU2.p1, C_MCU3.p1, C_MCU4.p1, C_MCU5.p1,
    R_NRST.p1,
    U_IMU.vdd, U_IMU.vlogic,
    C_IMU1.p1, C_IMU2.p1, C_IMU3.p1,
    R_SDA.p2, R_SCL.p2
  }

  // ---- buck power stage -------------------------------------------------
  net "SW" class "PWR" {
    U_BUCK.sw, L1.p1, C_BOOT.p2
  }
  net "BUCK_BOOT" {
    U_BUCK.boot, C_BOOT.p1
  }
  net "BUCK_VCC" {
    U_BUCK.vcc, C_VCC.p1
  }
  net "BUCK_EN" {
    R_EN.p2, U_BUCK.en
  }
  net "BUCK_FB" {
    U_BUCK.fb, R_FB_T.p2, R_FB_B.p1
  }
  net "PWR_GOOD" {
    U_BUCK.pg, R_PG.p1
  }
  net "AREF" {
    U_MCU.aref, C_VDDA.p1
  }

  // ---- MCU clock and reset ----------------------------------------------
  net "XTAL_IN" {
    U_MCU.xtal1, Y1.p1, C_X1.p1
  }
  net "XTAL_OUT" {
    U_MCU.xtal2, Y1.p2, C_X2.p1
  }
  net "NRST" {
    U_MCU.reset, R_NRST.p2, C_NRST.p1, SW1.p1
  }

  // ---- I2C --------------------------------------------------------------
  net "I2C_SCL" {
    U_MCU.pc5_scl, U_IMU.scl, R_SCL.p1
  }
  net "I2C_SDA" {
    U_MCU.pc4_sda, U_IMU.sda, R_SDA.p1
  }
  net "IMU_INT" {
    U_IMU.int, R_INT.p1
  }
  net "IMU_INT_MCU" {
    R_INT.p2, U_MCU.pd2
  }
  net "IMU_REGOUT" {
    U_IMU.regout, C_IMU4.p1
  }
  net "IMU_CPOUT" {
    U_IMU.cpout, C_IMU5.p1
  }

  // ---- ESC outputs ------------------------------------------------------
  net "ESC1" { U_MCU.pd3, J_ESC.p1 }
  net "ESC2" { U_MCU.pd4, J_ESC.p2 }
  net "ESC3" { U_MCU.pd5, J_ESC.p3 }
  net "ESC4" { U_MCU.pd6, J_ESC.p4 }

  // ---- receiver UART ----------------------------------------------------
  net "UART_TX" {
    U_MCU.pd1_tx, J_RX.p4, D_TX.cathode
  }
  net "UART_RX" {
    U_MCU.pd0_rx, J_RX.p3, D_RX.cathode
  }

  // ---- status LED and buzzer --------------------------------------------
  net "LED_STAT" {
    R_LED.p2, D_LED.anode
  }
  net "LED_K" {
    D_LED.cathode, U_MCU.pb5_sck
  }
  net "BUZZER" {
    U_MCU.pd7, R_BZ.p1
  }
  net "BUZZER_PAD" {
    R_BZ.p2, TP_BZ.p1
  }

  // ---- USB-C power ------------------------------------------------------
  connect J_USB.cc1 -> R_CC1.p1 as "CC1"
  connect J_USB.cc1 -> D_CC1.cathode as "CC1"
  connect J_USB.cc2 -> R_CC2.p1 as "CC2"
  connect J_USB.cc2 -> D_CC2.cathode as "CC2"
}
