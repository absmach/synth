// RC low-pass tracer for `synth sim`.
// The sidecar `rc_filter.sim.toml` drives IN with a 1 V AC source and
// measures the -3 dB corner at OUT.
board "rc_filter" {
  layers 2

  component R1: resistor "r_generic_0805" value "1k"
  component C1: capacitor "c_generic_0805" value "100n"

  power "IN" 1v
  net "IN" { R1.p1 }
  net "GND" { C1.p2 }
  connect R1.p2 -> C1.p1 as "OUT"
}
