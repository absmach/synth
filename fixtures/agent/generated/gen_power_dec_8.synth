board "gen_power_dec_8" {
  layers 2
  component U1: ic "ch340g"
  component J1: connector "header_1x4"
  component J2: connector "header_1x4"
  component J3: connector "header_1x4"
  component J4: connector "header_1x4"
  component J5: connector "header_1x4"
  component J6: connector "header_1x4"
  component J7: connector "header_1x4"
  component J8: connector "header_1x4"

  connect U1.vcc -> J1.p1
  connect U1.vcc -> J2.p1
  connect U1.vcc -> J3.p1
  connect U1.vcc -> J4.p1
  connect U1.vcc -> J5.p1
  connect U1.vcc -> J6.p1
  connect U1.vcc -> J7.p1
  connect U1.vcc -> J8.p1
  connect U1.gnd -> J1.p2
}
