board "compound_06" {
  layers 2
  component R1: resistor "r_generic_0603"
  component R2: resistor "r_generic_0603"
  component U1: ic "esp32_wroom_32"
  component J1: connector "header_1x4"

  connect R1.p1 -> R2.p1
  connect R1.p2 -> R2.p2
  connect U1.vcc -> J1.p1
  connect U1.gnd -> J1.p2

  diff_pair r1_p1 r1_p2 {
  }

  keepout rf {
  }
}
