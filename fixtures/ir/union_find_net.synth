// Three connects that should merge into a single net by union-find:
// {U1.gp0, U2.sda, C1.p1} all electrically tied.
board "union_find_net" {
  layers 2

  component U1: mcu "rp2350"
  component U2: secure_element "atecc608"
  component C1: capacitor "c_generic_0402"

  connect U1.gp0 -> U2.sda
  connect U2.sda -> C1.p1
}
