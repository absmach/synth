board "ref_crystal_mcu" {
  layers 2
  manufacturer "jlcpcb"

  component U1: mcu "rp2350"
  component Y1: crystal "osc_smd_25mhz"
  component U2: regulator "ams1117_3v3"
  component J1: connector "header_1x4"

  component R1: resistor "r_generic_0603"

  component C1: capacitor "c_generic_0603"
  component C2: capacitor "c_generic_0603"
  component C3: capacitor "c_generic_0603"

  connect J1.p1 -> U2.vin
  connect J1.p2 -> U2.gnd

  connect U2.vout -> U1.vdd_io
  connect U2.vout -> U1.vdd_core
  connect U2.vout -> Y1.vcc
  connect U2.gnd -> U1.gnd
  connect U2.gnd -> Y1.gnd

  connect Y1.out -> U1.xin

  connect U1.run -> R1.p1
  connect U2.vout -> R1.p2

  connect U2.vin -> C1.p1
  connect U2.gnd -> C1.p2

  connect U2.vout -> C2.p1
  connect U2.gnd -> C2.p2

  connect Y1.vcc -> C3.p1
  connect U2.gnd -> C3.p2
}
