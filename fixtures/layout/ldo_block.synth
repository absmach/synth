// LdoBlock pattern: a regulator (kind = regulator) with an input
// cap on vin/gnd and an output cap on vout/gnd. AMS1117-3.3
// declares `required_decoupling` for both `vin` and `vout` (see
// registry/parts/regulators/ams1117_3v3.synth.toml), so
// `build_clusters` pass 3 claims C1 and C2 as decoupling members
// of U1's cluster — the same mechanism that recognizes a plain IC
// decoupling cluster, applied to both regulator rails.
board "ldo_block" {
  layers 2
  manufacturer "jlcpcb"

  component U1: regulator "ams1117_3v3"
  component C1: capacitor "c_generic_0805" // input cap
  component C2: capacitor "c_generic_0805" // output cap

  connect U1.vin  -> C1.p1
  connect U1.gnd  -> C1.p2
  connect U1.vout -> C2.p1
  connect U1.gnd  -> C2.p2
}
