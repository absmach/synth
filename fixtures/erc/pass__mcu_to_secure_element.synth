// Reference passing design: RP2350 ↔ ATECC608 over I²C.
// Exercises registry resolution and the I²C protocol rule.
board "mcu_to_secure_element" {
  layers 4

  component U1: mcu "rp2350"
  component U2: secure_element "atecc608"
  component C1: capacitor "c_generic_0402"
  component C2: capacitor "c_generic_0402"

  // Connect required power pins to keep E-SYNTH-CONNECT-001 quiet.
  connect U1.vdd_io -> C1.p1
  connect U1.vdd_core -> C2.p1
  connect U1.gnd -> C1.p2
  connect U1.run -> C2.p2
  connect U2.vcc -> C1.p1
  connect U2.gnd -> C1.p2

  // I²C bus: GP0/GP1 muxed to SDA/SCL, ATECC608's I²C pins.
  connect U1.gp0 -> U2.sda
  connect U1.gp1 -> U2.scl
}
