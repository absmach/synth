// AMS1117 requires a decoupling cap on vin AND vout. Here only vin
// is decoupled; POWER-001 fires for the vout rail.
board "no_decoupling_vout" {
  layers 2

  component U1: regulator "ams1117_3v3"
  component C1: capacitor "c_generic_0805"
  component J1: connector "header_1x4"

  connect U1.vin -> C1.p1
  connect C1.p2 -> U1.gnd
  connect J1.p1 -> U1.vin
  connect J1.p2 -> U1.gnd
  connect J1.p3 -> U1.vout
  connect J1.p4 -> U1.vout
}

