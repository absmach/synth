// A Class-II ceramic on a rail above half its rated voltage: DC bias
// derating must be considered (E-SYNTH-CAP-001).
board "x7r_high_bias" {
  layers 2
  component U1: regulator "ams1117_3v3"
  component C1: capacitor "c_generic_0603" value "10uF" dielectric "X7R" voltage "6.3V"
  power "+5V" 5v
  connect U1.vout -> C1.p1 as "+5V"
  connect C1.p2 -> "GND"
  connect U1.gnd -> "GND"
  connect U1.vin -> "VIN"
}
