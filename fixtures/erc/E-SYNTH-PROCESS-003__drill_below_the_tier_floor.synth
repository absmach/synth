board "drill_below_the_tier_floor" {
  layers 4
  manufacturer "jlcpcb"

  component R1: resistor "r_generic_0603" value "10k"
  component R2: resistor "r_generic_0603" value "10k"

  connect R1.p1 -> R2.p1 class "ESCAPE"
  connect R1.p2 -> R2.p2

  netclass "ESCAPE" {
    trace_width 0.2mm
    clearance 0.2mm
    via_diameter 0.45mm
    via_drill 0.15mm
  }
}
